gestionar_dropbear() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - CONFIGURAR DROPBEAR ${FIN}"
    if systemctl is-active dropbear &>/dev/null; then
        echo -e "El servicio Dropbear está actualmente: ${VERDE}ACTIVO${FIN}"
        read -p "¿Deseas desactivarlo? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            systemctl stop dropbear && systemctl disable dropbear &>/dev/null
            echo -e "${VERDE}✅ Dropbear desactivado correctamente.${FIN}"
        fi
    else
        read -p "Introduce el puerto para Dropbear (ej: 85, 90): " db_port
        sed -i 's/NO_START=1/NO_START=0/g' /etc/default/dropbear 2>/dev/null
        sed -i "s/DROPBEAR_PORT=.*/DROPBEAR_PORT=$db_port/g" /etc/default/dropbear 2>/dev/null
        ufw allow "$db_port/tcp" &>/dev/null
        systemctl restart dropbear && systemctl enable dropbear &>/dev/null
        echo -e "${VERDE}✅ Dropbear activado exitosamente en el puerto $db_port.${FIN}"
    fi
    read -p "Presione Enter para continuar..."
}

gestionar_websocket() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - WEBSOCKET NORMAL (PUERTO 80 -> 22) ${FIN}"
    if screen -list | grep -q "ws_80"; then
        echo -e "El Proxy WebSocket HTTP ya está: ${VERDE}ACTIVO${FIN}"
        read -p "¿Deseas apagarlo? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            screen -X -S ws_80 quit
            echo -e "${VERDE}✅ WebSocket apagado.${FIN}"
        fi
    else
        echo -e "Iniciando Proxy Python en Puerto 80 redirigido al SSH local (Puerto 22)..."
        # Crear script Python WebSocket interactivo básico en caliente
        cat << 'EOF' > /tmp/ws80.py
import socket, threading
def proxy(c, a):
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.connect(('127.0.0.1', 22))
        threading.Thread(target=forward, args=(c, s)).start()
        forward(s, c)
    except: pass
def forward(src, dst):
    try:
        while True:
            d = src.recv(4096)
            if not d: break
            dst.send(d)
    except: pass
    finally: src.close(); dst.close()
srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(('0.0.0.0', 80))
srv.listen(100)
while True:
    c, a = srv.accept()
    threading.Thread(target=proxy, args=(c, a)).start()
EOF
        ufw allow 80/tcp &>/dev/null
        screen -dmS ws_80 python3 /tmp/ws80.py
        echo -e "${VERDE}✅ WebSocket ejecutándose de fondo en puerto 80.${FIN}"
    fi
    read -p "Presione Enter para continuar..."
}

gestionar_websocket_security() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - WEBSOCKET SECURITY (CON RESPUESTA HTTP 101 + SSL 443) ${FIN}"
    if screen -list | grep -q "wss_security"; then
        echo -e "El WebSocket Seguro ya está: ${VERDE}ACTIVO${FIN}"
        read -p "¿Deseas apagarlo? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            screen -X -S wss_security quit
            systemctl stop stunnel4 &>/dev/null
            echo -e "${VERDE}✅ WebSocket Security y SSL desactivados.${FIN}"
        fi
    else
        echo -e "Configurando proxy Python con encabezado HTTP 101 Switching Protocols..."
        cat << 'EOF' > /tmp/wss.py
import socket, threading
def proxy(c, a):
    try:
        req = c.recv(1024).decode('utf-8', errors='ignore')
        if "Upgrade: websocket" in req:
            c.send(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.connect(('127.0.0.1', 22))
        threading.Thread(target=forward, args=(c, s)).start()
        forward(s, c)
    except: pass
def forward(src, dst):
    try:
        while True:
            d = src.recv(4096)
            if not d: break
            dst.send(d)
    except: pass
    finally: src.close(); dst.close()
srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(('0.0.0.0', 80))
srv.listen(100)
while True:
    c, a = srv.accept()
    threading.Thread(target=proxy, args=(c, a)).start()
EOF
        screen -dmS wss_security python3 /tmp/wss.py

        # Configuración automática de SSL 443 Redirigido al 80 usando Stunnel
        mkdir -p /etc/stunnel &>/dev/null
        openssl req -new -newkey rsa:2048 -days 365 -nodes -x509 -keyout /etc/stunnel/stunnel.pem -out /etc/stunnel/stunnel.pem -subj "/C=AR/ST=BA/L=Silk/O=SilkSSH/CN=SSH_SILK" &>/dev/null
        
        cat << 'EOF' > /etc/stunnel/stunnel.conf
pid = /var/run/stunnel4.pid
cert = /etc/stunnel/stunnel.pem
client = no
[websocket_ssl]
accept = 443
connect = 127.0.0.1:80
EOF
        sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/stunnel4 2>/dev/null
        ufw allow 80/tcp &>/dev/null
        ufw allow 443/tcp &>/dev/null
        systemctl restart stunnel4 &>/dev/null
        echo -e "${VERDE}✅ WebSocket Security corriendo (Puerto 80 con payload 101 y SSL Cifrado en puerto 443).${FIN}"
    fi
    read -p "Presione Enter para continuar..."
}

gestionar_badvpn() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - COMPONENTE BADVPN (UDP GATEWAY) ${FIN}"
    if screen -list | grep -q "badvpn"; then
        echo -e "El servicio BadVPN (Puerto 7300) ya está: ${VERDE}ACTIVO${FIN}"
        read -p "¿Deseas detenerlo? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            screen -X -S badvpn quit
            echo -e "${VERDE}✅ BadVPN detenido.${FIN}"
        fi
    else
        echo -e "Descargando e inyectando binarios de BadVPN para transmisión UDP/Juegos..."
        # Arquitectura del Servidor de forma nativa de 64 bits
        wget -O /usr/local/bin/badvpn-udpgw "https://github.com" &>/dev/null
        # Fallback en caso de que el repositorio original mude los binarios precompilados
        if [ ! -f /usr/local/bin/badvpn-udpgw ] || [ ! -s /usr/local/bin/badvpn-udpgw ]; then
             curl -L -o /usr/local/bin/badvpn-udpgw "https://githubusercontent.com" &>/dev/null
