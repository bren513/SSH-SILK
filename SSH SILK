#!/bin/bash
# SSH SILK MANAGER PRO v5.0.2
# Secure online updater + Dropbear/WebSocket/WSS/BadVPN multi-port manager
set -u
umask 022

VERSION="5.0.2"
APP_NAME="SSH SILK MANAGER PRO"
GITHUB_RAW="https://raw.githubusercontent.com/bren513/SSH-SILK/refs/heads/main/SSH%20SILK"
INSTALL_PATH="/usr/local/bin/menu"
BACKUP_DIR="/var/backups/ssh-silk"
CONFIG_DIR="/etc/ssh-silk"
WS_DIR="/opt/ssh-silk"

RESET='\e[0m'; BOLD='\e[1m'; BLUE='\e[1;34m'; CYAN='\e[1;36m'; GREEN='\e[1;32m'
RED='\e[1;31m'; YELLOW='\e[1;33m'; MAGENTA='\e[1;35m'; WHITE='\e[1;37m'

ok(){  echo -e "${GREEN}●${RESET} $*"; }
err(){  echo -e "${RED}✖${RESET} $*"; }
warn(){  echo -e "${YELLOW}●${RESET} $*"; }
info(){  echo -e "${CYAN}•${RESET} $*"; }
pause(){  read -r -p "Presiona Enter para continuar..." _; }

root_check(){  [[ ${EUID:-999} -eq 0 ]] || { err "Ejecuta como root."; exit 1; }; }
has(){  command -v "$1" >/dev/null 2>&1; }

install_deps(){ 
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y >/dev/null 2>&1 || true
  apt-get install -y curl wget ca-certificates openssl python3 systemd procps gawk bc iproute2 ufw stunnel4 file >/dev/null 2>&1 || true
  has dropbear || apt-get install -y dropbear >/dev/null 2>&1 || true
}

setup_dirs(){  mkdir -p "$BACKUP_DIR" "$CONFIG_DIR" "$WS_DIR"; chmod 700 "$BACKUP_DIR" "$CONFIG_DIR"; }

valid_script(){ 
  local f="$1"
  [[ -s "$f" ]] || return 1
  head -n1 "$f" | grep -qE '^#! */bin/(ba)?sh' || return 1
  grep -q 'SSH SILK MANAGER' "$f" || return 1
  grep -q '^VERSION=' "$f" || return 1
  bash -n "$f" >/dev/null 2>&1 || return 1
}

safe_install_from_file(){ 
  local src="$1"
  valid_script "$src" || return 1
  [[ -f "$INSTALL_PATH" ]] && cp -f "$INSTALL_PATH" "$BACKUP_DIR/menu-before-$(date +%Y%m%d-%H%M%S).sh" 2>/dev/null || true
  install -m 0755 "$src" "$INSTALL_PATH"
}

install_self(){ 
  local src="${BASH_SOURCE[0]:-}" tmp
  # Nunca se usa $0. BASH_SOURCE solo se acepta si apunta a un archivo real.
  if [[ -n "$src" && -f "$src" && "$src" != /dev/fd/* && "$src" != /proc/* ]] && valid_script "$src"; then
    safe_install_from_file "$src" && return 0
  fi
  tmp=$(mktemp)
  if curl -fsSL --connect-timeout 10 --max-time 60 "$GITHUB_RAW" -o "$tmp" && valid_script "$tmp"; then
    safe_install_from_file "$tmp"; rm -f "$tmp"; return 0
  fi
  rm -f "$tmp"; return 1
}

remote_update(){ 
  clear; header "ACTUALIZACIÓN ONLINE"
  local tmp remote
  tmp=$(mktemp)
  if ! curl -fsSL --connect-timeout 10 --max-time 60 "$GITHUB_RAW" -o "$tmp"; then
    err "GitHub no respondió o la URL no es accesible."; rm -f "$tmp"; pause; return
  fi
  if ! valid_script "$tmp"; then
    err "La descarga no pasó la validación Bash. No se reemplazó el menú."; rm -f "$tmp"; pause; return
  fi
  remote=$(sed -n 's/^VERSION="\([^"]*\)".*/\1/p' "$tmp" | head -n1)
  echo -e "Local : ${WHITE}${VERSION}${RESET}"
  echo -e "Remota: ${WHITE}${remote:-desconocida}${RESET}"
  if [[ -n "$remote" ]]; then
    version_cmp "$remote" "$VERSION"; case $? in
      2) warn "La versión remota es anterior. Se evita el downgrade."; rm -f "$tmp"; pause; return;;
      0) info "Ya tienes esta versión."; rm -f "$tmp"; pause; return;;
    esac
  fi
  [[ -f "$INSTALL_PATH" ]] && cp -f "$INSTALL_PATH" "$BACKUP_DIR/menu-${VERSION}-$(date +%Y%m%d-%H%M%S).sh"
  install -m 0755 "$tmp" "$INSTALL_PATH"; rm -f "$tmp"
  ok "Actualización instalada: v${remote:-desconocida}"
  sleep 1
  exec "$INSTALL_PATH"
}

version_cmp(){ 
  local a b i x y
  IFS=. read -ra a <<< "$1"; IFS=. read -ra b <<< "$2"
  for i in 0 1 2; do
    x="${a[$i]:-0}"; y="${b[$i]:-0}"
    ((10#$x > 10#$y)) && return 1
    ((10#$x < 10#$y)) && return 2
  done
  return 0
}

alias_setup(){ 
  touch /root/.bashrc
  grep -qF "alias menu='/usr/local/bin/menu'" /root/.bashrc || echo "alias menu='/usr/local/bin/menu'" >> /root/.bashrc
  grep -qF "alias silk='/usr/local/bin/menu'" /root/.bashrc || echo "alias silk='/usr/local/bin/menu'" >> /root/.bashrc
}

os_name(){  . /etc/os-release 2>/dev/null || true; echo "${PRETTY_NAME:-Linux}"; }
ram_pct(){  free | awk '/Mem:/ { if($2) printf "%d",$3*100/$2; else print 0}'; }
cpu_pct(){  LC_ALL=C top -bn1 2>/dev/null | awk '/Cpu\(s\)/ { for(i=1;i<=NF;i++) if($i ~ /id/) { v=$(i-1); gsub(/,/ ,".",v); gsub(/[^0-9.]/,"",v); printf "%d",100-v; exit}}'; }
cpu_pct(){  LC_ALL=C top -bn1 2>/dev/null | sed -n 's/.*, *\([0-9.]*\)%* id.*/\1/p' | awk '{ printf "%d",100-$1}'; }
disk_pct(){  df -P / | awk 'NR==2{ gsub(/%/,"",$5);print $5}'; }
disk_text(){  df -hP / | awk 'NR==2{ print $3" / "$2" ("$5")"}'; }
bar(){  local p="${1:-0}" i; ((p<0))&&p=0; ((p>100))&&p=100; printf '['; for((i=0;i<10;i++)); do ((i<p/10))&&printf '█'||printf '·'; done; printf ']'; }

port_listening(){  local proto="$1" p="$2"; if [[ "$proto" == tcp ]]; then ss -lntH 2>/dev/null | awk -v p=":$p" '$4 ~ p { x=1} END{ exit !x}'; else ss -lnuH 2>/dev/null | awk -v p=":$p" '$5 ~ p { x=1} END{ exit !x}'; fi; }
ports_normalize(){  echo "$1" | tr ',;' '  ' | awk '{ for(i=1;i<=NF;i++) if($i~/^[0-9]+$/) print $i}' | sort -nu | tr '\n' ' ' | sed 's/[[:space:]]*$//'; }
port_valid(){  [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1>=1&&10#$1<=65535)); }

fw_tcp_add(){  has ufw && ufw status 2>/dev/null | grep -q 'Status: active' && ufw allow "$1/tcp" >/dev/null 2>&1 || true; }
fw_udp_add(){  has ufw && ufw status 2>/dev/null | grep -q 'Status: active' && ufw allow "$1/udp" >/dev/null 2>&1 || true; }
fw_tcp_del(){  has ufw && ufw status 2>/dev/null | grep -q 'Status: active' && ufw delete allow "$1/tcp" >/dev/null 2>&1 || true; }
fw_udp_del(){  has ufw && ufw status 2>/dev/null | grep -q 'Status: active' && ufw delete allow "$1/udp" >/dev/null 2>&1 || true; }

# ---------- Dropbear ----------
write_dropbear_unit(){ 
cat > /etc/systemd/system/silk-dropbear@.service <<'UNIT'
[Unit]
Description=SSH SILK Dropbear Multi Port %i
After=network-online.target
Wants=network-online.target
Conflicts=dropbear.service
[Service]
Type=simple
ExecStart=/usr/sbin/dropbear -F -E -p %i
Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
}
dropbear_active(){  systemctl list-units --type=service --state=running 'silk-dropbear@*.service' --no-legend 2>/dev/null | sed -n 's/.*silk-dropbear@\([0-9]*\)\.service.*/\1/p' | sort -n; }
dropbear_add(){ 
 clear; header "DROPBEAR MULTI-PUERTO"; has dropbear || { err "Dropbear no está instalado."; pause; return; }
 write_dropbear_unit; systemctl disable --now dropbear.service >/dev/null 2>&1 || true
 read -r -p "Puertos TCP separados por espacios (ej: 85 90 2222): " raw; local ports p; ports=$(ports_normalize "$raw"); [[ -n "$ports" ]] || { err "No hay puertos válidos."; pause; return; }
 for p in $ports; do
   if ! port_valid "$p"; then err "Puerto inválido: $p"; continue; fi
   if port_listening tcp "$p" && ! systemctl is-active --quiet "silk-dropbear@$p.service"; then err "TCP $p está ocupado."; continue; fi
   if systemctl enable --now "silk-dropbear@$p.service" >/dev/null 2>&1; then
     fw_tcp_add "$p"; port_listening tcp "$p" && ok "Dropbear activo en TCP $p" || err "Dropbear $p no quedó escuchando.";
   else
     err "Falló Dropbear en $p"; journalctl -u "silk-dropbear@$p.service" -n 8 --no-pager 2>/dev/null
   fi
 done; pause
}
dropbear_stop(){ 
 clear; header "DETENER DROPBEAR"; local cur p raw ports; cur=$(dropbear_active || true); [[ -n "$cur" ]] || { warn "No hay Dropbear activo."; pause; return; }
 echo "Activos: $cur"; read -r -p "Puertos a detener o ALL: " raw
 if [[ ${raw^^} == ALL ]]; then for p in $cur; do systemctl disable --now "silk-dropbear@$p.service" >/dev/null 2>&1 || true; fw_tcp_del "$p"; done
 else ports=$(ports_normalize "$raw"); for p in $ports; do systemctl disable --now "silk-dropbear@$p.service" >/dev/null 2>&1 || true; fw_tcp_del "$p"; done; fi
 ok "Operación completada."; pause
}

# ---------- WebSocket HTTP ----------
write_ws_py(){ 
cat > "$WS_DIR/websocket_proxy.py" <<'PY'
#!/usr/bin/env python3
import base64,hashlib,socket,struct,sys,threading
BIND_HOST=sys.argv[1]; LISTEN_PORT=int(sys.argv[2]); TARGET_PORT=int(sys.argv[3]) if len(sys.argv)>3 else 22

def exact(s,n):
 b=b''
 while len(b)<n:
  x=s.recv(n-len(b))
  if not x: raise ConnectionError
  b+=x
 return b

def frame(s,op,data=b''):
 n=len(data); h=bytes([0x80|op])
 if n<126:h+=bytes([n])
 elif n<65536:h+=bytes([126])+struct.pack('!H',n)
 else:h+=bytes([127])+struct.pack('!Q',n)
 s.sendall(h+data)

def readframe(s):
 h=exact(s,2); op=h[0]&15; masked=h[1]&128; n=h[1]&127
 if n==126:n=struct.unpack('!H',exact(s,2))[0]
 elif n==127:n=struct.unpack('!Q',exact(s,8))[0]
 key=exact(s,4) if masked else b''; d=exact(s,n)
 if masked:d=bytes(d[i]^key[i%4] for i in range(n))
 return op,d

def client(c):
 try:
  req=b''
  while b'\r\n\r\n' not in req and len(req)<16384:
   x=c.recv(4096)
   if not x:return
   req+=x
  lines=req.split(b'\r\n'); key=None
  for line in lines:
   if line.lower().startswith(b'sec-websocket-key:'):key=line.split(b':',1)[1].strip()
  if b'upgrade: websocket' not in req.lower() or not key:
   c.sendall(b'HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n');return
  accept=base64.b64encode(hashlib.sha1(key+b'258EAFA5-E914-47DA-95CA-C5AB0DC85B11').digest())
  c.sendall(b'HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: '+accept+b'\r\n\r\n')
  t=socket.create_connection(('127.0.0.1',TARGET_PORT),8)
  def a():
   try:
    while True:
     op,d=readframe(c)
     if op==8:return
     if op==9:frame(c,10,d)
     elif op in (1,2):t.sendall(d)
   except:pass
   try:t.shutdown(socket.SHUT_WR)
   except:pass
  def b():
   try:
    while True:
     d=t.recv(65535)
     if not d:break
     frame(c,2,d)
   except:pass
  ta=threading.Thread(target=a);tb=threading.Thread(target=b);ta.start();tb.start();ta.join();tb.join();t.close()
 except:pass
 finally:
  try:c.close()
  except:pass

s=socket.socket();s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1);s.bind((BIND_HOST,LISTEN_PORT));s.listen(256)
while True:
 c,_=s.accept();threading.Thread(target=client,args=(c,),daemon=True).start()
PY
chmod 755 "$WS_DIR/websocket_proxy.py"
}
write_ws_unit(){ 
cat > /etc/systemd/system/silk-websocket@.service <<'UNIT'
[Unit]
Description=SSH SILK WebSocket HTTP %i
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/ssh-silk/websocket_proxy.py 0.0.0.0 %i 22
Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
}
ws_active(){  systemctl list-units --type=service --state=running 'silk-websocket@*.service' --no-legend 2>/dev/null | sed -n 's/.*silk-websocket@\([0-9]*\)\.service.*/\1/p' | sort -n; }
ws_add(){ 
 clear;header "WEBSOCKET HTTP";write_ws_py;write_ws_unit;read -r -p "Puertos TCP (ej: 80 8080): " raw;local ports p;ports=$(ports_normalize "$raw");[[ -n "$ports" ]]|| { err "No hay puertos válidos.";pause;return;}
 for p in $ports;do if port_listening tcp "$p"&& ! systemctl is-active --quiet "silk-websocket@$p.service";then err "TCP $p está ocupado.";continue;fi;systemctl enable --now "silk-websocket@$p.service" >/dev/null 2>&1&& { fw_tcp_add "$p";port_listening tcp "$p"&& ok "WebSocket HTTP activo en $p"|| err "WebSocket $p no escucha."; }|| { err "Falló WebSocket $p";journalctl -u "silk-websocket@$p.service" -n 8 --no-pager 2>/dev/null;};done;pause
}
ws_stop(){ 
 clear;header "DETENER WEBSOCKET HTTP";local cur p raw ports;cur=$(ws_active|| true);[[ -n "$cur" ]]|| { warn "No hay WebSocket activos.";pause;return;};echo "Activos: $cur";read -r -p "Puertos a detener o ALL: " raw;if [[ ${raw^^} == ALL ]];then for p in $cur;do systemctl disable --now "silk-websocket@$p.service" >/dev/null 2>&1|| true;fw_tcp_del "$p";done;else ports=$(ports_normalize "$raw");for p in $ports;do systemctl disable --now "silk-websocket@$p.service" >/dev/null 2>&1|| true;fw_tcp_del "$p";done;fi;ok "Operación completada.";pause
}

