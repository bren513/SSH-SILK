manage_websocket() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • WEBSOCKET HTTP :80${FIN}"
    echo "============================================================"

    if tcp_listening 80; then
        echo -e "Estado real: ${VERDE}ON${FIN}"
        port_owner 80
        echo
        read -r -p "¿Deseas detener WebSocket? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            systemctl disable --now silk-websocket.service >/dev/null 2>&1 || true
            sleep 1
            if tcp_listening 80; then
                echo -e "${ROJO}❌ 80 sigue ocupado.${FIN}"
                port_owner 80
            else
                echo -e "${VERDE}✅ WebSocket detenido.${FIN}"
            fi
        fi
        pause_menu
        return
    fi

    if tcp_listening 80; then
        echo -e "${ROJO}❌ Puerto 80 ocupado.${FIN}"
        port_owner 80
        pause_menu
        return
    fi

    echo -e "Estado real: ${ROJO}OFF${FIN}"
    echo "Instalando WebSocket integrado..."

    write_websocket_python
    open_tcp 80
    write_ws_service

    systemctl daemon-reload
    systemctl enable silk-websocket.service >/dev/null 2>&1
    systemctl restart silk-websocket.service
    sleep 2

    if tcp_listening 80; then
        echo -e "${VERDE}✅ WebSocket HTTP activo en 80.${FIN}"
        echo "Destino SSH interno: 127.0.0.1:22"
    else
        echo -e "${ROJO}❌ WebSocket no abrió el puerto 80.${FIN}"
        journalctl -u silk-websocket.service -n 30 --no-pager
    fi

    pause_menu
}

# ============================================================
# WSS / SECURITY
# ============================================================

create_ssl_cert() {
    mkdir -p /etc/stunnel

    if [ ! -s /etc/stunnel/stunnel.pem ]; then
        openssl req -new -newkey rsa:2048 -days 365 -nodes -x509 \
            -keyout /etc/stunnel/stunnel.pem \
            -out /etc/stunnel/stunnel.pem \
            -subj "/C=AR/ST=BA/L=Silk/O=SilkSSH/CN=SSH_SILK" >/dev/null 2>&1
    fi

    chmod 600 /etc/stunnel/stunnel.pem
}

configure_stunnel() {
    cat > /etc/stunnel/stunnel.conf <<EOF
pid = /run/stunnel4.pid
cert = /etc/stunnel/stunnel.pem
client = no
foreground = no

[websocket_ssl]
accept = 443
connect = 127.0.0.1:80
EOF

    if [ -f /etc/default/stunnel4 ]; then
        if grep -q '^ENABLED=' /etc/default/stunnel4; then
            sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/stunnel4
        else
            echo "ENABLED=1" >> /etc/default/stunnel4
        fi
    fi
}

manage_wss() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • WEBSOCKET SECURITY :443${FIN}"
    echo "============================================================"

    if tcp_listening 443; then
        echo -e "Estado real: ${VERDE}ON${FIN}"
        port_owner 443
        echo
        read -r -p "¿Deseas detener WSS? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            systemctl disable --now stunnel4 >/dev/null 2>&1 || true
            sleep 1
            echo -e "${VERDE}✅ WSS detenido.${FIN}"
        fi
        pause_menu
        return
    fi

    if tcp_listening 443; then
        echo -e "${ROJO}❌ Puerto 443 ocupado.${FIN}"
        port_owner 443
        pause_menu
        return
    fi

    # 443 depende de 80.
    if ! tcp_listening 80; then
        echo "WebSocket HTTP no está activo."
        echo "Se iniciará automáticamente..."
        write_websocket_python
        open_tcp 80
        write_ws_service
        systemctl daemon-reload
        systemctl enable --now silk-websocket.service >/dev/null 2>&1
        sleep 2
    fi

    if ! tcp_listening 80; then
        echo -e "${ROJO}❌ No se pudo iniciar WebSocket en 80.${FIN}"
        journalctl -u silk-websocket.service -n 30 --no-pager
        pause_menu
        return
    fi

    create_ssl_cert
    configure_stunnel
    open_tcp 443

    systemctl daemon-reload
    systemctl enable stunnel4 >/dev/null 2>&1
    systemctl restart stunnel4
    sleep 2

    if tcp_listening 443; then
        echo -e "${VERDE}✅ WSS activo en 443.${FIN}"
        echo "443 SSL → 80 WebSocket → SSH 22"
    else
        echo -e "${ROJO}❌ Stunnel no abrió 443.${FIN}"
        systemctl status stunnel4 --no-pager -l
        journalctl -u stunnel4 -n 30 --no-pager
    fi

    pause_menu
}

