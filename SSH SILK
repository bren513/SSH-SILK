# ============================================================
# ACTUALIZACIÓN ONLINE SEGURA
# ============================================================

online_update() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • ACTUALIZACIÓN ONLINE${FIN}"
    echo "============================================================"
    echo "Versión actual : v$VERSION"
    echo "Fuente         : GitHub"
    echo

    local tmp="/tmp/ssh_silk_update_$$.sh"
    local old_backup="/tmp/ssh_silk_old_$$.sh"

    echo "Descargando..."
    if ! curl -fLsS --connect-timeout 10 --max-time 60 "$GITHUB_RAW_URL" -o "$tmp"; then
        echo -e "${ROJO}❌ Falló la descarga.${FIN}"
        rm -f "$tmp"
        pause_menu
        return
    fi

    if [ ! -s "$tmp" ] || ! grep -q "SSH SILK" "$tmp"; then
        echo -e "${ROJO}❌ El archivo descargado no parece SSH SILK.${FIN}"
        rm -f "$tmp"
        pause_menu
        return
    fi

    if ! bash -n "$tmp"; then
        echo -e "${ROJO}❌ La actualización tiene errores de sintaxis.${FIN}"
        echo "La versión actual NO fue modificada."
        rm -f "$tmp"
        pause_menu
        return
    fi

    local remote_version
    remote_version="$(grep -m1 '^VERSION=' "$tmp" | sed -E 's/^VERSION=["'\''"]?([^"'"'"''"]+)["'\''"]?.*/\1/')"

    if [ -z "$remote_version" ]; then
        echo -e "${ROJO}❌ No se pudo detectar la versión remota.${FIN}"
        rm -f "$tmp"
        pause_menu
        return
    fi

    if [ "$remote_version" = "$VERSION" ]; then
        echo -e "${AMARILLO}ℹ Ya tienes la versión v$VERSION.${FIN}"
        rm -f "$tmp"
        pause_menu
        return
    fi

    # Evitar que una versión vieja de GitHub reemplace una más nueva.
    if command -v sort >/dev/null 2>&1; then
        if [ "$(printf '%s\n' "$remote_version" "$VERSION" | sort -V | tail -n1)" != "$remote_version" ]; then
            echo -e "${ROJO}❌ La versión de GitHub (v$remote_version) es anterior a v$VERSION.${FIN}"
            echo "No se realizó ningún cambio."
            rm -f "$tmp"
            pause_menu
            return
        fi
    fi

    cp "$INSTALL_PATH" "$old_backup" 2>/dev/null || true
    chmod 755 "$tmp"
    cp "$tmp" "$INSTALL_PATH"
    chmod 755 "$INSTALL_PATH"
    rm -f "$tmp"

    echo -e "${VERDE}✅ Actualización instalada correctamente.${FIN}"
    echo "La configuración de /etc/silk se conserva."
    echo "Reiniciando el panel..."
    sleep 2
    exec "$INSTALL_PATH"
}

# ============================================================
# DESINSTALACIÓN
# ============================================================

uninstall_script() {
    clear
    echo -e "${ROJO}⚠️ SSH SILK • DESINSTALACIÓN${FIN}"
    echo "============================================================"
    read -r -p "¿Eliminar servicios y configuración de SSH SILK? (s/n): " opt
    [[ "$opt" == "s" || "$opt" == "S" ]] || return

    local db="" bv="" p
    [ -f "$DROPBEAR_PORTS_FILE" ] && db="$(cat "$DROPBEAR_PORTS_FILE")"
    [ -f "$BADVPN_PORTS_FILE" ] && bv="$(cat "$BADVPN_PORTS_FILE")"

    systemctl disable --now silk-dropbear.service >/dev/null 2>&1 || true
    systemctl disable --now silk-websocket.service >/dev/null 2>&1 || true
    systemctl disable --now stunnel4 >/dev/null 2>&1 || true
    stop_badvpn_ports "$bv"

    close_tcp $db
    close_tcp 80 443
    close_udp $bv

    rm -f "$SYSTEMD/silk-dropbear.service" \
          "$SYSTEMD/silk-websocket.service" \
          "$SYSTEMD/silk-badvpn@.service"

    systemctl daemon-reload

    unmask_native_dropbear

    rm -rf "$BASE"
    rm -f "$INSTALL_PATH"
    sed -i "/alias menu='$INSTALL_PATH'/d" /root/.bashrc 2>/dev/null || true
    sed -i "/alias silk='$INSTALL_PATH'/d" /root/.bashrc 2>/dev/null || true

    echo -e "${VERDE}✅ SSH SILK desinstalado.${FIN}"
    exit 0
}

# ============================================================
# PANEL
# ============================================================

repeat_char() {
    local char="$1" count="$2"
    printf "%${count}s" "" | tr ' ' "$char"
}

bar() {
    local pct="$1" total=10 filled empty
    filled=$((pct / 10))
    [ "$filled" -lt 0 ] && filled=0
    [ "$filled" -gt 10 ] && filled=10
    empty=$((10-filled))
    printf "["
    printf "■%.0s" $(seq 1 "$filled") 2>/dev/null
    printf "·%.0s" $(seq 1 "$empty") 2>/dev/null
    printf "]"
}

panel_status() {
    local p="$1"
    if [ "$2" = "udp" ]; then
        udp_listening "$p" && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}"
    else
        tcp_listening "$p" && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}"
    fi
}

draw_panel() {
    local os ram_pct cpu_pct ram_total ram_used disk connected expired total
    os="$(lsb_release -ds 2>/dev/null || grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')"
    ram_pct="$(ram_percent)"
    cpu_pct="$(cpu_percent)"
    ram_total="$(free -h | awk '/Mem:/ {print $2}')"
    ram_used="$(free -h | awk '/Mem:/ {print $3}')"
    disk="$(disk_info)"
    connected="$(get_ssh_connections)"
    expired="$(get_expired_users)"
    total="$(get_total_users)"

    local db="" bv=""
    [ -f "$DROPBEAR_PORTS_FILE" ] && db="$(cat "$DROPBEAR_PORTS_FILE")"
    [ -f "$BADVPN_PORTS_FILE" ] && bv="$(cat "$BADVPN_PORTS_FILE")"

    local W=66
    local line
    line="$(repeat_char '═' "$W")"

    echo -e "${AZUL}╔${line}╗${FIN}"
    printf "${AZUL}║${FIN} %-64s ${AZUL}║${FIN}\n" "⚡ SSH SILK MANAGER v$VERSION"
    printf "${AZUL}║${FIN} %-64s ${AZUL}║${FIN}\n" "★ VENTAS • SOPORTE • MULTI-PUERTO ★"
    echo -e "${AZUL}╠${line}╣${FIN}"

    printf "${AZUL}║${FIN} ${CIAN}SISTEMA${FIN} %-19s ${CIAN}RAM${FIN} %-18s ${CIAN}CPU${FIN} %-14s ${AZUL}║${FIN}\n" "" "" ""
    printf "${AZUL}║${FIN} OS: %-23s RAM: %s %-4s CPU: %s %-3s ${AZUL}║${FIN}\n" \
        "$(echo "$os" | cut -c1-23)" "$(bar "$ram_pct")" "$ram_pct%" "$(bar "$cpu_pct")" "$cpu_pct%"
    printf "${AZUL}║${FIN} Hora: %-20s Usada: %-15s Cores: %-3s Uptime: %-13s ${AZUL}║${FIN}\n" \
        "$(date '+%H:%M:%S')" "$ram_used/$ram_total" "$(nproc)" "$(uptime_human | cut -c1-13)"

    echo -e "${AZUL}╠${line}╣${FIN}"
    printf "${AZUL}║${FIN} ${VERDE}●${FIN} CONECTADOS: %-4s ${ROJO}●${FIN} VENCIDOS: %-4s ${CIAN}Σ${FIN} TOTAL: %-5s DISCO: %-15s ${AZUL}║${FIN}\n" \
        "$connected" "$expired" "$total" "$disk"

    echo -e "${AZUL}╠${line}╣${FIN}"
    printf "${AZUL}║${FIN} ${AMARILLO}PROTOCOLOS${FIN}   SSH: ${BLANCO}22${FIN} [%b]   WS: ${BLANCO}80${FIN} [%b]   WSS: ${BLANCO}443${FIN} [%b] ${AZUL}║${FIN}\n" \
        "$(panel_status 22 tcp)" "$(panel_status 80 tcp)" "$(panel_status 443 tcp)"
    printf "${AZUL}║${FIN} DROPBEAR: %-18s BADVPN: %-18s STUNNEL: %b ${AZUL}║${FIN}\n" \
        "${db:-OFF}" "${bv:-OFF}" "$(service_on stunnel4 && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}")"

    echo -e "${AZUL}╠${line}╣${FIN}"
    printf "${AZUL}║${FIN} ${MAGENTA}ADMINISTRACIÓN${FIN}              ${CIAN}CONFIGURACIÓN${FIN}             ${AZUL}║${FIN}\n"
    printf "${AZUL}║${FIN} ${MAGENTA}[01]${FIN} Crear usuario              ${CIAN}[06]${FIN} WebSocket HTTP 80         ${AZUL}║${FIN}\n"
    printf "${AZUL}║${FIN} ${MAGENTA}[02]${FIN} Usuario prueba             ${CIAN}[07]${FIN} WebSocket Security 443    ${AZUL}║${FIN}\n"
    printf "${AZUL}║${FIN} ${MAGENTA}[03]${FIN} Online / Consumos          ${CIAN}[08]${FIN} BadVPN multi-puerto       ${AZUL}║${FIN}\n"
    printf "${AZUL}║${FIN} ${MAGENTA}[04]${FIN} Lista de usuarios          ${CIAN}[09]${FIN} Diagnóstico de puertos     ${AZUL}║${FIN}\n"
    printf "${AZUL}║${FIN} ${MAGENTA}[05]${FIN} Eliminar usuario           ${CIAN}[10]${FIN} Info de sistema            ${AZUL}║${FIN}\n"
    printf "${AZUL}║${FIN}                                ${CIAN}[11]${FIN} Actualizar online          ${AZUL}║${FIN}\n"
    printf "${AZUL}║${FIN}                                ${CIAN}[12]${FIN} Dropbear multi-puerto      ${AZUL}║${FIN}\n"
    printf "${AZUL}║${FIN}                                ${CIAN}[13]${FIN} Desinstalar script         ${AZUL}║${FIN}"
    echo
    echo -e "${AZUL}╠${line}╣${FIN}"
    printf "${AZUL}║${FIN} ${ROJO}[00]${FIN} Salir    ${GRIS}Systemd • Multi-puerto • Diagnóstico • AutoStart${FIN} ${AZUL}║${FIN}\n"
    echo -e "${AZUL}╚${line}╝${FIN}"
}

