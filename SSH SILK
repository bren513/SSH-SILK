download_badvpn() {
    if [ -x "$BIN/badvpn-udpgw" ]; then
        return 0
    fi

    echo "Descargando BadVPN..."
    curl -fL --connect-timeout 10 --max-time 60 \
        -o "$BIN/badvpn-udpgw" \
        "https://github.com/ambrop72/badvpn/raw/master/output/badvpn-udpgw" >/dev/null 2>&1 || true

    if [ ! -s "$BIN/badvpn-udpgw" ]; then
        curl -fL --connect-timeout 10 --max-time 60 \
            -o "$BIN/badvpn-udpgw" \
            "https://raw.githubusercontent.com/serverfree/badvpn/master/badvpn-udpgw" >/dev/null 2>&1 || true
    fi

    chmod +x "$BIN/badvpn-udpgw" 2>/dev/null || true
    [ -x "$BIN/badvpn-udpgw" ]
}

write_badvpn_template() {
    cat > "$SYSTEMD/silk-badvpn@.service" <<'EOF'
[Unit]
Description=SSH SILK BadVPN UDPGW %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/badvpn-udpgw --listen-addr 0.0.0.0:%i --max-clients 1000 --max-connections-for-client 10
Restart=on-failure
RestartSec=2
TimeoutStartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
}

stop_badvpn_ports() {
    local list="$1" p
    for p in $list; do
        systemctl disable --now "silk-badvpn@${p}.service" >/dev/null 2>&1 || true
    done
}

manage_badvpn() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • BADVPN MULTI-PUERTO${FIN}"
    echo "============================================================"

    local old="" ports p bad=0
    [ -f "$BADVPN_PORTS_FILE" ] && old="$(cat "$BADVPN_PORTS_FILE")"

    echo -e "${CIAN}Puertos actuales:${FIN}"
    udp_status_list "$old"
    echo
    echo "Ejemplo: 7300 7301 7302 7303"
    read -r -p "🔌 Nuevos puertos UDP: " ports
    ports="$(clean_ports "$ports")"

    if ! validate_ports "$ports"; then
        pause_menu
        return
    fi

    if ! download_badvpn; then
        echo -e "${ROJO}❌ No se pudo descargar BadVPN.${FIN}"
        pause_menu
        return
    fi

    # Revisar conflictos antes de detener los puertos actuales.
    for p in $ports; do
        if udp_listening "$p" && ! port_owner "$p" | grep -qi "badvpn"; then
            echo -e "${ROJO}❌ Puerto UDP $p ya está ocupado.${FIN}"
            port_owner "$p"
            bad=1
        fi
    done

    if [ "$bad" -eq 1 ]; then
        pause_menu
        return
    fi

    stop_badvpn_ports "$old"
    write_badvpn_template
    printf '%s\n' "$ports" > "$BADVPN_PORTS_FILE"
    systemctl daemon-reload
    open_udp $ports

    for p in $ports; do
        systemctl enable --now "silk-badvpn@${p}.service" >/dev/null 2>&1
    done

    sleep 2

    echo
    udp_status_list "$ports"

    for p in $ports; do
        if ! udp_listening "$p"; then
            echo -e "${ROJO}⚠ Error en UDP $p:${FIN}"
            journalctl -u "silk-badvpn@${p}.service" -n 15 --no-pager
        fi
    done

    pause_menu
}

# ============================================================
# USUARIOS
# ============================================================

create_user() {
    clear
    echo -e "${CIAN}⚡ CREAR USUARIO SSH${FIN}"
    read -r -p "👤 Usuario: " user

    if id "$user" >/dev/null 2>&1; then
        echo -e "${ROJO}❌ El usuario ya existe.${FIN}"
        pause_menu
        return
    fi

    read -r -s -p "🔑 Contraseña: " pass
    echo
    read -r -p "⏳ Días de duración: " days

    if ! [[ "$days" =~ ^[0-9]+$ ]] || [ "$days" -lt 1 ]; then
        echo -e "${ROJO}❌ Días inválidos.${FIN}"
        pause_menu
        return
    fi

    local exp
    exp="$(date -d "+$days days" +%Y-%m-%d)"
    useradd -M -s /bin/false -e "$exp" "$user"
    echo "$user:$pass" | chpasswd

    echo -e "${VERDE}✅ Usuario creado.${FIN}"
    echo "Usuario : $user"
    echo "Expira  : $exp"
    pause_menu
}

create_test() {
    clear
    local user="silk$(date +%s | tail -c 6)"
    useradd -M -s /bin/false -e "$(date -d '+1 day' +%Y-%m-%d)" "$user"
    echo "$user:1234" | chpasswd

    echo -e "${VERDE}✅ Cuenta TEST creada.${FIN}"
    echo "Usuario: $user"
    echo "Pass: 1234"
    echo "Expira: 24 horas"
    pause_menu
}

list_users() {
    clear
    echo -e "${CIAN}👥 USUARIOS SSH${FIN}"
    echo "============================================================"
    awk -F: '$3 >= 1000 && $1 != "nobody" {print " • " $1}' /etc/passwd
    echo "============================================================"
    pause_menu
}

delete_user() {
    clear
    read -r -p "👤 Usuario a eliminar: " user

    if id "$user" >/dev/null 2>&1; then
        userdel -f "$user" >/dev/null 2>&1
        echo -e "${VERDE}✅ Usuario eliminado.${FIN}"
    else
        echo -e "${ROJO}❌ Usuario inexistente.${FIN}"
    fi
    pause_menu
}

get_total_users() {
    awk -F: '$3 >= 1000 && $1 != "nobody" {n++} END{print n+0}' /etc/passwd
}

get_expired_users() {
    local n=0 now
    now="$(date +%s)"
    while IFS=: read -r user _ _ _ _ _ _ expire _; do
        [ -z "$expire" ] && continue
        if [[ "$expire" =~ ^[0-9]+$ ]] && [ "$expire" -gt 0 ]; then
            local expdate
            expdate="$(date -d "1970-01-01 +$((expire-1)) days" +%s 2>/dev/null || echo 0)"
            [ "$expdate" -lt "$now" ] && n=$((n+1))
        fi
    done < /etc/shadow 2>/dev/null
    echo "$n"
}

get_ssh_connections() {
    ss -H -tn state established 2>/dev/null |
        awk '{print $4}' |
        grep -Ev ':(22|80|443)$' >/dev/null 2>&1 || true
    ss -H -tn state established 2>/dev/null | wc -l
}

# ============================================================
# INFORMACIÓN DEL SISTEMA
# ============================================================

cpu_percent() {
    local a b idle1 idle2 total1 total2 idle_diff total_diff
    read -r _ a _ _ _ _ _ _ _ < <(grep '^cpu ' /proc/stat)
    # Método corto y estable usando /proc/loadavg para no bloquear.
    local cores load
    cores="$(nproc)"
    load="$(awk '{print $1}' /proc/loadavg)"
    awk -v l="$load" -v c="$cores" 'BEGIN {
        p=(l/c)*100;
        if(p>100)p=100;
        printf "%d", p
    }'
}

ram_percent() {
    free | awk '/Mem:/ {if($2>0) printf "%d", ($3/$2)*100; else print 0}'
}

disk_info() {
    df -hP / | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}'
}

uptime_human() {
    uptime -p 2>/dev/null | sed 's/^up //'
}

system_info() {
    clear

    local os kernel arch uptime_s ram_total ram_used ram_pct disk ip cpu load cores
    os="$(lsb_release -ds 2>/dev/null || grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')"
    kernel="$(uname -r)"
    arch="$(uname -m)"
    uptime_s="$(uptime_human)"
    ram_total="$(free -h | awk '/Mem:/ {print $2}')"
    ram_used="$(free -h | awk '/Mem:/ {print $3}')"
    ram_pct="$(ram_percent)"
    disk="$(disk_info)"
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    cores="$(nproc)"
    load="$(awk '{print $1" "$2" "$3}' /proc/loadavg)"
    cpu="$(cpu_percent)"

    echo -e "${CIAN}⚡ SSH SILK • INFORMACIÓN DEL SISTEMA${FIN}"
    echo "============================================================"
    echo
    echo -e "${AMARILLO}SISTEMA${FIN}"
    echo " OS        : $os"
    echo " Kernel    : $kernel"
    echo " Arquitect.: $arch"
    echo " IP        : ${ip:-N/D}"
    echo " Uptime    : ${uptime_s:-N/D}"
    echo
    echo -e "${AMARILLO}CPU${FIN}"
    echo " Cores     : $cores"
    echo " Uso       : ${cpu}%"
    echo " Load avg  : $load"
    echo
    echo -e "${AMARILLO}MEMORIA RAM${FIN}"
    echo " Usada     : $ram_used / $ram_total"
    echo " Uso       : ${ram_pct}%"
    echo
    echo -e "${AMARILLO}DISCO /${FIN}"
    echo " Uso       : $disk"
    echo
    echo -e "${AMARILLO}TODOS LOS PUERTOS ESCUCHANDO${FIN}"
    echo "------------------------------------------------------------"

    local tcp udp
    tcp="$(ss -H -lntp 2>/dev/null)"
    udp="$(ss -H -lnup 2>/dev/null)"

    if [ -n "$tcp" ]; then
        echo -e "${CIAN}TCP${FIN}"
        printf '%s\n' "$tcp"
    else
        echo "TCP: ninguno"
    fi

    echo
    if [ -n "$udp" ]; then
        echo -e "${CIAN}UDP${FIN}"
        printf '%s\n' "$udp"
    else
        echo "UDP: ninguno"
    fi

    echo
    echo -e "${AMARILLO}FIREWALL UFW${FIN}"
    if command -v ufw >/dev/null 2>&1; then
        ufw status 2>/dev/null | head -n 25
    else
        echo "UFW no instalado."
    fi

    pause_menu
}

