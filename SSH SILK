#!/bin/bash
# =========================================================
# SCRIPT: SSH SILK - PREMIUM EDITION (FULL FIX)
# COMPATIBLE CON: UBUNTU 20.04 / 22.04 / 24.04 Y DEBIAN
# =========================================================

if [ "$EUID" -ne 0 ]; then
  echo -e "\e[1;31m❌ Por favor, ejecuta este script como root (sudo).\e[0m"
  exit 1
fi

VERDE="\e[1;32m"
ROJO="\e[1;31m"
AZUL="\e[1;34m"
CIAN="\e[1;36m"
AMARILLO="\e[1;33m"
MAGENTA="\e[1;35m"
BLANCO="\e[1;37m"
FIN="\e[0m"

instalar_dependencias() {
    apt-get update -y &>/dev/null
    DEPENDENCIAS=(lsb-release ufw bc gawk host dropbear stunnel4 python3 screen wget curl openssl)
    for dev_dep in "${DEPENDENCIAS[@]}"; do
        if ! command -v "$dev_dep" &>/dev/null && [ ! -f "/usr/bin/$dev_dep" ] && [ ! -f "/usr/sbin/$dev_dep" ]; then
            apt-get install -y "$dev_dep" &>/dev/null
        fi
    done
}
instalar_dependencias

configurar_alias_y_inicio() {
    cp "$0" /usr/local/bin/menu &>/dev/null
    chmod +x /usr/local/bin/menu &>/dev/null
    if ! grep -q "alias menu=" /root/.bashrc; then
        echo "alias menu='/usr/local/bin/menu'" >> /root/.bashrc
        echo "alias silk='/usr/local/bin/menu'" >> /root/.bashrc
    fi
}
configurar_alias_y_inicio

obtener_info_sistema() {
    OS=$(lsb_release -ds 2>/dev/null || cat /etc/os-release | grep "PRETTY_NAME" | cut -d= -f2 | tr -d '"')
    HORA=$(date +"%H:%M:%S")
    NUCLEOS=$(nproc)
    RAM_TOTAL=$(free -h | grep Mem | awk '{print $2}')
    RAM_USO_PCT=$(free | grep Mem | awk '{print int($3/$2 * 100)}')
    CPU_USO_PCT=$(top -bn1 | grep "Cpu(s)" | sed "s/.*, *\(\[0-9.\]*\)%* id.*/\1/" | awk '{print int(100 - $1)}')
    TOTAL_USERS=$(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd | wc -l)
    ONLINE_USERS=$(ps aux | grep -i sshd | grep -v grep | wc -l)
    STATUS_DROPBEAR=$(systemctl is-active dropbear &>/dev/null && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}")
    STATUS_WS=$(screen -list | grep -q "ws_80" && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}")
    STATUS_WSS=$(screen -list | grep -q "wss_security" && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}")
    STATUS_BADVPN=$(screen -list | grep -q "badvpn" && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}")
}

dibujar_barra() {
    local pct=$1
    local total_bloques=10
    local bloques_llenos=$((pct / 10))
    local bloques_vacios=$((total_bloques - bloques_llenos))
    printf "["
    for ((i=0; i<bloques_llenos; i++)); do printf "■"; done
    for ((i=0; i<bloques_vacios; i++)); do printf " "; done
    printf "] %d%%" "$pct"
}

crear_usuario() {
    clear
    echo -e "${VERDE}⚡ SSH SILK - CREAR USUARIO SSH ${FIN}"
    read -p "👤 Nombre de usuario: " usuario
    if id "$usuario" &>/dev/null; then 
        echo -e "${ROJO}❌ Ya existe.${FIN}"
    else
        read -p "🔑 Contraseña: " contrasena
        read -p "⏳ Días de duración: " dias
        FECHA_EXP=$(date -d "+$dias days" +%Y-%m-%d)
        useradd -M -s /bin/false -e "$FECHA_EXP" "$usuario"
        echo "$usuario:$contrasena" | chpasswd
        echo -e "${VERDE}✅ Registrado hasta el $FECHA_EXP.${FIN}"
    fi
    read -p "Enter para volver..."
}

crear_test() {
    clear
    echo -e "${AMARILLO}⚡ SSH SILK - CREAR CUENTA TEST ${FIN}"
    USER_TEST="silk$(date +%s | tail -c 4)"
    useradd -M -s /bin/false -e "$(date -d '+1 day' +%Y-%m-%d)" "$USER_TEST"
    echo "$USER_TEST:1234" | chpasswd
    echo -e "${VERDE}✅ Cuenta Creada de Prueba!${FIN}"
    echo -e "👤 Usuario: ${CIAN}$USER_TEST${FIN}"
    echo -e "🔑 Pass: 1234"
    read -p "Enter para volver..."
}

eliminar_usuario() {
    clear
    echo -e "${ROJO}⚡ SSH SILK - ELIMINAR USUARIO ${FIN}"
    read -p "👤 Usuario a borrar: " u
    if id "$u" &>/dev/null; then
        userdel -f "$u" &>/dev/null
        echo -e "${VERDE}✅ Usuario eliminado correctamente.${FIN}"
    else
        echo -e "${ROJO}❌ El usuario no existe.${FIN}"
    fi
    read -p "Enter para volver..."
}

listar_usuarios() {
    clear
    echo -e "${CIAN}👥 Usuarios registrados en SSH SILK:${FIN}"
    echo "--------------------------------------------------------"
    awk -F: '$3 >= 1000 && $1 != "nobody" {print " -> " $1}' /etc/passwd
    echo "--------------------------------------------------------"
    read -p "Enter para volver..."
}

gestionar_dropbear() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - CONFIGURAR DROPBEAR ${FIN}"
    if systemctl is-active dropbear &>/dev/null; then
        echo -e "El servicio Dropbear está actualmente: ${VERDE}ACTIVO${FIN}"
        read -p "¿Deseas desactivarlo? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            systemctl stop dropbear && systemctl disable dropbear &>/dev/null
            echo -e "${VERDE}✅ Dropbear desactivado correctamente.${FIN}"
        fi
    else
        read -p "Introduce el puerto para Dropbear (ej: 85, 90): " db_port
        sed -i 's/NO_START=1/NO_START=0/g' /etc/default/dropbear 2>/dev/null
        sed -i "s/DROPBEAR_PORT=.*/DROPBEAR_PORT=$db_port/g" /etc/default/dropbear 2>/dev/null
        ufw allow "$db_port/tcp" &>/dev/null
        systemctl restart dropbear && systemctl enable dropbear &>/dev/null
        echo -e "${VERDE}✅ Dropbear activado exitosamente en el puerto $db_port.${FIN}"
    fi
    read -p "Presione Enter para continuar..."
}

gestionar_websocket() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - WEBSOCKET NORMAL (PUERTO 80 -> 22) ${FIN}"
    if screen -list | grep -q "ws_80"; then
        echo -e "El Proxy WebSocket HTTP ya está: ${VERDE}ACTIVO${FIN}"
        read -p "¿Deseas apagarlo? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            screen -X -S ws_80 quit
            echo -e "${VERDE}✅ WebSocket apagado.${FIN}"
        fi
    else
        echo -e "Descargando modulo Python WebSocket..."
        wget -O /tmp/ws80.py "https://pastebin.com/raw/vYm0wXbU" &>/dev/null
        ufw allow 80/tcp &>/dev/null
        screen -dmS ws_80 python3 /tmp/ws80.py
        echo -e "${VERDE}✅ WebSocket ejecutándose de fondo en puerto 80.${FIN}"
    fi
    read -p "Presione Enter para continuar..."
}

gestionar_websocket_security() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - WEBSOCKET SECURITY (CON RESPUESTA HTTP 101 + SSL 443) ${FIN}"
    if screen -list | grep -q "wss_security"; then
        echo -e "El WebSocket Seguro ya está: ${VERDE}ACTIVO${FIN}"
        read -p "¿Deseas apagarlo? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            screen -X -S wss_security quit
            systemctl stop stunnel4 &>/dev/null
            echo -e "${VERDE}✅ WebSocket Security y SSL desactivados.${FIN}"
        fi
    else
        echo -e "Descargando modulo Python WebSocket Security..."
        wget -O /tmp/wss.py "https://pastebin.com/raw/u36bfe6T" &>/dev/null
        screen -dmS wss_security python3 /tmp/wss.py
        
        mkdir -p /etc/stunnel &>/dev/null
        openssl req -new -newkey rsa:2048 -days 365 -nodes -x509 -keyout /etc/stunnel/stunnel.pem -out /etc/stunnel/stunnel.pem -subj "/C=AR/ST=BA/L=Silk/O=SilkSSH/CN=SSH_SILK" &>/dev/null
        echo "pid = /var/run/stunnel4.pid" > /etc/stunnel/stunnel.conf
        echo "cert = /etc/stunnel/stunnel.pem" >> /etc/stunnel/stunnel.conf
        echo "client = no" >> /etc/stunnel/stunnel.conf
        echo "[websocket_ssl]" >> /etc/stunnel/stunnel.conf
        echo "accept = 443" >> /etc/stunnel/stunnel.conf
        echo "connect = 127.0.0.1:80" >> /etc/stunnel/stunnel.conf
        sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/stunnel4 2>/dev/null
        ufw allow 80/tcp &>/dev/null
        ufw allow 443/tcp &>/dev/null
        systemctl restart stunnel4 &>/dev/null
        echo -e "${VERDE}✅ WebSocket Security activo (80 y SSL 443).${FIN}"
    fi
    read -p "Presione Enter para continuar..."
}

gestionar_badvpn() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - COMPONENTE BADVPN (UDP GATEWAY) ${FIN}"
    if screen -list | grep -q "badvpn"; then
        echo -e "El servicio BadVPN ya está: ${VERDE}ACTIVO${FIN}"
        read -p "¿Deseas detenerlo? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            screen -X -S badvpn quit
            echo -e "${VERDE}✅ BadVPN detenido.${FIN}"
        fi
    else
        echo -e "Descargando binarios de BadVPN..."
        wget -O /usr/local/bin/badvpn-udpgw "https://github.com/ambrop72/badvpn/raw/master/output/badvpn-udpgw" &>/dev/null
        if [ ! -f /usr/local/bin/badvpn-udpgw ] || [ ! -s /usr/local/bin/badvpn-udpgw ]; then
             curl -L -o /usr/local/bin/badvpn-udpgw "https://raw.githubusercontent.com/serverfree/badvpn/master/badvpn-udpgw" &>/dev/null
        fi
        chmod +x /usr/local/bin/badvpn-udpgw &>/dev/null
        ufw allow 7300/udp &>/dev/null
        screen -dmS badvpn badvpn-udpgw --listen-addr 127.0.0.1:7300 --max-clients 1000 --max-connections-for-client 10
        echo -e "${VERDE}✅ BadVPN activo en el puerto 7300 UDP.${FIN}"
    fi
    read -p "Presione Enter para continuar..."
}

configurar_autoinicio() {
    clear
    echo -e "${AMARILLO}⚡ SSH SILK - CONFIGURAR AUTOINICIO GLOBAL ${FIN}"
    if crontab -l 2>/dev/null | grep -q "ws80"; then
        echo -e "El autoinicio ya está: ${VERDE}CONFIGURADO${FIN}"
        read -p "¿Deseas deshabilitarlo? (s/n): " opt
        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            crontab -l | grep -v "ws80" | grep -v "wss.py" | grep -v "badvpn" | crontab -
            echo -e "${VERDE}✅ Autoinicio removido.${FIN}"
        fi
    else
        (crontab -l 2>/dev/null; echo "@reboot screen -dmS ws_80 python3 /tmp/ws80.py") | crontab -
        (crontab -l 2>/dev/null; echo "@reboot screen -dmS wss_security python3 /tmp/wss.py") | crontab -
        (crontab -l 2>/dev/null; echo "@reboot screen -dmS badvpn badvpn-udpgw --listen-addr 127.0.0.1:7300") | crontab -
        echo -e "${VERDE}✅ Autoinicio configurado en cron.${FIN}"
    fi
    read -p "Presione Enter para continuar..."
}

desinstalar_script() {
    clear
    echo -e "${ROJO}⚠️ DESINSTALACIÓN COMPLETA DE SSH SILK ⚠️${FIN}"
    read -p "¿Eliminar el script por completo? (s/n): " opt
    if [[ "$opt" == "s" || "$opt" == "S" ]]; then
        screen -X -S ws_80 quit &>/dev/null
        screen -X -S wss_security quit &>/dev/null
        screen -X -S badvpn quit &>/dev/null
        systemctl stop dropbear &>/dev/null
        systemctl stop stunnel4 &>/dev/null
        rm -f /usr/local/bin/menu &>/dev/null
        rm -f /usr/local/bin/silk &>/dev/null
        rm -f /tmp/ws80.py /tmp/wss.py &>/dev/null
        crontab -l | grep -v "ws80" | grep -v "wss.py" | grep -v "badvpn" | crontab - &>/dev/null
        sed -i '/alias menu=/d' /root/.bashrc &>/dev/null
        sed -i '/alias silk=/d' /root/.bashrc &>/dev/null
        echo -e "${VERDE}✅ SSH SILK desinstalado completamente.${FIN}"
        exit 0
    fi
}

while true; do
    obtener_info_sistema
    clear
    echo -e "${AZUL}╔═════════════════════════════════════════════════════════╗${FIN}"
    echo -e "${AZUL}║${FIN}                 ${MAGENTA}⚡ MANAGER SSH SILK ⚡${FIN}                ${AZUL}║${FIN}"
    echo -e "${AZUL}╚═════════════════════════════════════════════════════════╝${FIN}"
    echo -e " 🔹 OS: ${BLANCO}$OS${FIN}      🔹 Hora: ${BLANCO}$HORA${FIN}"
    printf " 🔹 RAM: %-6s " "$RAM_TOTAL" ; echo -e "${AMARILLO}$(dibujar_barra $RAM_USO_PCT)${FIN}"
    printf " 🔹 CPU: %-6s " "${NUCLEOS} Cores" ; echo -e "${VERDE}$(dibujar_barra $CPU_USO_PCT)${FIN}"
    echo -e "${AZUL} ═════════════════════════════════════════════════════════${FIN}"
    echo -e " 1 • Crear Usuario SSH      5 • Activar Dropbear    [$STATUS_DROPBEAR]"
    echo -e " 2 • Crear Cuenta Test      6 • WebSocket HTTP (80) [$STATUS_WS]"
    echo -e " 3 • Eliminar Usuario       7 • WS Security (443)   [$STATUS_WSS]"
    echo -e " 4 • Ver Lista Usuarios     8 • Activar BadVPN UDP  [$STATUS_BADVPN]"
    echo -e "${AZUL} ═════════════════════════════════════════════════════════${FIN}"
    echo -e " 9 • Configurar AutoInicio  10 • ${ROJO}Desinstalar Script${FIN}"
    echo -e " 0 • Salir del Menú"
    echo -e "${AZUL} ═════════════════════════════════════════════════════════${FIN}"
    read -p " 👉 Seleccione una opción: " opcion
    case $opcion in
        1|01) crear_usuario ;;
        2|02) crear_test ;;
        3|03) eliminar_usuario ;;
        4|04) listar_usuarios ;;
        5|05) gestionar_dropbear ;;
        6|06) gestionar_websocket ;;
        7|07) gestionar_websocket_security ;;
        8|08) gestionar_badvpn ;;
        9|09) configurar_autoinicio ;;
        10) desinstalar_script ;;
        0|00) clear; exit 0 ;;
        *) echo -e "${ROJO}Opción inválida.${FIN}"; sleep 1 ;;
    esac
done
