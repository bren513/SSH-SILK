#!/bin/bash
# ============================================================
# SSH SILK MANAGER v2
# Multi-port Dropbear / WebSocket / WSS / BadVPN
# Ubuntu 20.04 / 22.04 / 24.04 - Debian 10/11/12+
# Requiere ROOT
# ============================================================

set -o pipefail

if [ "$EUID" -ne 0 ]; then
    echo "❌ Ejecuta este script como root."
    exit 1
fi

# ---------------- COLORES ----------------
VERDE="\e[1;32m"
ROJO="\e[1;31m"
AZUL="\e[1;34m"
CIAN="\e[1;36m"
AMARILLO="\e[1;33m"
MAGENTA="\e[1;35m"
BLANCO="\e[1;37m"
FIN="\e[0m"

# ---------------- RUTAS ----------------
BASE="/etc/silk"
BIN="/usr/local/bin"
SYSTEMD="/etc/systemd/system"
WS_SCRIPT="$BASE/ws80.py"
DROPBEAR_PORTS_FILE="$BASE/dropbear.ports"
BADVPN_PORTS_FILE="$BASE/badvpn.ports"
WSS_PORTS_FILE="$BASE/wss.ports"
WS_PORTS_FILE="$BASE/ws.ports"

WS_URL="https://pastebin.com/raw/vYm0wXbU"
BADVPN_URL="https://github.com/ambrop72/badvpn/raw/master/output/badvpn-udpgw"
BADVPN_FALLBACK="https://raw.githubusercontent.com/serverfree/badvpn/master/badvpn-udpgw"

mkdir -p "$BASE"

# ============================================================
# FUNCIONES GENERALES
# ============================================================

pausa() {
    read -r -p "Presiona Enter para continuar..."
}

validar_puerto() {
    local p="$1"
    [[ "$p" =~ ^[0-9]+$ ]] && [ "$p" -ge 1 ] && [ "$p" -le 65535 ]
}

puerto_tcp_activo() {
    local p="$1"
    ss -lntH 2>/dev/null | awk '{print $4}' |
        grep -Eq "(^|:)${p}$|\\]:${p}$"
}

puerto_udp_activo() {
    local p="$1"
    ss -lnuH 2>/dev/null | awk '{print $5}' |
        grep -Eq "(^|:)${p}$|\\]:${p}$"
}

puerto_libre_tcp() {
    ! puerto_tcp_activo "$1"
}

puerto_libre_udp() {
    ! puerto_udp_activo "$1"
}

lista_limpia() {
    tr ' ' '\n' <<< "$1" |
        sed '/^$/d' |
        sort -n -u |
        tr '\n' ' ' |
        sed 's/[[:space:]]*$//'
}

validar_lista_puertos() {
    local lista="$1"
    local p

    [ -n "$lista" ] || return 1

    for p in $lista; do
        validar_puerto "$p" || {
            echo -e "${ROJO}❌ Puerto inválido: $p${FIN}"
            return 1
        }
    done
    return 0
}

abrir_tcp_firewall() {
    local p
    for p in $*; do
        ufw allow "$p/tcp" >/dev/null 2>&1 || true
    done
}

abrir_udp_firewall() {
    local p
    for p in $*; do
        ufw allow "$p/udp" >/dev/null 2>&1 || true
    done
}

cerrar_tcp_firewall() {
    local p
    for p in $*; do
        ufw delete allow "$p/tcp" >/dev/null 2>&1 || true
    done
}

cerrar_udp_firewall() {
    local p
    for p in $*; do
        ufw delete allow "$p/udp" >/dev/null 2>&1 || true
    done
}

mostrar_puertos_tcp() {
    local title="$1"
    local lista="$2"

    echo -e "${CIAN}$title${FIN}"
    if [ -z "$lista" ]; then
        echo "  Ninguno"
        return
    fi

    for p in $lista; do
        if puerto_tcp_activo "$p"; then
            echo -e "  $p/tcp ${VERDE}ON${FIN}"
        else
            echo -e "  $p/tcp ${ROJO}OFF${FIN}"
        fi
    done
}

mostrar_puertos_udp() {
    local title="$1"
    local lista="$2"

    echo -e "${CIAN}$title${FIN}"
    if [ -z "$lista" ]; then
        echo "  Ninguno"
        return
    fi

    for p in $lista; do
        if puerto_udp_activo "$p"; then
            echo -e "  $p/udp ${VERDE}ON${FIN}"
        else
            echo -e "  $p/udp ${ROJO}OFF${FIN}"
        fi
    done
}

# ============================================================
# DEPENDENCIAS
# ============================================================

instalar_dependencias() {
    echo -e "${CIAN}Instalando/verificando dependencias...${FIN}"

    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y >/dev/null 2>&1 || true

    local deps=(
        lsb-release
        ufw
        bc
        gawk
        host
        dropbear
        stunnel4
        python3
        wget
        curl
        openssl
        procps
        iproute2
    )

    apt-get install -y "${deps[@]}" >/dev/null 2>&1

    if ! command -v dropbear >/dev/null 2>&1; then
        echo -e "${ROJO}❌ No se pudo instalar Dropbear.${FIN}"
        return 1
    fi

    if ! command -v ss >/dev/null 2>&1; then
        echo -e "${ROJO}❌ No se encontró ss/iproute2.${FIN}"
        return 1
    fi

    return 0
}

# ============================================================
# SYSTEMD - DROPBEAR MULTI PUERTO
# ============================================================

crear_servicio_dropbear() {
    cat > "$SYSTEMD/silk-dropbear.service" <<'EOF'
[Unit]
Description=SSH SILK Dropbear Multi Port
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/dropbear -F -E -R -p 0.0.0.0:${SILK_DROPBEAR_PORTS}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF

    # systemd no expande variables dentro de ExecStart sin EnvironmentFile.
    cat > "$SYSTEMD/silk-dropbear.service" <<'EOF'
[Unit]
Description=SSH SILK Dropbear Multi Port
After=network.target
Wants=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/silk/dropbear.env
ExecStart=/usr/sbin/dropbear -F -E -R -p 0.0.0.0:${SILK_DROPBEAR_PORTS}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF
}

obtener_dropbear_bin() {
    if [ -x /usr/sbin/dropbear ]; then
        echo "/usr/sbin/dropbear"
    elif command -v dropbear >/dev/null 2>&1; then
        command -v dropbear
    else
        echo ""
    fi
}

gestionar_dropbear() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - DROPBEAR MULTI PUERTO${FIN}"
    echo "========================================================"

    local bin_dropbear
    bin_dropbear="$(obtener_dropbear_bin)"

    if [ -z "$bin_dropbear" ]; then
        echo -e "${ROJO}❌ Dropbear no está instalado.${FIN}"
        pausa
        return
    fi

    local actual=""
    [ -f "$DROPBEAR_PORTS_FILE" ] && actual="$(cat "$DROPBEAR_PORTS_FILE")"

    if systemctl is-active --quiet silk-dropbear.service; then
        echo -e "Estado: ${VERDE}ON${FIN}"
        echo
        mostrar_puertos_tcp "Puertos configurados:" "$actual"
        echo
        read -r -p "¿Deseas reconfigurar los puertos? (s/n): " opt

        if [[ "$opt" != "s" && "$opt" != "S" ]]; then
            pausa
            return
        fi
    fi

    echo
    echo "Introduce los puertos separados por espacios."
    echo "Ejemplo: 22 2222 2200"
    echo

    read -r -p "Puertos Dropbear: " nuevos
    nuevos="$(lista_limpia "$nuevos")"

    if ! validar_lista_puertos "$nuevos"; then
        echo -e "${ROJO}❌ Lista de puertos inválida.${FIN}"
        pausa
        return
    fi

    # Evitar conflictos con otros procesos.
    local p
    for p in $nuevos; do
        if puerto_tcp_activo "$p"; then
            # Si ya es uno de nuestros puertos, se permite.
            if ! grep -qw "$p" "$DROPBEAR_PORTS_FILE" 2>/dev/null; then
                echo -e "${ROJO}❌ El puerto TCP $p ya está ocupado por otro proceso.${FIN}"
                pausa
                return
            fi
        fi
    done

    # Detener servicio anterior.
    systemctl stop silk-dropbear.service >/dev/null 2>&1 || true

    # Desactivar servicio Dropbear nativo para evitar conflicto.
    systemctl disable --now dropbear.service >/dev/null 2>&1 || true
    systemctl disable --now dropbear.socket >/dev/null 2>&1 || true

    echo "$nuevos" > "$DROPBEAR_PORTS_FILE"

    # -p acepta múltiples argumentos; construimos un wrapper.
    cat > "$BASE/dropbear-start.sh" <<EOF
#!/bin/bash
exec "$bin_dropbear" -F -E -R \\
$(for p in $nuevos; do printf '  -p 0.0.0.0:%s \\\n' "$p"; done)
EOF
    chmod +x "$BASE/dropbear-start.sh"

    cat > "$SYSTEMD/silk-dropbear.service" <<EOF
[Unit]
Description=SSH SILK Dropbear Multi Port
After=network.target
Wants=network.target
Conflicts=dropbear.service dropbear.socket

[Service]
Type=simple
ExecStart=$BASE/dropbear-start.sh
Restart=always
RestartSec=2
KillMode=process

[Install]
WantedBy=multi-user.target
EOF

    abrir_tcp_firewall $nuevos

    systemctl daemon-reload
    systemctl enable silk-dropbear.service >/dev/null 2>&1
    systemctl restart silk-dropbear.service

    sleep 2

    echo
    if systemctl is-active --quiet silk-dropbear.service; then
        echo -e "${VERDE}✅ Dropbear iniciado correctamente.${FIN}"
        mostrar_puertos_tcp "Puertos:" "$nuevos"
    else
        echo -e "${ROJO}❌ Dropbear no pudo iniciar.${FIN}"
        echo
        journalctl -u silk-dropbear.service -n 20 --no-pager
    fi

    pausa
}

# ============================================================
# WEBSOCKET HTTP
# ============================================================

crear_servicio_ws() {
    cat > "$SYSTEMD/silk-websocket.service" <<EOF
[Unit]
Description=SSH SILK WebSocket HTTP
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 $WS_SCRIPT
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF
}

descargar_ws() {
    if [ ! -s "$WS_SCRIPT" ]; then
        echo "Descargando módulo WebSocket..."
        wget -q -O "$WS_SCRIPT" "$WS_URL"
    fi

    [ -s "$WS_SCRIPT" ]
}

gestionar_websocket() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - WEBSOCKET HTTP${FIN}"
    echo "========================================================"

    local puertos="80"
    echo "$puertos" > "$WS_PORTS_FILE"

    if puerto_tcp_activo 80; then
        echo -e "Estado: ${VERDE}ON${FIN}"
        echo "Puerto: 80"
        echo
        read -r -p "¿Deseas detener WebSocket HTTP? (s/n): " opt

        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            systemctl disable --now silk-websocket.service >/dev/null 2>&1 || true
            echo -e "${VERDE}✅ WebSocket detenido.${FIN}"
        fi

        pausa
        return
    fi

    echo -e "Estado: ${ROJO}OFF${FIN}"
    echo

    if ! descargar_ws; then
        echo -e "${ROJO}❌ No se pudo descargar $WS_SCRIPT${FIN}"
        pausa
        return
    fi

    if puerto_tcp_activo 80; then
        echo -e "${ROJO}❌ El puerto 80 está ocupado.${FIN}"
        pausa
        return
    fi

    abrir_tcp_firewall 80
    crear_servicio_ws

    systemctl daemon-reload
    systemctl enable silk-websocket.service >/dev/null 2>&1
    systemctl restart silk-websocket.service

    sleep 2

    echo
    if puerto_tcp_activo 80; then
        echo -e "${VERDE}✅ WebSocket HTTP ACTIVO en 80.${FIN}"
    else
        echo -e "${ROJO}❌ WebSocket no abrió el puerto 80.${FIN}"
        echo
        journalctl -u silk-websocket.service -n 20 --no-pager
    fi

    pausa
}

# ============================================================
# WSS / SECURITY
# ============================================================

crear_certificado_ssl() {
    mkdir -p /etc/stunnel

    if [ ! -s /etc/stunnel/stunnel.pem ]; then
        openssl req \
            -new \
            -newkey rsa:2048 \
            -days 365 \
            -nodes \
            -x509 \
            -keyout /etc/stunnel/stunnel.pem \
            -out /etc/stunnel/stunnel.pem \
            -subj "/C=AR/ST=BA/L=Silk/O=SilkSSH/CN=SSH_SILK" \
            >/dev/null 2>&1
    fi

    chmod 600 /etc/stunnel/stunnel.pem
}

configurar_stunnel() {
    cat > /etc/stunnel/stunnel.conf <<EOF
pid = /run/stunnel4.pid
cert = /etc/stunnel/stunnel.pem
client = no
foreground = no

[websocket_ssl]
accept = 443
connect = 127.0.0.1:80
EOF

    if [ -f /etc/default/stunnel4 ]; then
        if grep -q '^ENABLED=' /etc/default/stunnel4; then
            sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/stunnel4
        else
            echo "ENABLED=1" >> /etc/default/stunnel4
        fi
    fi
}

gestionar_websocket_security() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - WEBSOCKET SECURITY / WSS${FIN}"
    echo "========================================================"

    if puerto_tcp_activo 443; then
        echo -e "Estado: ${VERDE}ON${FIN}"
        echo "Puerto SSL: 443"
        echo "Destino interno: 127.0.0.1:80"
        echo

        read -r -p "¿Deseas detener WSS? (s/n): " opt

        if [[ "$opt" == "s" || "$opt" == "S" ]]; then
            systemctl disable --now stunnel4 >/dev/null 2>&1 || true
            echo -e "${VERDE}✅ WebSocket Security detenido.${FIN}"
        fi

        pausa
        return
    fi

    echo -e "Estado: ${ROJO}OFF${FIN}"
    echo

    if puerto_tcp_activo 443; then
        echo -e "${ROJO}❌ El puerto 443 está ocupado.${FIN}"
        pausa
        return
    fi

    # WSS depende del WebSocket HTTP en 80.
    if ! puerto_tcp_activo 80; then
        echo "WebSocket HTTP no está activo."
        echo "Se intentará iniciarlo automáticamente..."

        if ! descargar_ws; then
            echo -e "${ROJO}❌ No se pudo descargar el módulo WebSocket.${FIN}"
            pausa
            return
        fi

        abrir_tcp_firewall 80
        crear_servicio_ws
        systemctl daemon-reload
        systemctl enable silk-websocket.service >/dev/null 2>&1
        systemctl restart silk-websocket.service

        sleep 2

        if ! puerto_tcp_activo 80; then
            echo -e "${ROJO}❌ WebSocket HTTP no abrió el puerto 80.${FIN}"
            journalctl -u silk-websocket.service -n 20 --no-pager
            pausa
            return
        fi
    fi

    crear_certificado_ssl
    configurar_stunnel

    abrir_tcp_firewall 443

    systemctl daemon-reload
    systemctl enable stunnel4 >/dev/null 2>&1
    systemctl restart stunnel4

    sleep 2

    echo
    if puerto_tcp_activo 443; then
        echo -e "${VERDE}✅ WebSocket Security ACTIVO.${FIN}"
        echo -e "${VERDE}✅ 80  -> WebSocket HTTP${FIN}"
        echo -e "${VERDE}✅ 443 -> SSL/WSS -> 80${FIN}"
    else
        echo -e "${ROJO}❌ WSS no abrió el puerto 443.${FIN}"
        echo
        systemctl status stunnel4 --no-pager
        echo
        journalctl -u stunnel4 -n 20 --no-pager
    fi

    pausa
}

# ============================================================
# BADVPN MULTI PUERTO
# ============================================================

descargar_badvpn() {
    if [ ! -x "$BIN/badvpn-udpgw" ]; then
        echo "Descargando BadVPN..."

        wget -q -O "$BIN/badvpn-udpgw" "$BADVPN_URL"

        if [ ! -s "$BIN/badvpn-udpgw" ]; then
            curl -L -s -o "$BIN/badvpn-udpgw" "$BADVPN_FALLBACK"
        fi

        chmod +x "$BIN/badvpn-udpgw"
    fi

    [ -x "$BIN/badvpn-udpgw" ]
}

crear_servicio_badvpn() {
    cat > "$SYSTEMD/silk-badvpn@.service" <<'EOF'
[Unit]
Description=SSH SILK BadVPN UDP Gateway %i
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/badvpn-udpgw --listen-addr 0.0.0.0:%i --max-clients 1000 --max-connections-for-client 10
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF
}

detener_todos_badvpn() {
    local lista="$1"
    local p

    for p in $lista; do
        systemctl disable --now "silk-badvpn@${p}.service" >/dev/null 2>&1 || true
    done
}

gestionar_badvpn() {
    clear
    echo -e "${CIAN}⚡ SSH SILK - BADVPN MULTI PUERTO${FIN}"
    echo "========================================================"

    local actual=""
    [ -f "$BADVPN_PORTS_FILE" ] && actual="$(cat "$BADVPN_PORTS_FILE")"

    if [ -n "$actual" ]; then
        mostrar_puertos_udp "Puertos configurados:" "$actual"
    fi

    echo
    read -r -p "¿Deseas configurar/reconfigurar puertos? (s/n): " opt

    if [[ "$opt" != "s" && "$opt" != "S" ]]; then
        pausa
        return
    fi

    echo
    echo "Ejemplo: 7300 7301 7302 7303"
    read -r -p "Puertos BadVPN UDP: " nuevos
    nuevos="$(lista_limpia "$nuevos")"

    if ! validar_lista_puertos "$nuevos"; then
        echo -e "${ROJO}❌ Lista inválida.${FIN}"
        pausa
        return
    fi

    if ! descargar_badvpn; then
        echo -e "${ROJO}❌ No se pudo obtener BadVPN.${FIN}"
        pausa
        return
    fi

    local p

    for p in $nuevos; do
        if puerto_udp_activo "$p"; then
            if ! grep -qw "$p" "$BADVPN_PORTS_FILE" 2>/dev/null; then
                echo -e "${ROJO}❌ El puerto UDP $p ya está ocupado.${FIN}"
                pausa
                return
            fi
        fi
    done

    detener_todos_badvpn "$actual"

    echo "$nuevos" > "$BADVPN_PORTS_FILE"

    crear_servicio_badvpn
    systemctl daemon-reload

    abrir_udp_firewall $nuevos

    for p in $nuevos; do
        systemctl enable --now "silk-badvpn@${p}.service" >/dev/null 2>&1
    done

    sleep 2

    echo
    mostrar_puertos_udp "Estado BadVPN:" "$nuevos"

    for p in $nuevos; do
        if ! puerto_udp_activo "$p"; then
            echo -e "${ROJO}⚠️ Revisa: journalctl -u silk-badvpn@$p${FIN}"
        fi
    done

    pausa
}

# ============================================================
# USUARIOS SSH
# ============================================================

crear_usuario() {
    clear
    echo -e "${VERDE}⚡ SSH SILK - CREAR USUARIO SSH${FIN}"

    read -r -p "👤 Nombre de usuario: " usuario

    if id "$usuario" >/dev/null 2>&1; then
        echo -e "${ROJO}❌ Ya existe.${FIN}"
        pausa
        return
    fi

    read -r -s -p "🔑 Contraseña: " contrasena
    echo
    read -r -p "⏳ Días de duración: " dias

    if ! [[ "$dias" =~ ^[0-9]+$ ]]; then
        echo -e "${ROJO}❌ Días inválidos.${FIN}"
        pausa
        return
    fi

    local fecha
    fecha="$(date -d "+$dias days" +%Y-%m-%d)"

    useradd -M -s /bin/false -e "$fecha" "$usuario"
    echo "$usuario:$contrasena" | chpasswd

    echo -e "${VERDE}✅ Usuario creado.${FIN}"
    echo "Usuario: $usuario"
    echo "Expira:  $fecha"

    pausa
}

crear_test() {
    clear
    echo -e "${AMARILLO}⚡ SSH SILK - CREAR CUENTA TEST${FIN}"

    local user_test="silk$(date +%s | tail -c 5)"

    useradd -M -s /bin/false -e "$(date -d '+1 day' +%Y-%m-%d)" "$user_test"
    echo "$user_test:1234" | chpasswd

    echo -e "${VERDE}✅ Cuenta de prueba creada.${FIN}"
    echo "👤 Usuario: $user_test"
    echo "🔑 Pass: 1234"

    pausa
}

eliminar_usuario() {
    clear
    echo -e "${ROJO}⚡ SSH SILK - ELIMINAR USUARIO${FIN}"

    read -r -p "👤 Usuario a borrar: " u

    if id "$u" >/dev/null 2>&1; then
        userdel -f "$u" >/dev/null 2>&1
        echo -e "${VERDE}✅ Usuario eliminado.${FIN}"
    else
        echo -e "${ROJO}❌ El usuario no existe.${FIN}"
    fi

    pausa
}

listar_usuarios() {
    clear
    echo -e "${CIAN}👥 Usuarios registrados:${FIN}"
    echo "--------------------------------------------------------"

    awk -F: '$3 >= 1000 && $1 != "nobody" {print " -> " $1}' /etc/passwd

    echo "--------------------------------------------------------"
    pausa
}

# ============================================================
# ESTADOS
# ============================================================

estado_dropbear() {
    local lista=""
    [ -f "$DROPBEAR_PORTS_FILE" ] && lista="$(cat "$DROPBEAR_PORTS_FILE")"

    if systemctl is-active --quiet silk-dropbear.service; then
        echo -e "${VERDE}ON${FIN}"
    else
        echo -e "${ROJO}OFF${FIN}"
    fi
}

estado_ws() {
    if puerto_tcp_activo 80; then
        echo -e "${VERDE}ON${FIN}"
    else
        echo -e "${ROJO}OFF${FIN}"
    fi
}

estado_wss() {
    if puerto_tcp_activo 443; then
        echo -e "${VERDE}ON${FIN}"
    else
        echo -e "${ROJO}OFF${FIN}"
    fi
}

estado_badvpn() {
    local lista=""
    [ -f "$BADVPN_PORTS_FILE" ] && lista="$(cat "$BADVPN_PORTS_FILE")"

    local p
    for p in $lista; do
        if puerto_udp_activo "$p"; then
            echo -e "${VERDE}ON${FIN}"
            return
        fi
    done

    echo -e "${ROJO}OFF${FIN}"
}

# ============================================================
# INFORMACIÓN
# ============================================================

obtener_info_sistema() {
    OS="$(lsb_release -ds 2>/dev/null || grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d '"')"
    HORA="$(date +"%H:%M:%S")"
    NUCLEOS="$(nproc)"
    RAM_TOTAL="$(free -h | awk '/Mem:/ {print $2}')"
    RAM_USO_PCT="$(free | awk '/Mem:/ {if ($2>0) print int($3/$2*100); else print 0}')"
    CPU_USO_PCT="$(top -bn1 | awk -F'[, ]+' '/Cpu\(s\)/ {for(i=1;i<=NF;i++) if($i ~ /id/) {gsub(/%/,"",$(i-1)); print int(100-$(i-1)); exit}}')"
    [ -z "$CPU_USO_PCT" ] && CPU_USO_PCT=0
}

dibujar_barra() {
    local pct="$1"
    local total=10
    local llenos=$((pct / 10))
    local vacios=$((total - llenos))

    [ "$llenos" -lt 0 ] && llenos=0
    [ "$llenos" -gt "$total" ] && llenos=$total
    [ "$vacios" -lt 0 ] && vacios=0

    printf "["
    for ((i=0; i<llenos; i++)); do printf "■"; done
    for ((i=0; i<vacios; i++)); do printf " "; done
    printf "] %d%%" "$pct"
}

# ============================================================
# DIAGNÓSTICO
# ============================================================

diagnostico() {
    clear

    echo -e "${MAGENTA}⚡ SSH SILK - DIAGNÓSTICO${FIN}"
    echo "========================================================"

    echo
    echo -e "${CIAN}DROPBEAR${FIN}"
    local d=""
    [ -f "$DROPBEAR_PORTS_FILE" ] && d="$(cat "$DROPBEAR_PORTS_FILE")"
    mostrar_puertos_tcp "Puertos:" "$d"

    echo
    echo -e "${CIAN}WEBSOCKET HTTP${FIN}"
    mostrar_puertos_tcp "Puerto:" "80"

    echo
    echo -e "${CIAN}WEBSOCKET SECURITY${FIN}"
    mostrar_puertos_tcp "Puerto:" "443"

    echo
    echo -e "${CIAN}BADVPN${FIN}"
    local b=""
    [ -f "$BADVPN_PORTS_FILE" ] && b="$(cat "$BADVPN_PORTS_FILE")"
    mostrar_puertos_udp "Puertos:" "$b"

    echo
    echo -e "${CIAN}SERVICIOS SYSTEMD${FIN}"
    systemctl is-active silk-dropbear.service 2>/dev/null || true
    systemctl is-active silk-websocket.service 2>/dev/null || true
    systemctl is-active stunnel4 2>/dev/null || true

    echo
    echo -e "${CIAN}PUERTOS ESCUCHANDO${FIN}"
    ss -lntup 2>/dev/null | grep -E ':(80|443|22|2222|7300|7301|7302|7303)\b' || true

    echo
    echo "Para ver errores:"
    echo "journalctl -u silk-dropbear.service -n 50 --no-pager"
    echo "journalctl -u silk-websocket.service -n 50 --no-pager"
    echo "journalctl -u stunnel4 -n 50 --no-pager"

    pausa
}

# ============================================================
# INSTALACIÓN / AUTOINICIO
# ============================================================

instalar_systemd_base() {
    systemctl daemon-reload
}

configurar_alias() {
    cp "$0" "$BIN/menu" >/dev/null 2>&1 || true
    chmod +x "$BIN/menu" >/dev/null 2>&1 || true

    if ! grep -q "alias menu=" /root/.bashrc 2>/dev/null; then
        echo "alias menu='$BIN/menu'" >> /root/.bashrc
    fi

    if ! grep -q "alias silk=" /root/.bashrc 2>/dev/null; then
        echo "alias silk='$BIN/menu'" >> /root/.bashrc
    fi
}

desinstalar_script() {
    clear
    echo -e "${ROJO}⚠️ DESINSTALACIÓN SSH SILK${FIN}"
    echo "========================================================"
    read -r -p "¿Eliminar servicios y configuración? (s/n): " opt

    [[ "$opt" == "s" || "$opt" == "S" ]] || return

    local d=""
    local b=""
    [ -f "$DROPBEAR_PORTS_FILE" ] && d="$(cat "$DROPBEAR_PORTS_FILE")"
    [ -f "$BADVPN_PORTS_FILE" ] && b="$(cat "$BADVPN_PORTS_FILE")"

    systemctl disable --now silk-dropbear.service >/dev/null 2>&1 || true
    systemctl disable --now silk-websocket.service >/dev/null 2>&1 || true
    systemctl disable --now stunnel4 >/dev/null 2>&1 || true

    local p
    for p in $b; do
        systemctl disable --now "silk-badvpn@${p}.service" >/dev/null 2>&1 || true
    done

    cerrar_tcp_firewall $d
    cerrar_tcp_firewall 80 443
    cerrar_udp_firewall $b

    rm -f \
        "$SYSTEMD/silk-dropbear.service" \
        "$SYSTEMD/silk-websocket.service" \
        "$SYSTEMD/silk-badvpn@.service"

    systemctl daemon-reload

    rm -rf "$BASE"
    rm -f "$BIN/menu"

    sed -i '/alias menu=/d' /root/.bashrc 2>/dev/null || true
    sed -i '/alias silk=/d' /root/.bashrc 2>/dev/null || true

    echo -e "${VERDE}✅ SSH SILK desinstalado.${FIN}"
    exit 0
}

# ============================================================
# INSTALACIÓN INICIAL
# ============================================================

inicializar() {
    instalar_dependencias || exit 1
    instalar_systemd_base
    configurar_alias
}

