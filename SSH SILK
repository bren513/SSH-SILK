Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
}
badvpn_active(){ systemctl list-units --type=service --state=running 'silk-badvpn@*.service' --no-legend 2>/dev/null|sed -n 's/.*silk-badvpn@\([0-9]*\)\.service.*/\1/p'|sort -n;}
badvpn_add(){ 
