#!/bin/bash
# =========================================================
# SSH SILK MANAGER PRO v5.0.3
# Compacto / móvil / verde + cian
# Dropbear multi-puerto | WebSocket | WSS | BadVPN
# Actualización online | Auto inicio OFF por defecto
# =========================================================

set -u

VERSION="5.0.4"
GITHUB_URL="https://raw.githubusercontent.com/bren513/SSH-SILK/refs/heads/main/SSH%20SILK"
BIN="/usr/local/bin"
DATA="/etc/ssh-silk"
BACKUP="$DATA/backups"
MENU="$BIN/menu"
LOG="$DATA/silk.log"

C="\e[1;36m"; G="\e[1;32m"; R="\e[1;31m"; Y="\e[1;33m"; W="\e[1;37m"; D="\e[0;90m"; N="\e[0m"

mkdir -p "$DATA" "$BACKUP"
touch "$LOG"

log(){ echo "[$(date '+%F %T')] $*" >> "$LOG"; }
say(){ echo -e "$*"; }
pause(){ read -r -p "  Presiona ENTER para continuar..." _; }

die(){ say "${R}❌ $*${N}"; exit 1; }

require_root(){
  [ "${EUID:-999}" -eq 0 ] || die "Ejecuta este script como root."
}

have(){ command -v "$1" >/dev/null 2>&1; }

install_deps(){
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y >/dev/null 2>&1 || true
  apt-get install -y curl wget ca-certificates openssh-client openssh-server dropbear socat stunnel4 openssl screen ufw procps iproute2 gawk lsof >/dev/null 2>&1 || true
}

save_config(){
  cat > "$DATA/config" <<EOF
AUTOSTART=${AUTOSTART:-0}
DROPBEAR_PORTS=${DROPBEAR_PORTS:-}
WS_PORTS=${WS_PORTS:-}
WSS_PORTS=${WSS_PORTS:-}
BADVPN_PORTS=${BADVPN_PORTS:-}
EOF
}

load_config(){
  AUTOSTART=0
  DROPBEAR_PORTS=""
  WS_PORTS="80"
  WSS_PORTS="443"
  BADVPN_PORTS="7300"
  [ -f "$DATA/config" ] && . "$DATA/config"
}

color_status(){
  local v="$1"
  if [ "$v" = "ON" ]; then say "${G}● ON${N}"; else say "${R}● OFF${N}"; fi
}

port_owner(){
  local proto="$1" port="$2"
  ss -H -lntup 2>/dev/null | awk -v p=":$port" -v pr="$proto" '$0 ~ p {print; exit}'
}

tcp_listening(){ ss -H -ltn 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" || $4 ~ p"$" {found=1} END{exit !found}'; }
udp_listening(){ ss -H -lun 2>/dev/null | awk -v p=":$1" '$5 ~ p"$" || $5 ~ p"$" {found=1} END{exit !found}'; }

port_free(){
  local proto="$1" port="$2"
  if [ "$proto" = "tcp" ]; then ! tcp_listening "$port"; else ! udp_listening "$port"; fi
}

open_fw(){
  local proto="$1" ports="$2"
  for p in $ports; do
    ufw allow "$p/$proto" >/dev/null 2>&1 || true
  done
}

close_fw(){
  local proto="$1" ports="$2"
  for p in $ports; do
    ufw delete allow "$p/$proto" >/dev/null 2>&1 || true
  done
}

# ---------- systemd helpers ----------
install_unit(){
  local name="$1"; shift
  local exec="$*"
  cat > "/etc/systemd/system/$name.service" <<EOF
[Unit]
Description=SSH SILK $name
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$exec
Restart=always
RestartSec=2
KillMode=process

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}

# ---------- WebSocket ----------
make_ws(){
  local f="$DATA/ws.py"
  cat > "$f" <<'PY'
#!/usr/bin/env python3
import socket,select,sys,threading

LISTEN_HOST="0.0.0.0"
TARGET_HOST="127.0.0.1"
TARGET_PORT=int(sys.argv[2]) if len(sys.argv)>2 else 22
LISTEN_PORT=int(sys.argv[1]) if len(sys.argv)>1 else 80

def pipe(a,b):
    try:
        while True:
            r,_,_=select.select([a,b],[],[],300)
            if not r: break
            for s in r:
                data=s.recv(65535)
                if not data: return
                (b if s is a else a).sendall(data)
    except Exception: pass
    finally:
        for s in (a,b):
            try:s.close()
            except:pass

def client(c):
    try:
        c.settimeout(10)
        req=c.recv(8192)
        if b"Upgrade: websocket" not in req.lower():
            c.close(); return
        c.sendall(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
        s=socket.create_connection((TARGET_HOST,TARGET_PORT),10)
        c.settimeout(None); s.settimeout(None)
        pipe(c,s)
    except Exception:
        try:c.close()
        except:pass

srv=socket.socket()
srv.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)
srv.bind((LISTEN_HOST,LISTEN_PORT))
srv.listen(256)
while True:
    c,_=srv.accept()
    threading.Thread(target=client,args=(c,),daemon=True).start()
PY
  chmod 755 "$f"
}

ws_config(){
  local ports="$1"
  local i=0 p
  for p in $ports; do
    install_unit "silk-ws-$p" "/usr/bin/python3 $DATA/ws.py $p 22"
    systemctl enable --now "silk-ws-$p.service" >/dev/null 2>&1 || true
    open_fw tcp "$p"
    i=$((i+1))
  done
}

ws_stop_port(){
  local p="$1"
  systemctl disable --now "silk-ws-$p.service" >/dev/null 2>&1 || true
  close_fw tcp "$p"
}

# ---------- WSS ----------
make_cert(){
  [ -s "$DATA/stunnel.pem" ] || openssl req -new -newkey rsa:2048 -days 825 -nodes -x509 \
    -keyout "$DATA/stunnel.pem" -out "$DATA/stunnel.pem" \
    -subj "/C=AR/ST=BA/L=Silk/O=SSH-SILK/CN=SSH-SILK" >/dev/null 2>&1
}

wss_config(){
  local ports="$1" p
  make_cert
  for p in $ports; do
    cat > "/etc/stunnel/silk-$p.conf" <<EOF
foreground = no
pid = /run/stunnel-silk-$p.pid
cert = $DATA/stunnel.pem
client = no
[silk-wss-$p]
accept = 0.0.0.0:$p
connect = 127.0.0.1:80
EOF
    install_unit "silk-wss-$p" "/usr/bin/stunnel4 /etc/stunnel/silk-$p.conf"
    systemctl enable --now "silk-wss-$p.service" >/dev/null 2>&1 || true
    open_fw tcp "$p"
  done
}

wss_stop_port(){
  local p="$1"
  systemctl disable --now "silk-wss-$p.service" >/dev/null 2>&1 || true
  rm -f "/etc/stunnel/silk-$p.conf"
  close_fw tcp "$p"
}

# ---------- Dropbear ----------
dropbear_config(){
  local ports="$1" p
  [ -n "$ports" ] || { say "${Y}⚠ No se ingresaron puertos.${N}"; return 1; }

  local occupied=""
  for p in $ports; do
    if ! port_free tcp "$p"; then
      occupied="$occupied $p"
    fi
  done
  [ -z "$occupied" ] || { say "${R}❌ Puertos ocupados:$occupied${N}"; return 1; }

  systemctl disable --now dropbear.service dropbear.socket >/dev/null 2>&1 || true
  pkill -x dropbear >/dev/null 2>&1 || true

  mkdir -p /etc/dropbear
  dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1 || true
  dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1 || true

  local args=""
  for p in $ports; do args="$args -p 0.0.0.0:$p"; done

  install_unit "silk-dropbear" "/usr/sbin/dropbear -E -F $args"
  systemctl enable --now silk-dropbear.service >/dev/null 2>&1 || {
    say "${R}❌ Dropbear no pudo iniciar.${N}"
    journalctl -u silk-dropbear.service -n 20 --no-pager
    return 1
  }

  open_fw tcp "$ports"
  DROPBEAR_PORTS="$ports"; save_config
  say "${G}✅ Dropbear iniciado: $ports${N}"
}

dropbear_stop_port(){
  local target="$1" new="" p
  for p in $DROPBEAR_PORTS; do [ "$p" != "$target" ] && new="$new $p"; done
  new="${new# }"
  systemctl disable --now silk-dropbear.service >/dev/null 2>&1 || true
  close_fw tcp "$target"
  if [ -n "$new" ]; then dropbear_config "$new"; else DROPBEAR_PORTS=""; save_config; fi
}

# ---------- BadVPN ----------
find_badvpn(){
  if have badvpn-udpgw; then command -v badvpn-udpgw; return; fi
  [ -x /usr/local/bin/badvpn-udpgw ] && { echo /usr/local/bin/badvpn-udpgw; return; }
  return 1
}

install_badvpn(){
  local out="$DATA/badvpn-udpgw"
  if [ -x "$out" ]; then echo "$out"; return 0; fi

  local url="https://raw.githubusercontent.com/abdullahrm/badvpn/master/badvpn-udpgw"
  if curl -fsSL "$url" -o "$out" 2>/dev/null && [ -s "$out" ]; then
    chmod 755 "$out"
    if "$out" --help >/dev/null 2>&1; then echo "$out"; return 0; fi
  fi
  rm -f "$out"

  say "${Y}⚠ No se encontró binario UDPGW compatible. Intentando compilar...${N}"
  apt-get install -y build-essential cmake libssl-dev >/dev/null 2>&1 || true
  local src="$DATA/badvpn-src"
  rm -rf "$src"
  if git clone -q --depth 1 https://github.com/ambrop72/badvpn.git "$src" 2>/dev/null; then
    cd "$src" || return 1
    mkdir -p build && cd build || return 1
    cmake .. -DBUILD_NOTHING_BY_DEFAULT=1 -DBUILD_UDPGW=1 >/dev/null 2>&1 || return 1
    make -j"$(nproc)" >/dev/null 2>&1 || return 1
    local built
    built="$(find "$src/build" -type f -name badvpn-udpgw -perm -111 | head -n1)"
    if [ -n "$built" ]; then
      cp "$built" "$out"; chmod 755 "$out"; echo "$out"; return 0
    fi
  fi
  return 1
}

badvpn_config(){
  local ports="$1" p bin
  [ -n "$ports" ] || { say "${Y}⚠ No se ingresaron puertos.${N}"; return 1; }
  bin="$(install_badvpn)" || { say "${R}❌ No se pudo instalar BadVPN/UDPGW.${N}"; return 1; }

  for p in $ports; do
    if ! port_free udp "$p"; then
      say "${R}❌ UDP $p está ocupado.${N}"
      continue
    fi
    install_unit "silk-badvpn-$p" "$bin --listen-addr 0.0.0.0:$p --max-clients 1000 --max-connections-for-client 10"
    if systemctl enable --now "silk-badvpn-$p.service" >/dev/null 2>&1; then
      open_fw udp "$p"
      if udp_listening "$p"; then
        say "${G}● UDP $p ON${N}"
      else
        say "${R}● UDP $p OFF${N}"
        journalctl -u "silk-badvpn-$p.service" -n 10 --no-pager
      fi
    else
      say "${R}❌ Falló BadVPN en UDP $p${N}"
      journalctl -u "silk-badvpn-$p.service" -n 10 --no-pager
    fi
  done
  BADVPN_PORTS="$ports"; save_config
}

badvpn_stop_port(){
  local p="$1"
  systemctl disable --now "silk-badvpn-$p.service" >/dev/null 2>&1 || true
  close_fw udp "$p"
  local new="" x
  for x in $BADVPN_PORTS; do [ "$x" != "$p" ] && new="$new $x"; done
  BADVPN_PORTS="${new# }"; save_config
}

# ---------- statuses ----------
any_tcp(){
  local ports="$1" p
  for p in $ports; do tcp_listening "$p" && return 0; done
  return 1
}
any_udp(){
  local ports="$1" p
  for p in $ports; do udp_listening "$p" && return 0; done
  return 1
}
status_dropbear(){ any_tcp "$DROPBEAR_PORTS"; }
status_ws(){ any_tcp "$WS_PORTS"; }
status_wss(){ any_tcp "$WSS_PORTS"; }
status_badvpn(){ any_udp "$BADVPN_PORTS"; }

# ---------- panel ----------
bar(){
  local pct="$1" n=$((pct/10)) out="" i
  [ "$pct" -gt 100 ] && pct=100
  [ "$pct" -lt 0 ] && pct=0
  for ((i=0;i<10;i++)); do [ $i -lt $n ] && out+="█" || out+="·"; done
  printf "%s %3d%%" "$out" "$pct"
}

term_width(){ tput cols 2>/dev/null || echo 80; }

header(){
  clear
  local w; w="$(term_width)"
  [ "$w" -gt 58 ] && w=58
  local line; line="$(printf '%*s' "$w" '' | tr ' ' '═')"
  say "${C}╔$line╗${N}"
  printf "${C}║${N}%*s%s%*s${C}║${N}\n" $(( (w-24)/2 )) "" "⚡ SSH SILK MANAGER PRO ⚡" $(( (w-24+1)/2 )) ""
  say "${C}╚$line╝${N}"
}

