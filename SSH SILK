        echo "        if 'Upgrade: websocket' in req:" >> /tmp/wss.py
        echo "            c.send(b'HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n')" >> /tmp/wss.py
        echo "        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)" >> /tmp/wss.py
        echo "        s.connect(('127.0.0.1', 22))" >> /tmp/wss.py
