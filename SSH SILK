update_online(){
  header; say "${C}ACTUALIZACIÓN ONLINE${N}"
  local tmp remote_ver current_ver remote_num current_num
  tmp="$(mktemp "$DATA/update.XXXXXX")"

  say "${D}Descargando desde GitHub...${N}"
  if ! curl -4 -fLsS --retry 3 --connect-timeout 10 --max-time 60 "$GITHUB_URL" -o "$tmp"; then
    rm -f "$tmp"
    say "${R}❌ No se pudo descargar la versión de GitHub.${N}"
    say "${Y}Comprueba conectividad con:${N}"
    say "curl -4 -I '$GITHUB_URL'"
    pause; return
  fi

  if [ ! -s "$tmp" ] || ! head -n 1 "$tmp" | grep -q '^#!/bin/bash$' ||
     ! grep -q 'SSH SILK MANAGER' "$tmp" || ! bash -n "$tmp"; then
    rm -f "$tmp"
    say "${R}❌ El archivo remoto no pasó la validación.${N}"
    pause; return
  fi

  remote_ver="$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2)"
  current_ver="$VERSION"
  say "Versión instalada : ${Y}$current_ver${N}"
  say "Versión GitHub    : ${G}${remote_ver:-desconocida}${N}"

  if [ -z "$remote_ver" ]; then
    rm -f "$tmp"; say "${R}❌ GitHub no contiene VERSION.${N}"; pause; return
  fi

  remote_num="$(printf '%s' "$remote_ver" | awk -F. '{printf "%d%03d%03d",$1,$2,$3}')"
  current_num="$(printf '%s' "$current_ver" | awk -F. '{printf "%d%03d%03d",$1,$2,$3}')"

  if (( 10#$remote_num < 10#$current_num )); then
    rm -f "$tmp"
    say "${R}❌ La versión de GitHub es anterior. Se evita un downgrade.${N}"
    pause; return
  fi
  if (( 10#$remote_num == 10#$current_num )); then
    rm -f "$tmp"
    say "${Y}⚠ Ya tienes la misma versión instalada.${N}"
    pause; return
  fi

  local backup="$BACKUP/menu-$current_ver-$(date +%Y%m%d-%H%M%S).bak"
  cp "$MENU" "$backup" 2>/dev/null || true
  install -m 755 "$tmp" "$MENU"
  rm -f "$tmp"

  if ! bash -n "$MENU"; then
    say "${R}❌ La nueva versión falló la validación. Restaurando...${N}"
    [ -f "$backup" ] && install -m 755 "$backup" "$MENU"
    pause; return
  fi

  say "${G}✅ Actualización instalada: v$remote_ver${N}"
  say "${D}Reiniciando el panel...${N}"
  sleep 1
  exec "$MENU"
}

# ---------- safe installation ----------
install_self(){
  local src="$1" tmp
  tmp="$(mktemp)"
  if [ "$src" = "/dev/fd/"* ] || [ "$src" = "bash" ] || [ ! -f "$src" ]; then
    curl -fsSL "$GITHUB_URL" -o "$tmp" || return 1
  else
    cp "$src" "$tmp"
  fi
  head -n1 "$tmp" | grep -q '^#!/bin/bash' || return 1
  bash -n "$tmp" || return 1
  grep -q 'SSH SILK MANAGER PRO' "$tmp" || return 1
  [ -f "$MENU" ] && cp "$MENU" "$BACKUP/menu-preinstall-$(date +%s)" || true
  install -m 755 "$tmp" "$MENU"
  rm -f "$tmp"
  echo "$MENU"
}

main(){
  require_root
  install_deps
  load_config

  # Si el archivo actual no está instalado correctamente, instala una copia
  # sin usar $0 como fuente cuando el script viene por curl|bash.
  if [ ! -f "$MENU" ] || ! bash -n "$MENU" >/dev/null 2>&1; then
    install_self "${BASH_SOURCE[0]:-}" >/dev/null 2>&1 || true
  fi

  while true; do
    dashboard
    read -r -p " 👉 Selecciona una opción: " op
    case "$op" in
      1) create_user;;
      2) create_test;;
      3) online_users;;
      4) list_users;;
      5) delete_user;;
      6) ws_menu;;
      7) wss_menu;;
      8) badvpn_menu;;
      9) diagnostic;;
      10) system_info;;
      11) update_online;;
      12) dropbear_menu;;
      13) stop_menu;;
      14) toggle_autostart;;
      0|00) clear; exit 0;;
      *) say "${R}❌ Opción inválida.${N}"; sleep 1;;
    esac
  done
}

main "$@"
