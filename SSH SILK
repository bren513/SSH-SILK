make_cert(){  mkdir -p /etc/stunnel/ssh-silk;[[ -s /etc/stunnel/stunnel.pem ]]||openssl req -new -newkey rsa:2048 -days 825 -nodes -x509 -keyout /etc/stunnel/stunnel.pem -out /etc/stunnel/stunnel.pem -subj '/C=AR/ST=BA/L=Silk/O=SSH-SILK/CN=SSH-SILK' >/dev/null 2>&1;chmod 600 /etc/stunnel/stunnel.pem; }
wss_add(){ 
 clear;header "WEBSOCKET SECURITY / WSS";has stunnel|| { err "stunnel4 no está instalado.";pause;return;};write_ws_py;write_ws_unit;write_wss_unit;write_wss_backend_unit;make_cert;read -r -p "Puertos WSS (ej: 443 8443): " raw;local ports p ip w conf;ports=$(ports_normalize "$raw");[[ -n "$ports" ]]|| { err "No hay puertos válidos.";pause;return;}
 for p in $ports;do if port_listening tcp "$p"&& ! systemctl is-active --quiet "silk-wss@$p.service";then err "TCP $p está ocupado.";continue;fi
   w=$((20000+p%20000));while port_listening tcp "$w";do ((w++));done
   systemctl enable --now "silk-wss-backend@$w.service" >/dev/null 2>&1|| { err "No se pudo preparar WebSocket interno para WSS $p";continue;}
   conf="/etc/stunnel/ssh-silk/$p.conf";cat >"$conf" <<EOF2
foreground = yes
pid =
cert = /etc/stunnel/stunnel.pem
client = no
[wss]
accept = 0.0.0.0:$p
connect = 127.0.0.1:$w
EOF2
   echo "$w" > "/etc/stunnel/ssh-silk/$p.backend"
   if systemctl enable --now "silk-wss@$p.service" >/dev/null 2>&1;then fw_tcp_add "$p";port_listening tcp "$p"&& ok "WSS activo en $p"|| err "WSS $p no escucha.";else err "Falló WSS $p";journalctl -u "silk-wss@$p.service" -n 10 --no-pager 2>/dev/null;fi
done;pause
}
wss_stop(){ 
 clear;header "DETENER WSS";local cur p raw ports;cur=$(wss_active|| true);[[ -n "$cur" ]]|| { warn "No hay WSS activos.";pause;return;};echo "Activos: $cur";read -r -p "Puertos a detener o ALL: " raw;if [[ ${raw^^} == ALL ]];then for p in $cur;do systemctl disable --now "silk-wss@$p.service" >/dev/null 2>&1|| true; if [[ -s "/etc/stunnel/ssh-silk/$p.backend" ]]; then b=$(cat "/etc/stunnel/ssh-silk/$p.backend"); systemctl disable --now "silk-wss-backend@$b.service" >/dev/null 2>&1||true; fi; fw_tcp_del "$p";rm -f "/etc/stunnel/ssh-silk/$p.conf" "/etc/stunnel/ssh-silk/$p.backend";done;else ports=$(ports_normalize "$raw");for p in $ports;do systemctl disable --now "silk-wss@$p.service" >/dev/null 2>&1|| true; if [[ -s "/etc/stunnel/ssh-silk/$p.backend" ]]; then b=$(cat "/etc/stunnel/ssh-silk/$p.backend"); systemctl disable --now "silk-wss-backend@$b.service" >/dev/null 2>&1||true; fi; fw_tcp_del "$p";rm -f "/etc/stunnel/ssh-silk/$p.conf" "/etc/stunnel/ssh-silk/$p.backend";done;fi;ok "Operación completada.";pause
}

# ---------- BadVPN ----------
install_badvpn(){ 
 has badvpn-udpgw&& return 0
 local arch url tmp;arch=$(uname -m);case "$arch" in x86_64|amd64)url='https://raw.githubusercontent.com/idtunnel/UDPGW-SSH/master/badvpn-udpgw64';; i386|i686)url='https://raw.githubusercontent.com/idtunnel/UDPGW-SSH/master/badvpn-udpgw';; *) err "Arquitectura $arch no soportada por el binario automático de BadVPN."; return 1;; esac
 tmp=$(mktemp);curl -fsSL --connect-timeout 10 --max-time 90 "$url" -o "$tmp"|| { rm -f "$tmp";return 1;};if has file;then file "$tmp"|grep -qiE 'ELF|executable'|| { rm -f "$tmp";return 1;};else head -c4 "$tmp"|od -An -tx1|grep -qi '7f 45 4c 46'|| { rm -f "$tmp";return 1;};fi;install -m755 "$tmp" /usr/local/bin/badvpn-udpgw;rm -f "$tmp"; }
write_badvpn_unit(){ 
cat >/etc/systemd/system/silk-badvpn@.service <<'UNIT'
[Unit]
