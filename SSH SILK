        echo "        forward(s, c)" >> /tmp/wss.py
        echo "    except: pass" >> /tmp/wss.py
        echo "def forward(src, dst):" >> /tmp/wss.py
        echo "    try:" >> /tmp/wss.py
        echo "        while True:" >> /tmp/wss.py
        echo "            d = src.recv(4096)" >> /tmp/wss.py
        echo "            if not d: break" >> /tmp/wss.py
        echo "            dst.send(d)" >> /tmp/wss.py
        echo "    except: pass" >> /tmp/wss.py
        echo "    finally: src.close(); dst.close()" >> /tmp/wss.py
        echo "srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)" >> /tmp/wss.py
        echo "srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)" >> /tmp/wss.py
        echo "srv.bind(('0.0.0.0', 80))" >> /tmp/wss.py
        echo "srv.listen(100)" >> /tmp/wss.py
        echo "while True:" >> /tmp/wss.py
        echo "    c, a = srv.accept()" >> /tmp/wss.py
        echo "    threading.Thread(target=proxy, args=(c, a)).start()" >> /tmp/wss.py
        screen -dmS wss_security python3 /tmp/wss.py
        mkdir -p /etc/stunnel &>/dev/null
