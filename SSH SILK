# ============================================================

install_dependencies || exit 1
install_alias

while true; do
    clear
    draw_panel
    echo
    read -r -p " 👉 Selecciona una opción: " option

    case "$option" in
        1|01) create_user ;;
        2|02) create_test ;;
        3|03)
            clear
            echo -e "${CIAN}⚡ ONLINE / CONSUMOS${FIN}"
            echo "Conectados: $(get_ssh_connections)"
            ss -H -tn state established 2>/dev/null
            pause_menu
            ;;
        4|04) list_users ;;
        5|05) delete_user ;;
        6|06) manage_websocket ;;
        7|07) manage_wss ;;
        8|08) manage_badvpn ;;
        9|09) diagnostic ;;
        10) system_info ;;
        11) online_update ;;
        12) manage_dropbear ;;
        13) uninstall_script ;;
        0|00) clear; exit 0 ;;
        *) echo -e "${ROJO}❌ Opción inválida.${FIN}"; sleep 1 ;;
    esac
done
