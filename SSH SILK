    obtener_info_sistema

    STATUS_DROPBEAR="$(estado_dropbear)"
    STATUS_WS="$(estado_ws)"
    STATUS_WSS="$(estado_wss)"
    STATUS_BADVPN="$(estado_badvpn)"

    clear

    echo -e "${AZUL}╔════════════════════════════════════════════════════════════╗${FIN}"
    echo -e "${AZUL}║${FIN}                  ${MAGENTA}⚡ SSH SILK v2 ⚡${FIN}                  ${AZUL}║${FIN}"
    echo -e "${AZUL}╚════════════════════════════════════════════════════════════╝${FIN}"

    echo -e " 🔹 OS: ${BLANCO}$OS${FIN}      🔹 Hora: ${BLANCO}$HORA${FIN}"
    printf " 🔹 RAM: %-6s " "$RAM_TOTAL"
    echo -e "${AMARILLO}$(dibujar_barra "$RAM_USO_PCT")${FIN}"

    printf " 🔹 CPU: %-6s " "${NUCLEOS} Cores"
    echo -e "${VERDE}$(dibujar_barra "$CPU_USO_PCT")${FIN}"

    echo -e "${AZUL} ════════════════════════════════════════════════════════════${FIN}"

    echo -e " 1 • Crear Usuario SSH       5 • Dropbear Multi-Puerto [$STATUS_DROPBEAR]"
    echo -e " 2 • Crear Cuenta Test       6 • WebSocket HTTP (80)   [$STATUS_WS]"
    echo -e " 3 • Eliminar Usuario        7 • WebSocket WSS (443)   [$STATUS_WSS]"
    echo -e " 4 • Ver Lista Usuarios      8 • BadVPN Multi-Puerto   [$STATUS_BADVPN]"

    echo -e "${AZUL} ════════════════════════════════════════════════════════════${FIN}"

    echo -e " 9 • Diagnóstico              10 • ${ROJO}Desinstalar Script${FIN}"
    echo -e " 0 • Salir"

    echo -e "${AZUL} ════════════════════════════════════════════════════════════${FIN}"

    read -r -p " 👉 Seleccione una opción: " opcion

    case "$opcion" in
        1|01) crear_usuario ;;
        2|02) crear_test ;;
        3|03) eliminar_usuario ;;
        4|04) listar_usuarios ;;
        5|05) gestionar_dropbear ;;
        6|06) gestionar_websocket ;;
        7|07) gestionar_websocket_security ;;
        8|08) gestionar_badvpn ;;
        9|09) diagnostico ;;
        10) desinstalar_script ;;
        0|00)
            clear
            exit 0
            ;;
        *)
            echo -e "${ROJO}❌ Opción inválida.${FIN}"
            sleep 1
            ;;
    esac
done
