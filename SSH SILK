# ---------- user management ----------
validar_usuario(){
  local u="$1"
  [[ "$u" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || return 1
  [[ "$u" != *"--"* ]] || return 1
}

create_user(){
  header; say "${C}CREAR USUARIO SSH${N}"
  read -r -p " Usuario (a-z, 0-9, _ o -): " u
  u="${u,,}"
  if ! validar_usuario "$u"; then
    say "${R}❌ Nombre inválido.${N}"
    say "${Y}Usa 1-32 caracteres: letras minúsculas, números, _ o -; debe comenzar con letra o _.${N}"
    pause; return
  fi
  if id "$u" >/dev/null 2>&1; then
    say "${R}❌ El usuario ya existe.${N}"; pause; return
  fi
  read -r -s -p " Contraseña: " p; echo
  [ -n "$p" ] || { say "${R}❌ La contraseña no puede estar vacía.${N}"; pause; return; }
  read -r -p " Días de duración: " d
  [[ "$d" =~ ^[0-9]+$ ]] && (( d >= 1 && d <= 3650 )) || { say "${R}❌ Días inválidos (1-3650).${N}"; pause; return; }
  local fecha; fecha="$(date -d "+$d days" +%Y-%m-%d)"
  if useradd -M -s /bin/false -e "$fecha" "$u" && echo "$u:$p" | chpasswd; then
    say "${G}✅ Usuario creado correctamente.${N}"
    say " Usuario: ${C}$u${N}"
    say " Expira : ${W}$fecha${N}"
  else
    say "${R}❌ No se pudo crear el usuario.${N}"
    say "${Y}El sistema rechazó el nombre o la configuración de useradd.${N}"
  fi
  pause
}
create_test(){
  local u="silk$(date +%s | tail -c 5)"
  useradd -M -s /bin/false -e "$(date -d '+1 day' +%F)" "$u" && echo "$u:1234" | chpasswd
  header; say "${G}✅ TEST CREADO${N}"; say " Usuario: ${C}$u${N}"; say " Pass: ${W}1234${N}"; pause
}
list_users(){
  header; say "${C}USUARIOS${N}"
  awk -F: '$3>=1000 && $1!="nobody"{print " ● "$1}' /etc/passwd
  pause
}
delete_user(){
  header; read -r -p " Usuario a eliminar: " u
  id "$u" >/dev/null 2>&1 && userdel -f "$u" && say "${G}✅ Eliminado.${N}" || say "${R}❌ No existe.${N}"
  pause
}
online_users(){ header; who; pause; }

ws_menu(){
  header; say "${C}WEBSOCKET HTTP${N}"
  read -r -p " Puertos TCP (ej: 80 8080): " p
  for x in $p; do
    if ! port_free tcp "$x"; then say "${R}❌ TCP $x ocupado.${N}"; continue; fi
  done
  make_ws; ws_config "$p"; WS_PORTS="$p"; save_config
  pause
}
wss_menu(){
  header; say "${C}WEBSOCKET SECURITY${N}"
  [ -n "$WS_PORTS" ] || { say "${R}❌ Primero activa WebSocket HTTP.${N}"; pause; return; }
  read -r -p " Puertos SSL (ej: 443 8443): " p
  wss_config "$p"; WSS_PORTS="$p"; save_config
  pause
}
badvpn_menu(){
  header; say "${C}BADVPN UDP MULTI-PUERTO${N}"
  read -r -p " Puertos UDP (ej: 7300 7301 7302): " p
  badvpn_config "$p"
  pause
}
dropbear_menu(){
  header; say "${C}DROPBEAR TCP MULTI-PUERTO${N}"
  read -r -p " Puertos (ej: 2222 2200 8080): " p
  dropbear_config "$p"
  pause
}

stop_menu(){
  header; say "${C}DETENER PUERTOS${N}"
  say "[1] Dropbear   [2] WebSocket   [3] WSS   [4] BadVPN   [5] Todo"
  read -r -p " Selecciona: " op
  local p x
  case "$op" in
    1) read -r -p " Puerto Dropbear: " p; dropbear_stop_port "$p";;
    2) read -r -p " Puerto WS: " p; ws_stop_port "$p";;
    3) read -r -p " Puerto WSS: " p; wss_stop_port "$p";;
    4) read -r -p " Puerto BadVPN: " p; badvpn_stop_port "$p";;
    5)
      for x in $DROPBEAR_PORTS; do close_fw tcp "$x"; done
      systemctl disable --now silk-dropbear.service >/dev/null 2>&1 || true
      for x in $WS_PORTS; do ws_stop_port "$x"; done
      for x in $WSS_PORTS; do wss_stop_port "$x"; done
      for x in $BADVPN_PORTS; do badvpn_stop_port "$x"; done
      DROPBEAR_PORTS=""; WS_PORTS=""; WSS_PORTS=""; BADVPN_PORTS=""; save_config
      say "${G}✅ Protocolos detenidos.${N}";;
  esac
  pause
}

diagnostic(){
  header; say "${C}DIAGNÓSTICO${N}"
  say "${W}TCP:${N}"; ss -lntp 2>/dev/null | sed -n '1,30p'
  say "${W}UDP:${N}"; ss -lnup 2>/dev/null | sed -n '1,30p'
  say "${W}SERVICIOS SILK:${N}"; systemctl --no-pager --type=service 'silk-*' 2>/dev/null || true
  pause
}

