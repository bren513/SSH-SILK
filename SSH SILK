#!/bin/bash
# ============================================================
# SSH SILK MANAGER v4.0.0
# Dropbear multi-puerto / WebSocket / WSS / BadVPN
# Información del sistema / Diagnóstico / Actualización online
# Ubuntu 20.04/22.04/24.04 - Debian 10/11/12+
# ============================================================

set -o pipefail

VERSION="4.0.0"
GITHUB_RAW_URL="https://raw.githubusercontent.com/bren513/SSH-SILK/refs/heads/main/SSH%20SILK"

BASE="/etc/silk"
BIN="/usr/local/bin"
INSTALL_PATH="$BIN/menu"
SYSTEMD="/etc/systemd/system"

WS_SCRIPT="$BASE/ws80.py"
WS_TARGET_FILE="$BASE/ws.target"
DROPBEAR_PORTS_FILE="$BASE/dropbear.ports"
BADVPN_PORTS_FILE="$BASE/badvpn.ports"

mkdir -p "$BASE"

if [ "$EUID" -ne 0 ]; then
    echo "❌ Ejecuta este script como root."
    exit 1
fi

# ---------------- COLORES ----------------
VERDE="\e[1;32m"
ROJO="\e[1;31m"
AZUL="\e[1;34m"
CIAN="\e[1;36m"
AMARILLO="\e[1;33m"
MAGENTA="\e[1;35m"
BLANCO="\e[1;37m"
GRIS="\e[0;37m"
FIN="\e[0m"

# ============================================================
# UTILIDADES
# ============================================================

pause_menu() {
    read -r -p "Presiona Enter para continuar..."
}

valid_port() {
    [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

clean_ports() {
    tr ' ' '\n' <<< "$1" | sed '/^$/d' | sort -n -u | tr '\n' ' ' | sed 's/[[:space:]]*$//'
}

validate_ports() {
    local p
    [ -n "$1" ] || return 1
    for p in $1; do
        if ! valid_port "$p"; then
            echo -e "${ROJO}❌ Puerto inválido: $p${FIN}"
            return 1
        fi
    done
    return 0
}

tcp_listening() {
    local p="$1"
    ss -H -lnt 2>/dev/null | awk '{print $4}' |
        grep -Eq "(^|:)${p}$|\\]:${p}$"
}

udp_listening() {
    local p="$1"
    ss -H -lnu 2>/dev/null | awk '{print $5}' |
        grep -Eq "(^|:)${p}$|\\]:${p}$"
}

port_owner() {
    local p="$1"
    ss -lntup 2>/dev/null | grep -E "(:|\])${p}[[:space:]]" | head -n 3
}

tcp_owner_is_dropbear() {
    local p="$1"
    port_owner "$p" | grep -qi "dropbear"
}

tcp_owner_is_silk_ws() {
    local p="$1"
    port_owner "$p" | grep -Eqi "python|ws80"
}

open_tcp() {
    local p
    for p in "$@"; do
        command -v ufw >/dev/null 2>&1 && ufw allow "$p/tcp" >/dev/null 2>&1 || true
    done
}

open_udp() {
    local p
    for p in "$@"; do
        command -v ufw >/dev/null 2>&1 && ufw allow "$p/udp" >/dev/null 2>&1 || true
    done
}

close_tcp() {
    local p
    for p in "$@"; do
        command -v ufw >/dev/null 2>&1 && ufw delete allow "$p/tcp" >/dev/null 2>&1 || true
    done
}

close_udp() {
    local p
    for p in "$@"; do
        command -v ufw >/dev/null 2>&1 && ufw delete allow "$p/udp" >/dev/null 2>&1 || true
    done
}

tcp_status_list() {
    local list="$1" p
    [ -n "$list" ] || { echo "  Ninguno"; return; }
    for p in $list; do
        if tcp_listening "$p"; then
            echo -e "  ${VERDE}●${FIN} $p/tcp  ${VERDE}ON${FIN}"
        else
            echo -e "  ${ROJO}●${FIN} $p/tcp  ${ROJO}OFF${FIN}"
        fi
    done
}

udp_status_list() {
    local list="$1" p
    [ -n "$list" ] || { echo "  Ninguno"; return; }
    for p in $list; do
        if udp_listening "$p"; then
            echo -e "  ${VERDE}●${FIN} $p/udp  ${VERDE}ON${FIN}"
        else
            echo -e "  ${ROJO}●${FIN} $p/udp  ${ROJO}OFF${FIN}"
        fi
    done
}

service_on() {
    systemctl is-active --quiet "$1" 2>/dev/null
}

# ============================================================
# DEPENDENCIAS
# ============================================================

install_dependencies() {
    echo -e "${CIAN}⚙ Verificando dependencias...${FIN}"

    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y >/dev/null 2>&1 || true
    apt-get install -y \
        lsb-release ufw bc gawk host dropbear stunnel4 python3 \
        wget curl openssl procps iproute2 >/dev/null 2>&1

    local missing=0
    for cmd in ss curl wget openssl python3 systemctl; do
        command -v "$cmd" >/dev/null 2>&1 || {
            echo -e "${ROJO}❌ Falta: $cmd${FIN}"
            missing=1
        }
    done

    command -v dropbear >/dev/null 2>&1 || {
        echo -e "${ROJO}❌ Dropbear no está instalado.${FIN}"
        missing=1
    }

    return "$missing"
}

# ============================================================
# INSTALACIÓN PERSISTENTE / ALIAS
# ============================================================

install_alias() {
    # Si se ejecutó como archivo normal, guardar copia.
    if [ -f "$0" ] && [[ "$0" != /dev/fd/* ]] && [[ "$0" != /proc/* ]]; then
        cp "$0" "$INSTALL_PATH" >/dev/null 2>&1 || true
    fi

    if [ ! -s "$INSTALL_PATH" ]; then
        local tmp="/tmp/ssh_silk_bootstrap_$$.sh"
        if curl -fLsS --connect-timeout 10 --max-time 60 "$GITHUB_RAW_URL" -o "$tmp" &&
           [ -s "$tmp" ] && bash -n "$tmp" >/dev/null 2>&1 &&
           grep -q "SSH SILK" "$tmp"; then
            cp "$tmp" "$INSTALL_PATH"
            chmod +x "$INSTALL_PATH"
        fi
        rm -f "$tmp"
    fi

    chmod +x "$INSTALL_PATH" 2>/dev/null || true

    if ! grep -qF "alias menu='$INSTALL_PATH'" /root/.bashrc 2>/dev/null; then
        echo "alias menu='$INSTALL_PATH'" >> /root/.bashrc
    fi
    if ! grep -qF "alias silk='$INSTALL_PATH'" /root/.bashrc 2>/dev/null; then
        echo "alias silk='$INSTALL_PATH'" >> /root/.bashrc
    fi
}

# ============================================================
# DROPBEAR - IMPLEMENTACIÓN ROBUSTA
# ============================================================

dropbear_bin() {
    if [ -x /usr/sbin/dropbear ]; then
        echo /usr/sbin/dropbear
    else
        command -v dropbear 2>/dev/null || true
    fi
}

ensure_dropbear_keys() {
    local dir="/etc/dropbear"
    mkdir -p "$dir"

    if command -v dropbearkey >/dev/null 2>&1; then
        if [ ! -s "$dir/dropbear_rsa_host_key" ]; then
            dropbearkey -t rsa -f "$dir/dropbear_rsa_host_key" >/dev/null 2>&1 || true
        fi
        if [ ! -s "$dir/dropbear_ed25519_host_key" ]; then
            dropbearkey -t ed25519 -f "$dir/dropbear_ed25519_host_key" >/dev/null 2>&1 || true
        fi
    fi
}

mask_native_dropbear() {
    # Evita que el socket/servicio del paquete vuelva a levantar otro Dropbear.
    systemctl disable --now dropbear.service >/dev/null 2>&1 || true
    systemctl disable --now dropbear.socket >/dev/null 2>&1 || true
    systemctl mask dropbear.service >/dev/null 2>&1 || true
    systemctl mask dropbear.socket >/dev/null 2>&1 || true
}

unmask_native_dropbear() {
    systemctl unmask dropbear.service >/dev/null 2>&1 || true
    systemctl unmask dropbear.socket >/dev/null 2>&1 || true
}

stop_silk_dropbear() {
    systemctl disable --now silk-dropbear.service >/dev/null 2>&1 || true
    # Solo mata procesos Dropbear si existen; nunca mata sshd.
    pkill -x dropbear >/dev/null 2>&1 || true
    sleep 1
}

write_dropbear_service() {
    local bin="$1"
    local ports="$2"
    local args="" p

    for p in $ports; do
        args+=" -p 0.0.0.0:${p}"
    done

    cat > "$BASE/dropbear-start.sh" <<EOF
#!/bin/bash
exec "$bin" -F -E$args
EOF
    chmod 700 "$BASE/dropbear-start.sh"

    cat > "$SYSTEMD/silk-dropbear.service" <<EOF
[Unit]
Description=SSH SILK Dropbear Multi Port
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$BASE/dropbear-start.sh
Restart=on-failure
RestartSec=2
TimeoutStartSec=15
TimeoutStopSec=10
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF
}

manage_dropbear() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • DROPBEAR MULTI-PUERTO${FIN}"
    echo "============================================================"

    local bin old ports p bad=0
    bin="$(dropbear_bin)"

    if [ -z "$bin" ]; then
        echo -e "${ROJO}❌ Dropbear no está disponible.${FIN}"
        pause_menu
        return
    fi

    [ -f "$DROPBEAR_PORTS_FILE" ] && old="$(cat "$DROPBEAR_PORTS_FILE")"

    echo -e "Estado: $(service_on silk-dropbear.service && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}")"
    echo -e "${CIAN}Puertos configurados:${FIN}"
    tcp_status_list "$old"
    echo
    echo "Ejemplo: 2222 2200 8080"
    read -r -p "🔌 Nuevos puertos: " ports
    ports="$(clean_ports "$ports")"

    if ! validate_ports "$ports"; then
        pause_menu
        return
    fi

    # Revisar conflictos ANTES de tocar el servicio actual.
    for p in $ports; do
        if tcp_listening "$p"; then
            if tcp_owner_is_dropbear "$p"; then
                continue
            fi
            echo -e "${ROJO}❌ Puerto $p/tcp ya está ocupado.${FIN}"
            port_owner "$p"
            bad=1
        fi
    done

    if [ "$bad" -eq 1 ]; then
        echo
        echo -e "${AMARILLO}No se modificó la configuración actual.${FIN}"
        pause_menu
        return
    fi

    stop_silk_dropbear
    mask_native_dropbear
    ensure_dropbear_keys

    write_dropbear_service "$bin" "$ports"
    printf '%s\n' "$ports" > "$DROPBEAR_PORTS_FILE"

    open_tcp $ports
    systemctl daemon-reload
    systemctl enable silk-dropbear.service >/dev/null 2>&1
    systemctl restart silk-dropbear.service
    sleep 2

    bad=0
    for p in $ports; do
        tcp_listening "$p" || bad=1
    done

    echo
    if [ "$bad" -eq 0 ]; then
        echo -e "${VERDE}✅ Dropbear iniciado correctamente.${FIN}"
        tcp_status_list "$ports"
    else
        echo -e "${ROJO}❌ Dropbear no pudo abrir uno o más puertos.${FIN}"
        echo
        echo "Servicio:"
        systemctl status silk-dropbear.service --no-pager -l
        echo
        echo "Últimos errores:"
        journalctl -u silk-dropbear.service -n 30 --no-pager
        echo
        echo -e "${AMARILLO}Prueba manual:${FIN}"
        echo "$BASE/dropbear-start.sh"
    fi

    pause_menu
}

# ============================================================
# WEBSOCKET HTTP - SIN PASTE/DEPENDENCIA EXTERNA
# ============================================================

write_websocket_python() {
    cat > "$WS_SCRIPT" <<'PYEOF'
#!/usr/bin/env python3
import base64
import hashlib
import select
import socket
import struct
import threading
import time
from socketserver import ThreadingMixIn, TCPServer, BaseRequestHandler

LISTEN_HOST = "0.0.0.0"
LISTEN_PORT = 80
TARGET_HOST = "127.0.0.1"
TARGET_PORT = 22
BUFFER = 65536

def recv_exact(sock, n):
    data = b""
    while len(data) < n:
        part = sock.recv(n - len(data))
        if not part:
            return None
        data += part
    return data

def websocket_send(sock, payload, opcode=2):
    first = 0x80 | (opcode & 0x0f)
    length = len(payload)
    if length < 126:
        header = struct.pack("!BB", first, length)
    elif length < 65536:
        header = struct.pack("!BBH", first, 126, length)
    else:
        header = struct.pack("!BBQ", first, 127, length)
    sock.sendall(header + payload)

def websocket_recv(sock):
    head = recv_exact(sock, 2)
    if not head:
        return None, None
    b1, b2 = head
    opcode = b1 & 0x0f
    masked = b2 & 0x80
    length = b2 & 0x7f

    if length == 126:
        raw = recv_exact(sock, 2)
        if not raw:
            return None, None
        length = struct.unpack("!H", raw)[0]
    elif length == 127:
        raw = recv_exact(sock, 8)
        if not raw:
            return None, None
        length = struct.unpack("!Q", raw)[0]

    if length > 16 * 1024 * 1024:
        return None, None

    mask = recv_exact(sock, 4) if masked else None
    payload = recv_exact(sock, length)
    if payload is None:
        return None, None

    if mask:
        payload = bytes(payload[i] ^ mask[i % 4] for i in range(len(payload)))

    return opcode, payload

class WSHandler(BaseRequestHandler):
    def handle(self):
        client = self.request
        client.settimeout(15)

        try:
            request = b""
            while b"\r\n\r\n" not in request and len(request) < 65536:
                chunk = client.recv(4096)
                if not chunk:
                    return
                request += chunk

            header_text = request.decode("latin1", "ignore")
            lines = header_text.split("\r\n")
            headers = {}
            for line in lines[1:]:
                if ":" in line:
                    k, v = line.split(":", 1)
                    headers[k.strip().lower()] = v.strip()

            if "upgrade" not in headers.get("connection", "").lower() or \
               headers.get("upgrade", "").lower() != "websocket" or \
               "sec-websocket-key" not in headers:
                client.sendall(
                    b"HTTP/1.1 400 Bad Request\r\n"
                    b"Connection: close\r\n"
                    b"Content-Length: 0\r\n\r\n"
                )
                return

            key = headers["sec-websocket-key"]
            accept = base64.b64encode(
                hashlib.sha1(
                    (key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()
                ).digest()
            ).decode()

            client.sendall(
                b"HTTP/1.1 101 Switching Protocols\r\n"
                b"Upgrade: websocket\r\n"
                b"Connection: Upgrade\r\n"
                + f"Sec-WebSocket-Accept: {accept}\r\n\r\n".encode()
            )

            client.settimeout(None)

            target = socket.create_connection((TARGET_HOST, TARGET_PORT), timeout=10)
            target.settimeout(None)

            def client_to_target():
                try:
                    while True:
                        opcode, payload = websocket_recv(client)
                        if opcode is None:
                            break
                        if opcode == 8:
                            break
                        if opcode == 9:
                            websocket_send(client, payload, 10)
                            continue
                        if opcode in (1, 2, 0):
                            target.sendall(payload)
                except Exception:
                    pass
                finally:
                    try:
                        target.shutdown(socket.SHUT_WR)
                    except Exception:
                        pass

            def target_to_client():
                try:
                    while True:
                        data = target.recv(BUFFER)
                        if not data:
                            break
                        websocket_send(client, data, 2)
                except Exception:
                    pass
                finally:
                    try:
                        client.shutdown(socket.SHUT_WR)
                    except Exception:
                        pass

            t1 = threading.Thread(target=client_to_target, daemon=True)
            t2 = threading.Thread(target=target_to_client, daemon=True)
            t1.start()
            t2.start()
            t1.join()
            t2.join()

            target.close()

        except Exception:
            try:
                client.close()
            except Exception:
                pass

class ThreadedTCPServer(ThreadingMixIn, TCPServer):
    allow_reuse_address = True
    daemon_threads = True

if __name__ == "__main__":
    with ThreadedTCPServer((LISTEN_HOST, LISTEN_PORT), WSHandler) as server:
        print("SSH SILK WebSocket listening on 0.0.0.0:80 -> 127.0.0.1:22", flush=True)
        server.serve_forever()
PYEOF

    chmod 755 "$WS_SCRIPT"
    printf '22\n' > "$WS_TARGET_FILE"
}

