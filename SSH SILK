#!/bin/bash
# =========================================================
# SSH SILK MANAGER PRO v5.0.5
# Compacto / móvil / verde + cian / 2 columnas
# Dropbear multi-puerto | WebSocket | WSS | BadVPN
# Actualización online segura | Auto inicio OFF por defecto
# =========================================================

set -o pipefail

VERSION="5.0.5"
GITHUB_URL="https://raw.githubusercontent.com/bren513/SSH-SILK/refs/heads/main/SSH%20SILK"
BIN="/usr/local/bin"
DATA="/etc/ssh-silk"
BACKUP="$DATA/backups"
MENU="$BIN/menu"
LOG="$DATA/silk.log"

C="\e[1;36m"; G="\e[1;32m"; R="\e[1;31m"; Y="\e[1;33m"; W="\e[1;37m"; D="\e[0;90m"; N="\e[0m"
mkdir -p "$DATA" "$BACKUP"
touch "$LOG"

log(){ echo "[$(date '+%F %T')] $*" >> "$LOG"; }
say(){ echo -e "$*"; }
pause(){ read -r -p "  Presiona ENTER para continuar..." _; }
die(){ say "${R}❌ $*${N}"; exit 1; }
require_root(){ [ "${EUID:-999}" -eq 0 ] || die "Ejecuta este script como root."; }
have(){ command -v "$1" >/dev/null 2>&1; }

install_deps(){
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y >/dev/null 2>&1 || true
  apt-get install -y curl wget ca-certificates openssh-client openssh-server dropbear socat stunnel4 openssl screen ufw procps iproute2 gawk lsof >/dev/null 2>&1 || true
}

save_config(){
  cat > "$DATA/config" <<EOF
AUTOSTART=${AUTOSTART:-0}
DROPBEAR_PORTS=${DROPBEAR_PORTS:-}
WS_PORTS=${WS_PORTS:-}
WSS_PORTS=${WSS_PORTS:-}
BADVPN_PORTS=${BADVPN_PORTS:-}
EOF
}

load_config(){
  AUTOSTART=0
  DROPBEAR_PORTS=""
  WS_PORTS=""
  WSS_PORTS=""
  BADVPN_PORTS=""
  if [ -f "$DATA/config" ]; then
    # Config is generated by this script; only load simple assignments.
    . "$DATA/config" 2>/dev/null || true
  fi
}

valid_port(){
  [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

valid_ports(){
  local p
  [ -n "${1:-}" ] || return 1
  for p in $1; do valid_port "$p" || return 1; done
}

tcp_listening(){
  local p="$1"
  ss -H -ltn 2>/dev/null | awk -v p=":$p" '$4 ~ p"$" || $4 ~ p" " {found=1} END{exit !found}'
}
udp_listening(){
  local p="$1"
  ss -H -lun 2>/dev/null | awk -v p=":$p" '$5 ~ p"$" || $5 ~ p" " {found=1} END{exit !found}'
}
port_owner(){
  local proto="$1" port="$2"
  if [ "$proto" = "tcp" ]; then
    ss -lntp 2>/dev/null | awk -v p=":$port" '$4 ~ p"$" || $4 ~ p" " {print; exit}'
  else
    ss -lnup 2>/dev/null | awk -v p=":$port" '$5 ~ p"$" || $5 ~ p" " {print; exit}'
  fi
}
port_free(){
  local proto="$1" port="$2"
  if [ "$proto" = "tcp" ]; then ! tcp_listening "$port"; else ! udp_listening "$port"; fi
}

open_fw(){
  local proto="$1" ports="$2" p
  for p in $ports; do ufw allow "$p/$proto" >/dev/null 2>&1 || true; done
}
close_fw(){
  local proto="$1" ports="$2" p
  for p in $ports; do ufw delete allow "$p/$proto" >/dev/null 2>&1 || true; done
}

# Stop only Silk-owned listeners on a port. Never kill sshd or unrelated services.
stop_silk_port(){
  local proto="$1" port="$2" svc
  case "$proto" in
    tcp)
      systemctl disable --now "silk-ws-$port.service" "silk-wss-$port.service" >/dev/null 2>&1 || true
      ;;
    udp)
      systemctl disable --now "silk-badvpn-$port.service" >/dev/null 2>&1 || true
      ;;
  esac
  sleep 0.3
}

install_unit(){
  local name="$1"; shift
  local exec="$*"
  cat > "/etc/systemd/system/$name.service" <<EOF
[Unit]
Description=SSH SILK $name
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$exec
Restart=on-failure
RestartSec=2
KillMode=control-group

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
}

# ---------- WebSocket ----------
make_ws(){
  local f="$DATA/ws.py"
  cat > "$f" <<'PY'
#!/usr/bin/env python3
import socket,select,sys,threading

LISTEN_HOST="0.0.0.0"
TARGET_HOST="127.0.0.1"
TARGET_PORT=int(sys.argv[2]) if len(sys.argv)>2 else 22
LISTEN_PORT=int(sys.argv[1]) if len(sys.argv)>1 else 80

def pipe(a,b):
    try:
        while True:
            r,_,_=select.select([a,b],[],[],300)
            if not r: break
            for s in r:
                data=s.recv(65535)
                if not data: return
                (b if s is a else a).sendall(data)
    except Exception:
        pass
    finally:
        for s in (a,b):
            try:s.close()
            except:pass

def client(c):
    try:
        c.settimeout(10)
        req=c.recv(8192)
        if b"upgrade: websocket" not in req.lower():
            c.close(); return
        c.sendall(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
        s=socket.create_connection((TARGET_HOST,TARGET_PORT),10)
        c.settimeout(None); s.settimeout(None)
        pipe(c,s)
    except Exception:
        try:c.close()
        except:pass

srv=socket.socket()
srv.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1)
srv.bind((LISTEN_HOST,LISTEN_PORT))
srv.listen(256)
while True:
    c,_=srv.accept()
    threading.Thread(target=client,args=(c,),daemon=True).start()
PY
  chmod 755 "$f"
}

ws_config(){
  local ports="$1" p
  for p in $ports; do
    valid_port "$p" || continue
    stop_silk_port tcp "$p"
    if ! port_free tcp "$p"; then
      say "${R}❌ TCP $p está ocupado por otro servicio.${N}"
      port_owner tcp "$p"
      continue
    fi
    install_unit "silk-ws-$p" "/usr/bin/python3 $DATA/ws.py $p 22"
    if systemctl enable --now "silk-ws-$p.service" >/dev/null 2>&1 && tcp_listening "$p"; then
      open_fw tcp "$p"
      say "${G}● WebSocket TCP $p ON${N}"
    else
      say "${R}❌ WebSocket TCP $p no pudo iniciar.${N}"
      journalctl -u "silk-ws-$p.service" -n 8 --no-pager 2>/dev/null
    fi
  done
}

ws_stop_port(){
  local p="$1"
  systemctl disable --now "silk-ws-$p.service" >/dev/null 2>&1 || true
  systemctl stop "silk-ws-$p.service" >/dev/null 2>&1 || true
  close_fw tcp "$p"
}

# ---------- WSS ----------
make_cert(){
  [ -s "$DATA/stunnel.pem" ] || openssl req -new -newkey rsa:2048 -days 825 -nodes -x509 \
    -keyout "$DATA/stunnel.pem" -out "$DATA/stunnel.pem" \
    -subj "/C=AR/ST=BA/L=Silk/O=SSH-SILK/CN=SSH-SILK" >/dev/null 2>&1
}

wss_config(){
  local ports="$1" p
  make_cert
  for p in $ports; do
    valid_port "$p" || { say "${R}❌ Puerto inválido: $p${N}"; continue; }
    stop_silk_port tcp "$p"
    if ! port_free tcp "$p"; then
      say "${R}❌ TCP $p está ocupado por otro servicio.${N}"
      port_owner tcp "$p"
      continue
    fi
    cat > "/etc/stunnel/silk-$p.conf" <<EOF
foreground = no
pid = /run/stunnel-silk-$p.pid
cert = $DATA/stunnel.pem
client = no
[silk-wss-$p]
accept = 0.0.0.0:$p
connect = 127.0.0.1:80
EOF
    install_unit "silk-wss-$p" "/usr/bin/stunnel4 /etc/stunnel/silk-$p.conf"
    if systemctl enable --now "silk-wss-$p.service" >/dev/null 2>&1 && tcp_listening "$p"; then
      open_fw tcp "$p"
      say "${G}● WSS TCP $p ON${N}"
    else
      say "${R}❌ WSS TCP $p no pudo iniciar.${N}"
      journalctl -u "silk-wss-$p.service" -n 8 --no-pager 2>/dev/null
    fi
  done
}

wss_stop_port(){
  local p="$1"
  systemctl disable --now "silk-wss-$p.service" >/dev/null 2>&1 || true
  systemctl stop "silk-wss-$p.service" >/dev/null 2>&1 || true
  rm -f "/etc/stunnel/silk-$p.conf" "/run/stunnel-silk-$p.pid"
  close_fw tcp "$p"
}

# ---------- Dropbear ----------
dropbear_config(){
  local ports="$1" p occupied=""
  [ -n "$ports" ] || { say "${Y}⚠ No se ingresaron puertos.${N}"; return 1; }
  valid_ports "$ports" || { say "${R}❌ Uno o más puertos son inválidos.${N}"; return 1; }

  for p in $ports; do
    if ! port_free tcp "$p"; then occupied="$occupied $p"; fi
  done
  [ -z "$occupied" ] || { say "${R}❌ Puertos TCP ocupados:$occupied${N}"; return 1; }

  systemctl disable --now dropbear.service dropbear.socket >/dev/null 2>&1 || true
  pkill -x dropbear >/dev/null 2>&1 || true
  mkdir -p /etc/dropbear
  dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1 || true
  dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1 || true

  local args=""
  for p in $ports; do args="$args -p 0.0.0.0:$p"; done
  install_unit "silk-dropbear" "/usr/sbin/dropbear -E -F$args"
  if systemctl enable --now silk-dropbear.service >/dev/null 2>&1 && any_tcp "$ports"; then
    open_fw tcp "$ports"
    DROPBEAR_PORTS="$ports"; save_config
    say "${G}✅ Dropbear iniciado: $ports${N}"
  else
    say "${R}❌ Dropbear no pudo iniciar.${N}"
    journalctl -u silk-dropbear.service -n 15 --no-pager 2>/dev/null
    return 1
  fi
}

dropbear_stop_port(){
  local target="$1" new="" p
  for p in $DROPBEAR_PORTS; do [ "$p" != "$target" ] && new="$new $p"; done
  new="${new# }"
  systemctl disable --now silk-dropbear.service >/dev/null 2>&1 || true
  pkill -x dropbear >/dev/null 2>&1 || true
  close_fw tcp "$target"
  if [ -n "$new" ]; then dropbear_config "$new"; else DROPBEAR_PORTS=""; save_config; fi
}

# ---------- BadVPN ----------
find_badvpn(){
  if have badvpn-udpgw; then command -v badvpn-udpgw; return 0; fi
  [ -x /usr/local/bin/badvpn-udpgw ] && { echo /usr/local/bin/badvpn-udpgw; return 0; }
  [ -x "$DATA/badvpn-udpgw" ] && { echo "$DATA/badvpn-udpgw"; return 0; }
  return 1
}

install_badvpn(){
  local out="$DATA/badvpn-udpgw"
  local url="https://raw.githubusercontent.com/abdullahrm/badvpn/master/badvpn-udpgw"
  if [ -x "$out" ] && "$out" --help >/dev/null 2>&1; then
    printf '%s\n' "$out"; return 0
  fi
  rm -f "$out"
  if curl -fsSL "$url" -o "$out" >/dev/null 2>&1 && [ -s "$out" ]; then
    chmod 755 "$out"
    if "$out" --help >/dev/null 2>&1; then
      printf '%s\n' "$out"; return 0
    fi
  fi
  rm -f "$out"
  return 1
}

badvpn_config(){
  local ports="$1" p bin
  [ -n "$ports" ] || { say "${Y}⚠ No se ingresaron puertos.${N}"; return 1; }
  valid_ports "$ports" || { say "${R}❌ Uno o más puertos son inválidos.${N}"; return 1; }

  bin="$(install_badvpn)" || {
    say "${R}❌ No se pudo obtener BadVPN/UDPGW.${N}"
    say "${D}Verifica que el VPS tenga salida HTTPS a GitHub.${N}"
    return 1
  }

  for p in $ports; do
    stop_silk_port udp "$p"
    if ! port_free udp "$p"; then
      say "${R}❌ UDP $p está ocupado por otro servicio.${N}"
      port_owner udp "$p"
      continue
    fi

    # ExecStart receives one executable path followed by separate arguments.
    install_unit "silk-badvpn-$p" "$bin --listen-addr 0.0.0.0:$p --max-clients 1000 --max-connections-for-client 10"
    if systemctl enable --now "silk-badvpn-$p.service" >/dev/null 2>&1 && udp_listening "$p"; then
      open_fw udp "$p"
      say "${G}● BadVPN UDP $p ON${N}"
    else
      say "${R}❌ BadVPN UDP $p no pudo iniciar.${N}"
      systemctl reset-failed "silk-badvpn-$p.service" >/dev/null 2>&1 || true
      journalctl -u "silk-badvpn-$p.service" -n 12 --no-pager 2>/dev/null
    fi
  done
  BADVPN_PORTS="$ports"; save_config
}

badvpn_stop_port(){
  local p="$1"
  systemctl disable --now "silk-badvpn-$p.service" >/dev/null 2>&1 || true
  systemctl stop "silk-badvpn-$p.service" >/dev/null 2>&1 || true
  close_fw udp "$p"
  local new="" x
  for x in $BADVPN_PORTS; do [ "$x" != "$p" ] && new="$new $x"; done
  BADVPN_PORTS="${new# }"; save_config
}

# ---------- statuses ----------
any_tcp(){
  local ports="${1:-}" p
  for p in $ports; do tcp_listening "$p" && return 0; done
  return 1
}
any_udp(){
  local ports="${1:-}" p
  for p in $ports; do udp_listening "$p" && return 0; done
  return 1
}
status_dropbear(){ any_tcp "$DROPBEAR_PORTS"; }
status_ws(){ any_tcp "$WS_PORTS"; }
status_wss(){ any_tcp "$WSS_PORTS"; }
status_badvpn(){ any_udp "$BADVPN_PORTS"; }

# ---------- panel ----------
bar(){
  local pct="${1:-0}" n out="" i
  [[ "$pct" =~ ^[0-9]+$ ]] || pct=0
  [ "$pct" -gt 100 ] && pct=100
  [ "$pct" -lt 0 ] && pct=0
  n=$((pct/10))
  for ((i=0;i<10;i++)); do [ "$i" -lt "$n" ] && out+="█" || out+="·"; done
  printf "%s %3d%%" "$out" "$pct"
}
term_width(){ tput cols 2>/dev/null || echo 80; }

header(){
  clear
  local w line title="⚡ SSH SILK MANAGER PRO v$VERSION ⚡"
  w="$(term_width)"; [ "$w" -gt 62 ] && w=62; [ "$w" -lt 40 ] && w=40
  line="$(printf '%*s' "$w" '' | tr ' ' '═')"
  say "${C}╔$line╗${N}"
  printf "${C}║${N} %-*s ${C}║${N}\n" $((w-2)) "$title"
  say "${C}╚$line╝${N}"
}

opt(){
  local n="$1" text="$2"
  printf "${C}[%02d]${N} ${Y}%-28s${N}" "$n" "$text"
}

dashboard(){
  load_config
  local mem cpu disk total online expired os
  mem="$(free 2>/dev/null | awk '/Mem:/ {if($2>0) printf "%d",($3/$2)*100}')" ; mem="${mem:-0}"
  cpu="$(top -bn1 2>/dev/null | awk -F'[, ]+' '/Cpu\(s\)/ {for(i=1;i<=NF;i++) if($i=="id"){print int(100-$(i-1));exit}}')" ; cpu="${cpu:-0}"
  disk="$(df / 2>/dev/null | awk 'NR==2{gsub(/%/,"",$5);print $5}')" ; disk="${disk:-0}"
  total="$(awk -F: '$3>=1000 && $1!="nobody"{c++} END{print c+0}' /etc/passwd)"
  online="$(who 2>/dev/null | wc -l)"
  expired=0
  os="$(awk -F= '/^PRETTY_NAME=/{gsub(/"/,"",$2);print $2}' /etc/os-release 2>/dev/null | cut -c1-25)"
  header

  printf "${C}SISTEMA${N}                 ${C}MEMORIA RAM${N}              ${C}PROCESADOR${N}\n"
  printf "${G}OS:${N} %-23s ${G}RAM:${N} %s ${G}CPU:${N} %s\n" "$os" "$(bar "$mem")" "$(bar "$cpu")"
  printf "${G}UP:${N} %-23s ${G}DISCO:${N} %s ${G}CORES:${N} %s\n" "$(uptime -p 2>/dev/null | sed 's/^up //')" "$(bar "$disk")" "$(nproc)"
  say "${C}──────────────────────────────────────────────────────────────${N}"
  say " ${G}● ONLINE:${W} $online   ${R}● EXPIRADOS:${W} $expired   ${Y}● TOTAL:${W} $total${N}"
  say "${C}──────────────────────────────────────────────────────────────${N}"
  say "${C}PROTOCOLOS ACTIVOS${N}"
  printf " ${G}● SSH:${W}22${N} "; status_dropbear && say "${G}ON${N}" || say "${R}OFF${N}"
  printf " ${G}● DROPBEAR:${W}%s${N} " "${DROPBEAR_PORTS:-—}"; status_dropbear && say "${G}ON${N}" || say "${R}OFF${N}"
  printf " ${G}● WEBSOCKET:${W}%s${N} " "${WS_PORTS:-—}"; status_ws && say "${G}ON${N}" || say "${R}OFF${N}"
  printf " ${G}● WSS:${W}%s${N} " "${WSS_PORTS:-—}"; status_wss && say "${G}ON${N}" || say "${R}OFF${N}"
  printf " ${G}● BADVPN:${W}%s${N} " "${BADVPN_PORTS:-—}"; status_badvpn && say "${G}ON${N}" || say "${R}OFF${N}"
  say "${C}──────────────────────────────────────────────────────────────${N}"
  say "${C}┌────────────────────────────┬─────────────────────────────┐${N}"
  say "${C}│${N}        ${Y}ADMINISTRACIÓN${N}       ${C}│${N}        ${Y}CONFIGURACIÓN${N}        ${C}│${N}"
  printf "${C}│${N} "; opt 1 "Crear usuario"; printf " ${C}│${N} "; opt 6 "WebSocket HTTP"; say " ${C}│${N}"
  printf "${C}│${N} "; opt 2 "Usuario prueba"; printf " ${C}│${N} "; opt 7 "WebSocket Security"; say " ${C}│${N}"
  printf "${C}│${N} "; opt 3 "Usuarios online"; printf " ${C}│${N} "; opt 8 "BadVPN multi-puerto"; say " ${C}│${N}"
  printf "${C}│${N} "; opt 4 "Lista usuarios"; printf " ${C}│${N} "; opt 9 "Diagnóstico"; say " ${C}│${N}"
  printf "${C}│${N} "; opt 5 "Eliminar usuario"; printf " ${C}│${N} "; opt 10 "Info de sistema"; say " ${C}│${N}"
  printf "${C}│${N} %-30s ${C}│${N} "; opt 11 "Actualizar online"; say " ${C}│${N}"
  printf "${C}│${N} %-30s ${C}│${N} "; opt 12 "Dropbear multi-puerto"; say " ${C}│${N}"
  printf "${C}│${N} %-30s ${C}│${N} "; opt 13 "Detener puertos"; say " ${C}│${N}"
  local a="OFF"; [ "${AUTOSTART:-0}" = 1 ] && a="ON"
  printf "${C}│${N} %-30s ${C}│${N} "; opt 14 "Auto iniciar [$a]"; say " ${C}│${N}"
  say "${C}└────────────────────────────┴─────────────────────────────┘${N}"
  say " ${C}[00]${N} ${Y}Salir${N}"
}

# ---------- user management ----------
create_user(){
  header; say "${C}CREAR USUARIO SSH${N}"
  local u p d
  read -r -p " Usuario: " u
  if [[ ! "$u" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
    say "${R}❌ Nombre inválido. Usa letras minúsculas, números, _ o - (máx. 32).${N}"; pause; return
  fi
  read -r -s -p " Contraseña: " p; echo
  [ -n "$p" ] || { say "${R}❌ La contraseña no puede estar vacía.${N}"; pause; return; }
  read -r -p " Días: " d
  [[ "$d" =~ ^[0-9]+$ ]] || { say "${R}❌ Días inválidos.${N}"; pause; return; }
  if id "$u" >/dev/null 2>&1; then say "${R}❌ Usuario existente.${N}"; pause; return; fi
  if useradd -M -s /bin/false -e "$(date -d "+$d days" +%F)" "$u" && echo "$u:$p" | chpasswd; then
    say "${G}✅ Usuario creado.${N}"
  else
    say "${R}❌ No se pudo crear el usuario.${N}"
  fi
  pause
}
create_test(){
  local u="silk$(date +%s | tail -c 6)"
  useradd -M -s /bin/false -e "$(date -d '+1 day' +%F)" "$u" && echo "$u:1234" | chpasswd
  header; say "${G}✅ TEST CREADO${N}"; say " Usuario: ${C}$u${N}"; say " Pass: ${W}1234${N}"; pause
}
list_users(){ header; say "${C}USUARIOS${N}"; awk -F: '$3>=1000 && $1!="nobody"{print " ● "$1}' /etc/passwd; pause; }
delete_user(){ header; read -r -p " Usuario a eliminar: " u; id "$u" >/dev/null 2>&1 && userdel -f "$u" && say "${G}✅ Eliminado.${N}" || say "${R}❌ No existe.${N}"; pause; }
online_users(){ header; who; pause; }

ws_menu(){
  header; say "${C}WEBSOCKET HTTP${N}"
  read -r -p " Puertos TCP (ej: 80 8080): " p
  valid_ports "$p" || { say "${R}❌ Puertos inválidos.${N}"; pause; return; }
  make_ws; ws_config "$p"
  WS_PORTS="$p"; save_config
  pause
}
wss_menu(){
  header; say "${C}WEBSOCKET SECURITY${N}"
  read -r -p " Puertos SSL (ej: 443 8443): " p
  valid_ports "$p" || { say "${R}❌ Puertos inválidos.${N}"; pause; return; }
  wss_config "$p"; WSS_PORTS="$p"; save_config; pause
}
badvpn_menu(){
  header; say "${C}BADVPN UDP MULTI-PUERTO${N}"
  read -r -p " Puertos UDP (ej: 7300 7301 7302): " p
  badvpn_config "$p"; pause
}
dropbear_menu(){
  header; say "${C}DROPBEAR TCP MULTI-PUERTO${N}"
  read -r -p " Puertos (ej: 2222 2200 8080): " p
  dropbear_config "$p"; pause
}

stop_menu(){
  header; say "${C}DETENER PUERTOS${N}"
  say " ${C}[1]${N} ${Y}Dropbear${N}   ${C}[2]${N} ${Y}WebSocket${N}   ${C}[3]${N} ${Y}WSS${N}"
  say " ${C}[4]${N} ${Y}BadVPN${N}      ${C}[5]${N} ${Y}TODO SILK${N}"
  read -r -p " Selecciona: " op
  local p x
  case "$op" in
    1) read -r -p " Puerto Dropbear: " p; dropbear_stop_port "$p";;
    2) read -r -p " Puerto WS: " p; ws_stop_port "$p"; WS_PORTS="$(echo "$WS_PORTS" | xargs -n1 | grep -vx "$p" | xargs 2>/dev/null || true)"; save_config;;
    3) read -r -p " Puerto WSS: " p; wss_stop_port "$p"; WSS_PORTS="$(echo "$WSS_PORTS" | xargs -n1 | grep -vx "$p" | xargs 2>/dev/null || true)"; save_config;;
    4) read -r -p " Puerto BadVPN: " p; badvpn_stop_port "$p";;
    5)
      for x in $WS_PORTS; do ws_stop_port "$x"; done
      for x in $WSS_PORTS; do wss_stop_port "$x"; done
      for x in $BADVPN_PORTS; do badvpn_stop_port "$x"; done
      systemctl disable --now silk-dropbear.service >/dev/null 2>&1 || true
      pkill -x dropbear >/dev/null 2>&1 || true
      close_fw tcp "$DROPBEAR_PORTS"
      DROPBEAR_PORTS=""; WS_PORTS=""; WSS_PORTS=""; BADVPN_PORTS=""; save_config
      say "${G}✅ Protocolos SILK detenidos y configuraciones limpiadas.${N}"
      ;;
    *) say "${R}❌ Opción inválida.${N}";;
  esac
  pause
}

diagnostic(){
  header; say "${C}DIAGNÓSTICO${N}"
  say "${W}TCP:${N}"; ss -lntp 2>/dev/null | sed -n '1,35p'
  say "${W}UDP:${N}"; ss -lnup 2>/dev/null | sed -n '1,35p'
  say "${W}SERVICIOS SILK:${N}"; systemctl list-units --all --type=service 'silk-*' --no-pager 2>/dev/null || true
  pause
}

system_info(){
  header
  local mem_used mem_total cpu disk ip
  mem_used="$(free -h | awk '/Mem:/ {print $3}')"
  mem_total="$(free -h | awk '/Mem:/ {print $2}')"
  cpu="$(top -bn1 2>/dev/null | awk -F'[, ]+' '/Cpu\(s\)/ {for(i=1;i<=NF;i++) if($i=="id"){print int(100-$(i-1));exit}}')"; cpu="${cpu:-0}"
  disk="$(df -h / | awk 'NR==2{print $3 "/" $2 " (" $5 ")"}')"
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  say "${C}╔════════════ INFORMACIÓN DEL SISTEMA ════════════╗${N}"
  say " ${Y}OS${N}       : $(awk -F= '/^PRETTY_NAME=/{gsub(/"/,"",$2);print $2}' /etc/os-release)"
  say " ${Y}Kernel${N}   : $(uname -r)"
  say " ${Y}Arquitectura${N}: $(uname -m)"
  say " ${Y}IP${N}       : ${ip:-—}"
  say " ${Y}Uptime${N}   : $(uptime -p)"
  say " ${Y}CPU${N}      : ${cpu}% / $(nproc) cores"
  say " ${Y}RAM${N}      : ${mem_used:-0} / ${mem_total:-0}"
  say " ${Y}DISCO /${N}  : ${disk:-—}"
  say "${C}──────────────────────────────────────────────────${N}"
  say "${C}PUERTOS TCP ESCUCHANDO${N}"
  ss -lntp 2>/dev/null | sed -n '1,35p'
  say "${C}PUERTOS UDP ESCUCHANDO${N}"
  ss -lnup 2>/dev/null | sed -n '1,35p'
  say "${C}FIREWALL UFW${N}"
  ufw status 2>/dev/null | head -n 25
  pause
}

update_online(){
  header; say "${C}ACTUALIZACIÓN ONLINE${N}"
  local tmp remote_ver current_ver
  tmp="$(mktemp)"
  if ! curl -fsSL --connect-timeout 10 --max-time 60 -H 'Cache-Control: no-cache' "${GITHUB_URL}?v=$(date +%s)" -o "$tmp"; then
    rm -f "$tmp"; say "${R}❌ No se pudo descargar desde GitHub.${N}"; pause; return
  fi
  [ -s "$tmp" ] || { rm -f "$tmp"; say "${R}❌ Archivo vacío.${N}"; pause; return; }
  head -n1 "$tmp" | grep -q '^#!/bin/bash' || { rm -f "$tmp"; say "${R}❌ Archivo remoto no válido.${N}"; pause; return; }
  bash -n "$tmp" || { rm -f "$tmp"; say "${R}❌ La versión remota tiene errores de sintaxis.${N}"; pause; return; }
  remote_ver="$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2)"
  current_ver="$VERSION"
  [ -n "$remote_ver" ] || { rm -f "$tmp"; say "${R}❌ No se encontró VERSION.${N}"; pause; return; }
  say " Versión actual : ${Y}$current_ver${N}"
  say " Versión GitHub : ${G}$remote_ver${N}"
  if [ "$remote_ver" = "$current_ver" ]; then
    rm -f "$tmp"; say "${G}✅ Ya tienes la versión más reciente.${N}"; pause; return
  fi
  if ! printf '%s\n%s\n' "$current_ver" "$remote_ver" | sort -V -C; then
    # remote is older: do not downgrade
    if [ "$(printf '%s\n%s' "$current_ver" "$remote_ver" | sort -V | tail -n1)" = "$current_ver" ]; then
      rm -f "$tmp"; say "${Y}⚠ GitHub tiene una versión igual o anterior. No se hará downgrade.${N}"; pause; return
    fi
  fi
  cp "$MENU" "$BACKUP/menu-$current_ver-$(date +%s)" 2>/dev/null || true
  install -m 755 "$tmp" "$MENU"
  rm -f "$tmp"
  say "${G}✅ Actualización instalada: v$remote_ver${N}"
  exec "$MENU"
}

toggle_autostart(){
  header
  if [ "${AUTOSTART:-0}" = 1 ]; then
    AUTOSTART=0
    sed -i '/# SSH-SILK-AUTOSTART/,/# SSH-SILK-AUTOSTART-END/d' /root/.bashrc 2>/dev/null || true
    save_config; say "${R}● Auto iniciar: OFF${N}"
  else
    AUTOSTART=1
    sed -i '/# SSH-SILK-AUTOSTART/,/# SSH-SILK-AUTOSTART-END/d' /root/.bashrc 2>/dev/null || true
    cat >> /root/.bashrc <<'EOF'
# SSH-SILK-AUTOSTART
if [ -n "$SSH_CONNECTION" ] && [[ "$-" == *i* ]] && [ "${SILK_AUTOSTART_RUNNING:-0}" != "1" ] && [ -x /usr/local/bin/menu ]; then
  export SILK_AUTOSTART_RUNNING=1
  /usr/local/bin/menu
  return
fi
# SSH-SILK-AUTOSTART-END
EOF
    save_config; say "${G}● Auto iniciar: ON${N}"
  fi
  pause
}

install_self(){
  local src="${1:-}" tmp
  tmp="$(mktemp)"
  if [ -n "$src" ] && [ -f "$src" ]; then cp "$src" "$tmp"; else curl -fsSL --connect-timeout 10 --max-time 60 "$GITHUB_URL" -o "$tmp" || { rm -f "$tmp"; return 1; }; fi
  head -n1 "$tmp" | grep -q '^#!/bin/bash' || { rm -f "$tmp"; return 1; }
  bash -n "$tmp" || { rm -f "$tmp"; return 1; }
  grep -q 'SSH SILK MANAGER PRO' "$tmp" || { rm -f "$tmp"; return 1; }
  [ -f "$MENU" ] && cp "$MENU" "$BACKUP/menu-preinstall-$(date +%s)" || true
  install -m 755 "$tmp" "$MENU"
  rm -f "$tmp"
  echo "$MENU"
}

main(){
  require_root
  mkdir -p "$DATA" "$BACKUP"
  load_config
  if [ ! -f "$MENU" ] || ! bash -n "$MENU" >/dev/null 2>&1; then
    install_self "${BASH_SOURCE[0]:-}" >/dev/null 2>&1 || true
  fi
  while true; do
    dashboard
    read -r -p " 👉 Selecciona una opción: " op
    case "$op" in
      1) create_user;;
      2) create_test;;
      3) online_users;;
      4) list_users;;
      5) delete_user;;
      6) ws_menu;;
      7) wss_menu;;
      8) badvpn_menu;;
      9) diagnostic;;
      10) system_info;;
      11) update_online;;
      12) dropbear_menu;;
      13) stop_menu;;
      14) toggle_autostart;;
      0|00) clear; exit 0;;
      *) say "${R}❌ Opción inválida.${N}"; sleep 1;;
    esac
  done
}
main "$@"
