 for p in $ports;do if port_listening udp "$p"&& ! systemctl is-active --quiet "silk-badvpn@$p.service";then err "UDP $p está ocupado.";continue;fi;systemctl enable --now "silk-badvpn@$p.service" >/dev/null 2>&1&& { fw_udp_add "$p";port_listening udp "$p"&& ok "BadVPN activo en UDP $p"|| err "BadVPN $p no escucha.";}|| { err "Falló BadVPN $p";journalctl -u "silk-badvpn@$p.service" -n 8 --no-pager 2>/dev/null;};done;pause
}
badvpn_stop(){ 
 clear;header "DETENER BADVPN";local cur p raw ports;cur=$(badvpn_active|| true);[[ -n "$cur" ]]|| { warn "No hay BadVPN activos.";pause;return;};echo "Activos: $cur";read -r -p "Puertos a detener o ALL: " raw;if [[ ${raw^^} == ALL ]];then for p in $cur;do systemctl disable --now "silk-badvpn@$p.service" >/dev/null 2>&1|| true;fw_udp_del "$p";done;else ports=$(ports_normalize "$raw");for p in $ports;do systemctl disable --now "silk-badvpn@$p.service" >/dev/null 2>&1|| true;fw_udp_del "$p";done;fi;ok "Operación completada.";pause
}

# ---------- Users ----------
create_user(){ clear;header 'CREAR USUARIO SSH';local u p days exp;read -r -p 'Usuario: ' u;[[ "$u" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]|| { err 'Nombre inválido.';pause;return;};id "$u" >/dev/null 2>&1&& { err 'El usuario ya existe.';pause;return;};read -r -s -p 'Contraseña: ' p;echo;read -r -p 'Días: ' days;[[ "$days" =~ ^[0-9]+$ ]]|| { err 'Días inválidos.';pause;return;};exp=$(date -d "+$days days" +%Y-%m-%d);useradd -M -s /usr/sbin/nologin -e "$exp" "$u"&&echo "$u:$p"|chpasswd&& ok "Usuario $u creado hasta $exp"|| err 'No se pudo crear';pause;}
create_test(){ clear;header 'USUARIO DE PRUEBA';local u="silk$(date +%s|tail -c5)";useradd -M -s /usr/sbin/nologin -e "$(date -d '+1 day' +%Y-%m-%d)" "$u"&&echo "$u:1234"|chpasswd&& { ok "Usuario: $u";ok 'Contraseña: 1234';}|| err 'No se pudo crear';pause;}
remove_user(){ clear;header 'ELIMINAR USUARIO';local u;read -r -p 'Usuario: ' u;if id "$u" >/dev/null 2>&1;then userdel -f "$u"&& ok 'Eliminado.'|| err 'Falló.';else err 'No existe.';fi;pause;}
renew_user(){ clear;header 'RENOVAR USUARIO';local u d e;read -r -p 'Usuario: ' u;id "$u" >/dev/null 2>&1|| { err 'No existe.';pause;return;};read -r -p 'Días: ' d;[[ "$d" =~ ^[0-9]+$ ]]|| { err 'Días inválidos.';pause;return;};e=$(date -d "+$d days" +%Y-%m-%d);chage -E "$e" "$u"&& ok "Renovado hasta $e"|| err 'Falló.';pause;}
list_users(){ clear;header 'USUARIOS SSH';printf '%-24s %-18s\n' USUARIO EXPIRA;echo '------------------------------------------';awk -F: '$3>=1000&&$1!="nobody"{ print $1}' /etc/passwd|while read -r u;do e=$(chage -l "$u" 2>/dev/null|awk -F': ' '/Account expires/{ print $2}');printf '%-24s %-18s\n' "$u" "${e:-N/A}";done;pause;}

# ---------- System info / diagnostics ----------
system_info(){ 
 clear;header 'INFORMACIÓN DEL SISTEMA';local rp dp;rp=$(ram_pct);dp=$(disk_pct)
 echo -e "${CYAN}┌──────────────── SISTEMA ────────────────┐${RESET}";printf ' OS       : %s\n Kernel   : %s\n Arch     : %s\n IP       : %s\n Uptime   : %s\n' "$(os_name)" "$(uname -r)" "$(uname -m)" "$(hostname -I|awk '{ print $1}')" "$(uptime -p 2>/dev/null)"
 echo -e "${CYAN}├──────────────── CPU ────────────────────┤${RESET}";printf ' Cores    : %s\n Uso      : %s%% %s\n Load     : %s\n' "$(nproc)" "$(cpu_pct)" "$(bar "$(cpu_pct)")" "$(cut -d' ' -f1-3 /proc/loadavg)"
 echo -e "${CYAN}├──────────────── RAM ────────────────────┤${RESET}";printf ' Uso      : %s%% %s\n Memoria  : %s / %s\n' "$rp" "$(bar "$rp")" "$(free -h|awk '/Mem:/{ print $3}')" "$(free -h|awk '/Mem:/{ print $2}')"
 echo -e "${CYAN}├──────────────── DISCO / ────────────────┤${RESET}";printf ' Uso      : %s%% %s\n Espacio  : %s\n' "$dp" "$(bar "$dp")" "$(disk_text)"
 echo -e "${CYAN}├──────────── PUERTOS ESCUCHANDO ────────┤${RESET}";ss -lntup 2>/dev/null|tail -n +2
 echo -e "${CYAN}├──────────────── UFW ────────────────────┤${RESET}";has ufw&&ufw status 2>/dev/null|head -n 15||echo 'UFW no disponible'
 echo -e "${CYAN}└─────────────────────────────────────────┘${RESET}";pause
}
diagnostic(){ clear;header 'DIAGNÓSTICO DE PUERTOS';echo "Dropbear : $(dropbear_active|tr '\n' ' ')";echo "WebSocket: $(ws_active|tr '\n' ' ')";echo "WSS      : $(wss_active|tr '\n' ' ')";echo "BadVPN   : $(badvpn_active|tr '\n' ' ')";echo;ss -lntup 2>/dev/null;echo;echo 'Últimos errores SILK:';journalctl -u 'silk-*' -n 30 --no-pager 2>/dev/null|| true;pause;}

# ---------- Panel ----------
header(){ clear;echo -e "${BLUE}╔══════════════════════════════════════════════════════════╗${RESET}";printf "${BLUE}║${RESET} ${WHITE}⚡ SSH SILK MANAGER PRO v%-28s${RESET}${BLUE}║${RESET}\n" "$VERSION";printf "${BLUE}║${RESET} ${CYAN}%-54s${RESET}${BLUE}║${RESET}\n" "$1";echo -e "${BLUE}╚══════════════════════════════════════════════════════════╝${RESET}";}
stop_ports(){ clear;header 'DETENER PUERTOS';echo '[1] Dropbear';echo '[2] WebSocket HTTP';echo '[3] WebSocket Security / WSS';echo '[4] BadVPN / UDPGW';echo '[0] Volver';read -r -p 'Selecciona: ' x;case "$x" in 1)dropbear_stop;;2)ws_stop;;3)wss_stop;;4)badvpn_stop;;esac;}
main_panel(){ 
 local rp=$(ram_pct) cp=$(cpu_pct) db ws wss bp total exp online;db=$(dropbear_active|tr '\n' ' ');ws=$(ws_active|tr '\n' ' ');wss=$(wss_active|tr '\n' ' ');bp=$(badvpn_active|tr '\n' ' ');[[ -n "$db" ]]||db='-';[[ -n "$ws" ]]||ws='-';[[ -n "$wss" ]]||wss='-';[[ -n "$bp" ]]||bp='-';online=$(who|wc -l|tr -d ' ');total=$(awk -F: '$3>=1000&&$1!="nobody"{ c++}END{ print c+0}' /etc/passwd);exp=0
 local u e;while read -r u;do e=$(chage -l "$u" 2>/dev/null|awk -F': ' '/Account expires/{ print $2}');if [[ -n "$e"&&"$e" != never ]]&&[[ $(date -d "$e" +%s 2>/dev/null||echo 0) -lt $(date +%s) ]];then ((exp++));fi;done< <(awk -F: '$3>=1000&&$1!="nobody"{ print $1}' /etc/passwd)
 clear;echo -e "${BLUE}╔══════════════════════════════════════════════════════════╗${RESET}";printf "${BLUE}║${RESET} ${WHITE}⚡ SSH SILK MANAGER PRO v${VERSION}${RESET}                     ${BLUE}║${RESET}\n";echo -e "${BLUE}╠══════════════════════════════════════════════════════════╣${RESET}";echo -e "${CYAN}║  SISTEMA                 MEMORIA RAM          PROCESADOR ║${RESET}";printf "${BLUE}║${RESET} OS: %-19s RAM: %-9s Uso: %-3s%% Cores: %-3s Uso: %-3s%% ${BLUE}║${RESET}\n" "$(os_name|cut -c1-19)" "$(free -h|awk '/Mem:/{ print $2}')" "$rp" "$(nproc)" "$cp";printf "${BLUE}║${RESET} Hora: %-17s CPU %s %-5s%% Disco %-4s%%                 ${BLUE}║${RESET}\n" "$(date +%H:%M:%S)" "$(bar "$cp")" "$cp" "$(disk_pct)";echo -e "${BLUE}╠══════════════════════════════════════════════════════════╣${RESET}";printf "${BLUE}║${RESET} ${GREEN}● Online: %-4s${RESET}  ${RED}● Expirados: %-4s${RESET}  ${YELLOW}● Total: %-4s${RESET}              ${BLUE}║${RESET}\n" "$online" "$exp" "$total";echo -e "${BLUE}╠══════════════════════════════════════════════════════════╣${RESET}";echo -e "${CYAN}║  PROTOCOLOS ACTIVOS                                     ║${RESET}";printf "${BLUE}║${RESET} OpenSSH: %-3s  Dropbear: %-15s WebSocket: %-13s ${BLUE}║${RESET}\n" "$(port_listening tcp 22&&echo ON||echo OFF)" "$db" "$ws";printf "${BLUE}║${RESET} WSS: %-6s  BadVPN: %-17s UFW: %-6s                 ${BLUE}║${RESET}\n" "$wss" "$bp" "$(ufw status 2>/dev/null|head -1|awk '{ print $2}')";echo -e "${BLUE}╠══════════════════════════════════════════════════════════╣${RESET}";echo -e "${MAGENTA}║  ADMINISTRACIÓN                    CONFIGURACIONES       ║${RESET}";echo -e "${BLUE}║${RESET} [01] Crear usuario               [06] WebSocket HTTP  ║";echo -e "${BLUE}║${RESET} [02] Usuario prueba              [07] WebSocket WSS   ║";echo -e "${BLUE}║${RESET} [03] Eliminar usuario            [08] BadVPN multi    ║";echo -e "${BLUE}║${RESET} [04] Renovar usuario             [09] Diagnóstico     ║";echo -e "${BLUE}║${RESET} [05] Lista de usuarios           [10] Info sistema    ║";echo -e "${BLUE}║${RESET}                                  [11] Actualizar online║";echo -e "${BLUE}║${RESET}                                  [12] Dropbear multi   ║";echo -e "${BLUE}║${RESET}                                  [13] Detener puertos ║";echo -e "${BLUE}║${RESET}                                  [14] Salir            ║";echo -e "${BLUE}╚══════════════════════════════════════════════════════════╝${RESET}";echo;read -r -p '👉 Selecciona una opción: ' opt;case "$opt" in 1|01)create_user;;2|02)create_test;;3|03)remove_user;;4|04)renew_user;;5|05)list_users;;6|06)ws_add;;7|07)wss_add;;8|08)badvpn_add;;9|09)diagnostic;;10)system_info;;11)remote_update;;12)dropbear_add;;13)stop_ports;;14|0|00)clear;exit 0;;*)err 'Opción inválida.';sleep 1;;esac; }

