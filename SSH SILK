#!/bin/bash
# ============================================================
# SSH SILK MANAGER v5.0.0
# Dropbear Multi-Puerto / WebSocket / WSS / BadVPN
# Ubuntu 20.04/22.04/24.04 - Debian 11/12+
# ============================================================

set -o pipefail

VERSION="5.0.0"
GITHUB_RAW="https://raw.githubusercontent.com/bren513/SSH-SILK/refs/heads/main/SSH%20SILK"
BASE="/etc/silk"
BIN="/usr/local/bin"
SYSTEMD="/etc/systemd/system"

DROPBEAR_PORTS_FILE="$BASE/dropbear.ports"
BADVPN_PORTS_FILE="$BASE/badvpn.ports"
WS_PORT_FILE="$BASE/ws.port"
WSS_PORT_FILE="$BASE/wss.port"
WS_SCRIPT="$BASE/websocket.py"
BADVPN_BIN="$BIN/badvpn-udpgw"

VERDE="\e[1;32m"; ROJO="\e[1;31m"; AZUL="\e[1;34m"
CIAN="\e[1;36m"; AMARILLO="\e[1;33m"; MAGENTA="\e[1;35m"
BLANCO="\e[1;37m"; GRIS="\e[0;37m"; FIN="\e[0m"

[[ $EUID -eq 0 ]] || { echo -e "${ROJO}❌ Ejecuta como root.${FIN}"; exit 1; }

mkdir -p "$BASE"

pausa() { read -r -p "Presiona Enter para continuar..."; }

validar_puerto() { [[ "$1" =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535)); }

normalizar_lista() {
    tr ',;' '  ' <<< "$1" | tr -s '[:space:]' '\n' | sed '/^$/d' | sort -n -u | tr '\n' ' ' | sed 's/[[:space:]]*$//'
}

validar_lista_puertos() {
    local p
    [[ -n "$1" ]] || return 1
    for p in $1; do
        validar_puerto "$p" || { echo -e "${ROJO}❌ Puerto inválido: $p${FIN}"; return 1; }
    done
}

tcp_listening() {
    ss -H -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${1}$|\\]:${1}$"
}

udp_listening() {
    ss -H -lnu 2>/dev/null | awk '{print $5}' | grep -Eq "(^|:)${1}$|\\]:${1}$"
}

port_owner() {
    ss -H -lntup 2>/dev/null | awk -v p="$1" '$5 ~ (":" p "$") || $5 ~ ("\\]:" p "$") {print $NF}' | head -1
}

fw_tcp_open() { command -v ufw >/dev/null 2>&1 && for p in "$@"; do ufw allow "$p/tcp" >/dev/null 2>&1 || true; done; }
fw_udp_open() { command -v ufw >/dev/null 2>&1 && for p in "$@"; do ufw allow "$p/udp" >/dev/null 2>&1 || true; done; }
fw_tcp_close() { command -v ufw >/dev/null 2>&1 && for p in "$@"; do ufw delete allow "$p/tcp" >/dev/null 2>&1 || true; done; }
fw_udp_close() { command -v ufw >/dev/null 2>&1 && for p in "$@"; do ufw delete allow "$p/udp" >/dev/null 2>&1 || true; done; }

puertos_tcp_ui() {
    local p
    for p in $1; do
        if tcp_listening "$p"; then
            echo -e "  ${VERDE}●${FIN} $p/tcp  ${VERDE}ON${FIN}"
        else
            echo -e "  ${ROJO}●${FIN} $p/tcp  ${ROJO}OFF${FIN}"
        fi
    done
}
puertos_udp_ui() {
    local p
    for p in $1; do
        if udp_listening "$p"; then
            echo -e "  ${VERDE}●${FIN} $p/udp  ${VERDE}ON${FIN}"
        else
            echo -e "  ${ROJO}●${FIN} $p/udp  ${ROJO}OFF${FIN}"
        fi
    done
}

instalar_dependencias() {
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y >/dev/null 2>&1 || true
    apt-get install -y lsb-release ufw iproute2 procps gawk curl wget openssl python3 dropbear stunnel4 git cmake build-essential >/dev/null 2>&1
    command -v ss >/dev/null 2>&1 || { echo -e "${ROJO}❌ Falta iproute2/ss.${FIN}"; return 1; }
    command -v dropbear >/dev/null 2>&1 || { echo -e "${ROJO}❌ No se pudo instalar Dropbear.${FIN}"; return 1; }
}

# ---------------------- WEBSOCKET ----------------------

crear_websocket_python() {
    cat > "$WS_SCRIPT" <<'PY'
#!/usr/bin/env python3
import base64, hashlib, os, select, socket, struct, sys, threading

LISTEN_HOST = "0.0.0.0"
LISTEN_PORT = int(os.environ.get("SILK_WS_PORT", "80"))
SSH_HOST = os.environ.get("SILK_SSH_HOST", "127.0.0.1")
SSH_PORT = int(os.environ.get("SILK_SSH_PORT", "22"))

def recv_headers(conn):
    data = b""
    while b"\r\n\r\n" not in data and len(data) < 16384:
        chunk = conn.recv(4096)
        if not chunk: return b""
        data += chunk
    return data

def tunnel(a, b):
    sockets = [a, b]
    try:
        while True:
            r, _, _ = select.select(sockets, [], [], 300)
            if not r: break
            for s in r:
                other = b if s is a else a
                data = s.recv(65535)
                if not data: return
                other.sendall(data)
    except Exception:
        pass
    finally:
        for s in sockets:
            try: s.shutdown(socket.SHUT_RDWR)
            except Exception: pass
            try: s.close()
            except Exception: pass

def websocket_accept(client):
    req = recv_headers(client)
    if not req: return
    try:
        text = req.decode("latin1", "ignore")
        lines = text.split("\r\n")
        if not lines or not lines[0].startswith(("GET ", "POST ", "CONNECT ")):
            client.close(); return
        headers = {}
        for line in lines[1:]:
            if ":" in line:
                k, v = line.split(":", 1)
                headers[k.strip().lower()] = v.strip()
        key = headers.get("sec-websocket-key")
        if not key:
            client.sendall(b"HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n")
            client.close(); return
        accept = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
        client.sendall(("HTTP/1.1 101 Switching Protocols\r\n"
                        "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Accept: {accept}\r\n\r\n").encode())
        ssh = socket.create_connection((SSH_HOST, SSH_PORT), timeout=10)
        # WebSocket frame -> raw SSH. Raw SSH -> binary WebSocket frames.
        def ws_to_ssh():
            try:
                while True:
                    h = client.recv(2)
                    if len(h) < 2: break
                    b1, b2 = h
                    masked = b2 & 0x80
                    ln = b2 & 0x7f
                    if ln == 126: ln = struct.unpack("!H", client.recv(2))[0]
                    elif ln == 127: ln = struct.unpack("!Q", client.recv(8))[0]
                    mask = client.recv(4) if masked else b""
                    payload = bytearray()
                    while len(payload) < ln:
                        chunk = client.recv(min(65535, ln-len(payload)))
                        if not chunk: return
                        payload.extend(chunk)
                    if masked:
                        for i in range(ln): payload[i] ^= mask[i % 4]
                    opcode = b1 & 0x0f
                    if opcode == 0x8: return
                    if opcode == 0x9:
                        client.sendall(b"\x8a" + bytes([len(payload)]) + payload)
                        continue
                    if opcode in (1, 2, 0): ssh.sendall(payload)
            except Exception: pass
            finally:
                try: ssh.shutdown(socket.SHUT_RDWR)
                except Exception: pass
        def ssh_to_ws():
            try:
                while True:
                    data = ssh.recv(65535)
                    if not data: break
                    frame = b"\x82"
                    if len(data) < 126: frame += bytes([len(data)])
                    elif len(data) <= 65535: frame += b"\x7e" + struct.pack("!H", len(data))
                    else: frame += b"\x7f" + struct.pack("!Q", len(data))
                    client.sendall(frame + data)
            except Exception: pass
        t = threading.Thread(target=ws_to_ssh, daemon=True); t.start()
        ssh_to_ws()
    except Exception:
        pass
    finally:
        try: client.close()
        except Exception: pass

def main():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind((LISTEN_HOST, LISTEN_PORT))
    s.listen(256)
    while True:
        c, _ = s.accept()
        threading.Thread(target=websocket_accept, args=(c,), daemon=True).start()

if __name__ == "__main__":
    main()
PY
    chmod 700 "$WS_SCRIPT"
    python3 -m py_compile "$WS_SCRIPT"
}

crear_ws_service() {
    cat > "$SYSTEMD/silk-websocket.service" <<EOF
[Unit]
Description=SSH SILK WebSocket HTTP
After=network.target
[Service]
Type=simple
Environment=SILK_WS_PORT=80
Environment=SILK_SSH_HOST=127.0.0.1
Environment=SILK_SSH_PORT=22
ExecStart=/usr/bin/python3 $WS_SCRIPT
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
EOF
}

gestionar_websocket() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • WEBSOCKET HTTP${FIN}"
    echo "============================================================"
    echo -e "Puerto: ${BLANCO}80/tcp${FIN}"
    if tcp_listening 80; then
        echo -e "Estado: ${VERDE}● ON${FIN}"
        read -r -p "¿Detener puerto 80? (s/n): " r
        if [[ "$r" =~ ^[sS]$ ]]; then
            systemctl disable --now silk-websocket.service >/dev/null 2>&1 || true
            fw_tcp_close 80
            echo -e "${VERDE}✅ Puerto 80 detenido.${FIN}"
        fi
    else
        echo -e "Estado: ${ROJO}● OFF${FIN}"
        if tcp_listening 80; then
            echo -e "${ROJO}❌ Ocupado por: $(port_owner 80)${FIN}"; pausa; return
        fi
        crear_websocket_python || { echo -e "${ROJO}❌ Error validando WebSocket.${FIN}"; pausa; return; }
        crear_ws_service
        systemctl daemon-reload
        fw_tcp_open 80
        systemctl enable --now silk-websocket.service >/dev/null 2>&1
        sleep 2
        if tcp_listening 80; then echo -e "${VERDE}✅ WebSocket activo en 80.${FIN}"
        else echo -e "${ROJO}❌ No abrió 80.${FIN}"; journalctl -u silk-websocket.service -n 20 --no-pager; fi
    fi
    pausa
}

# ---------------------- WSS ----------------------

crear_certificado() {
    mkdir -p /etc/stunnel
    if [[ ! -s /etc/stunnel/stunnel.pem ]]; then
        openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
          -keyout /etc/stunnel/stunnel.pem -out /etc/stunnel/stunnel.pem \
          -subj "/C=AR/ST=BA/L=Silk/O=SSH-SILK/CN=SSH-SILK" >/dev/null 2>&1 || return 1
        chmod 600 /etc/stunnel/stunnel.pem
    fi
}

configurar_stunnel() {
    cat > /etc/stunnel/stunnel.conf <<EOF
pid = /run/stunnel4.pid
cert = /etc/stunnel/stunnel.pem
client = no
foreground = no
[ssh_silk_wss]
accept = 443
connect = 127.0.0.1:80
EOF
    if [[ -f /etc/default/stunnel4 ]]; then
        if grep -q '^ENABLED=' /etc/default/stunnel4; then sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/stunnel4
        else echo "ENABLED=1" >> /etc/default/stunnel4; fi
    fi
}

gestionar_wss() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • WEBSOCKET SECURITY${FIN}"
    echo "============================================================"
    echo -e "Puerto SSL: ${BLANCO}443/tcp${FIN}"
    if tcp_listening 443; then
        echo -e "Estado: ${VERDE}● ON${FIN}"
        read -r -p "¿Detener puerto 443? (s/n): " r
        if [[ "$r" =~ ^[sS]$ ]]; then
            systemctl disable --now stunnel4 >/dev/null 2>&1 || true
            fw_tcp_close 443
            echo -e "${VERDE}✅ Puerto 443 detenido.${FIN}"
        fi
        pausa; return
    fi
    if tcp_listening 443; then echo -e "${ROJO}❌ Ocupado por: $(port_owner 443)${FIN}"; pausa; return; fi
    if ! tcp_listening 80; then
        echo "WebSocket 80 está OFF. Se activará porque WSS depende de él."
        crear_websocket_python || { echo -e "${ROJO}❌ No se pudo preparar WebSocket.${FIN}"; pausa; return; }
        crear_ws_service; systemctl daemon-reload; fw_tcp_open 80
        systemctl enable --now silk-websocket.service >/dev/null 2>&1
        sleep 2
        if ! tcp_listening 80; then echo -e "${ROJO}❌ WebSocket 80 no inició.${FIN}"; journalctl -u silk-websocket.service -n 20 --no-pager; pausa; return; fi
    fi
    crear_certificado || { echo -e "${ROJO}❌ No se pudo crear certificado.${FIN}"; pausa; return; }
    configurar_stunnel
    fw_tcp_open 443
    systemctl daemon-reload
    systemctl enable --now stunnel4 >/dev/null 2>&1
    sleep 2
    if tcp_listening 443; then echo -e "${VERDE}✅ WSS activo: 443 → SSL → 80 → SSH.${FIN}"
    else echo -e "${ROJO}❌ WSS no abrió 443.${FIN}"; journalctl -u stunnel4 -n 20 --no-pager; fi
    pausa
}

# ---------------------- DROPBEAR ----------------------

crear_dropbear_wrapper() {
    local ports="$1" bin="$2"
    {
        echo '#!/bin/bash'
        echo 'exec "'"$bin"'" -F -E -R \'
        local p
        for p in $ports; do printf '  -p 0.0.0.0:%s \\\n' "$p"; done
        echo
    } > "$BASE/dropbear-start.sh"
    chmod 700 "$BASE/dropbear-start.sh"
}

crear_dropbear_service() {
    cat > "$SYSTEMD/silk-dropbear.service" <<EOF
[Unit]
Description=SSH SILK Dropbear Multi Port
After=network.target
Conflicts=dropbear.service dropbear.socket
[Service]
Type=simple
ExecStart=$BASE/dropbear-start.sh
Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
EOF
}

detener_dropbear_puerto() {
    local actual="$1"
    [[ -n "$actual" ]] || { echo "No hay puertos configurados."; return; }
    echo "Puertos actuales: $actual"
    read -r -p "Puerto a detener (o ALL): " p
    if [[ "$p" =~ ^[Aa][Ll][Ll]$ ]]; then
        systemctl disable --now silk-dropbear.service >/dev/null 2>&1 || true
        fw_tcp_close $actual
        : > "$DROPBEAR_PORTS_FILE"
        echo -e "${VERDE}✅ Todos los puertos Dropbear detenidos.${FIN}"
        return
    fi
    validar_puerto "$p" || { echo -e "${ROJO}❌ Puerto inválido.${FIN}"; return; }
    grep -qw "$p" <<< "$actual" || { echo -e "${ROJO}❌ Ese puerto no está configurado.${FIN}"; return; }
    local nuevos
    nuevos="$(tr ' ' '\n' <<< "$actual" | grep -vx "$p" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    if [[ -z "$nuevos" ]]; then
        systemctl disable --now silk-dropbear.service >/dev/null 2>&1 || true
        : > "$DROPBEAR_PORTS_FILE"
    else
        local bin; bin="$(command -v dropbear)"
        crear_dropbear_wrapper "$nuevos" "$bin"
        echo "$nuevos" > "$DROPBEAR_PORTS_FILE"
        systemctl restart silk-dropbear.service
    fi
    fw_tcp_close "$p"
    echo -e "${VERDE}✅ Puerto $p detenido.${FIN}"
}

gestionar_dropbear() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • DROPBEAR MULTI-PUERTO${FIN}"
    echo "============================================================"
    local actual=""; [[ -f "$DROPBEAR_PORTS_FILE" ]] && actual="$(cat "$DROPBEAR_PORTS_FILE")"
    echo -e "Estado: $(systemctl is-active --quiet silk-dropbear.service && echo -e "${VERDE}● ON${FIN}" || echo -e "${ROJO}● OFF${FIN}")"
    echo -e "Configurados: ${BLANCO}${actual:-Ninguno}${FIN}"
    [[ -n "$actual" ]] && puertos_tcp_ui "$actual"
    echo
    echo "[1] Configurar/reconfigurar puertos"
    echo "[2] Detener un puerto"
    echo "[0] Volver"
    read -r -p "Opción: " op
    case "$op" in
      2) detener_dropbear_puerto "$actual"; pausa; return ;;
      1) ;;
      *) return ;;
    esac
    echo "Ejemplo: 2222 2200 8080"
    read -r -p "Puertos Dropbear: " nuevos
    nuevos="$(normalizar_lista "$nuevos")"
    validar_lista_puertos "$nuevos" || { pausa; return; }
    local p bin
    for p in $nuevos; do
        if tcp_listening "$p" && ! grep -qw "$p" <<< "$actual"; then
            echo -e "${ROJO}❌ $p/tcp ya está ocupado: $(port_owner "$p")${FIN}"
            pausa; return
        fi
    done
    bin="$(command -v dropbear)"
    systemctl disable --now dropbear.service dropbear.socket >/dev/null 2>&1 || true
    crear_dropbear_wrapper "$nuevos" "$bin"
    crear_dropbear_service
    echo "$nuevos" > "$DROPBEAR_PORTS_FILE"
    fw_tcp_open $nuevos
    systemctl daemon-reload
    systemctl enable --now silk-dropbear.service >/dev/null 2>&1
    sleep 2
    if systemctl is-active --quiet silk-dropbear.service && todos_tcp_activos "$nuevos"; then
        echo -e "${VERDE}✅ Dropbear activo.${FIN}"; puertos_tcp_ui "$nuevos"
    else
        echo -e "${ROJO}❌ Dropbear no inició correctamente.${FIN}"
        journalctl -u silk-dropbear.service -n 30 --no-pager
    fi
    pausa
}

# ---------------------- BADVPN ----------------------

compilar_badvpn() {
    if [[ -x "$BADVPN_BIN" ]] && "$BADVPN_BIN" --help >/dev/null 2>&1; then return 0; fi
    local src="$BASE/badvpn-src" build="$BASE/badvpn-build"
    rm -rf "$src" "$build"
    echo "Descargando código fuente oficial de BadVPN..."
    if ! git clone --depth 1 https://github.com/ambrop72/badvpn.git "$src" >/dev/null 2>&1; then
        echo -e "${ROJO}❌ No se pudo descargar BadVPN.${FIN}"; return 1
    fi
    cmake -S "$src" -B "$build" -DBUILD_NOTHING_BY_DEFAULT=1 -DBUILD_UDPGW=1 >/dev/null 2>&1 || return 1
    cmake --build "$build" -j"$(nproc)" >/dev/null 2>&1 || return 1
    local found; found="$(find "$build" -type f -name badvpn-udpgw -perm -111 | head -1)"
    [[ -n "$found" ]] || { echo -e "${ROJO}❌ No se encontró el binario compilado.${FIN}"; return 1; }
    install -m 755 "$found" "$BADVPN_BIN"
    "$BADVPN_BIN" --help >/dev/null 2>&1
}

crear_badvpn_service() {
    local ports="$1"
    {
        echo "[Unit]"
        echo "Description=SSH SILK BadVPN UDP Gateway"
        echo "After=network.target"
        echo "[Service]"
        echo "Type=simple"
        echo -n "ExecStart=$BADVPN_BIN"
        local p
        for p in $ports; do echo -n " --listen-addr 0.0.0.0:$p"; done
        echo " --max-clients 1000 --max-connections-for-client 10"
        echo "Restart=on-failure"
        echo "RestartSec=2"
        echo "[Install]"
        echo "WantedBy=multi-user.target"
    } > "$SYSTEMD/silk-badvpn.service"
}

detener_badvpn_puerto() {
    local actual="$1"
    [[ -n "$actual" ]] || { echo "No hay puertos configurados."; return; }
    echo "Puertos actuales: $actual"
    read -r -p "Puerto UDP a detener (o ALL): " p
    if [[ "$p" =~ ^[Aa][Ll][Ll]$ ]]; then
        systemctl disable --now silk-badvpn.service >/dev/null 2>&1 || true
        fw_udp_close $actual
        : > "$BADVPN_PORTS_FILE"
        echo -e "${VERDE}✅ Todos los puertos BadVPN detenidos.${FIN}"; return
    fi
    validar_puerto "$p" || { echo -e "${ROJO}❌ Puerto inválido.${FIN}"; return; }
    grep -qw "$p" <<< "$actual" || { echo -e "${ROJO}❌ Ese puerto no está configurado.${FIN}"; return; }
    local nuevos
    nuevos="$(tr ' ' '\n' <<< "$actual" | grep -vx "$p" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    if [[ -z "$nuevos" ]]; then
        systemctl disable --now silk-badvpn.service >/dev/null 2>&1 || true
        : > "$BADVPN_PORTS_FILE"
    else
        crear_badvpn_service "$nuevos"
        echo "$nuevos" > "$BADVPN_PORTS_FILE"
        systemctl daemon-reload
        systemctl restart silk-badvpn.service
    fi
    fw_udp_close "$p"
    echo -e "${VERDE}✅ Puerto UDP $p detenido.${FIN}"
}

gestionar_badvpn() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • BADVPN MULTI-PUERTO${FIN}"
    echo "============================================================"
    local actual=""; [[ -f "$BADVPN_PORTS_FILE" ]] && actual="$(cat "$BADVPN_PORTS_FILE")"
    echo -e "Estado: $(systemctl is-active --quiet silk-badvpn.service && echo -e "${VERDE}● ON${FIN}" || echo -e "${ROJO}● OFF${FIN}")"
    echo -e "Configurados: ${BLANCO}${actual:-Ninguno}${FIN}"
    [[ -n "$actual" ]] && puertos_udp_ui "$actual"
    echo
    echo "[1] Configurar/reconfigurar puertos"
    echo "[2] Detener un puerto"
    echo "[0] Volver"
    read -r -p "Opción: " op
    case "$op" in
      2) detener_badvpn_puerto "$actual"; pausa; return ;;
      1) ;;
      *) return ;;
    esac
    echo "Ejemplo: 7300 7301 7302 7303"
    read -r -p "Puertos BadVPN UDP: " nuevos
    nuevos="$(normalizar_lista "$nuevos")"
    validar_lista_puertos "$nuevos" || { pausa; return; }
    local p
    for p in $nuevos; do
        if udp_listening "$p" && ! grep -qw "$p" <<< "$actual"; then
            echo -e "${ROJO}❌ $p/udp ya está ocupado: $(port_owner "$p")${FIN}"; pausa; return
        fi
    done
    compilar_badvpn || { echo -e "${ROJO}❌ No se pudo instalar/compilar BadVPN.${FIN}"; pausa; return; }
    systemctl disable --now badvpn.service badvpn-udpgw.service >/dev/null 2>&1 || true
    crear_badvpn_service "$nuevos"
    echo "$nuevos" > "$BADVPN_PORTS_FILE"
    fw_udp_open $nuevos
    systemctl daemon-reload
    systemctl enable --now silk-badvpn.service >/dev/null 2>&1
    sleep 2
    if systemctl is-active --quiet silk-badvpn.service && todos_udp_activos "$nuevos"; then
        echo -e "${VERDE}✅ BadVPN activo.${FIN}"; puertos_udp_ui "$nuevos"
    else
        echo -e "${ROJO}❌ BadVPN no abrió uno o más puertos.${FIN}"
        journalctl -u silk-badvpn.service -n 30 --no-pager
    fi
    pausa
}

# ---------------------- INFO SISTEMA ----------------------

cpu_usage() {
    local idle; idle="$(top -bn1 | awk -F'[, ]+' '/Cpu\(s\)/ {for(i=1;i<=NF;i++) if($i ~ /id/) {gsub(/%/,"",$(i-1)); print $(i-1); exit}}')"
    [[ "$idle" =~ ^[0-9.]+$ ]] && awk -v i="$idle" 'BEGIN {printf "%d", 100-i}' || echo 0
}
ram_usage_pct() { free | awk '/Mem:/ {if($2) printf "%d", ($3/$2)*100; else print 0}'; }
disk_usage() { df -hP / | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}'; }

info_sistema() {
    clear
    local os kernel arch ip uptime_s ram_total ram_used ram_pct cpu disk
    os="$(lsb_release -ds 2>/dev/null || sed -n 's/^PRETTY_NAME=//p' /etc/os-release | tr -d '"')"
    kernel="$(uname -r)"; arch="$(uname -m)"
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    uptime_s="$(uptime -p 2>/dev/null || true)"
    ram_total="$(free -h | awk '/Mem:/ {print $2}')"
    ram_used="$(free -h | awk '/Mem:/ {print $3}')"
    ram_pct="$(ram_usage_pct)"; cpu="$(cpu_usage)"; disk="$(disk_usage)"
    echo -e "${AZUL}╔════════════════════════════════════════════════════════════╗${FIN}"
    echo -e "${AZUL}║${FIN}                 ${BLANCO}INFORMACIÓN DEL SISTEMA${FIN}                 ${AZUL}║${FIN}"
    echo -e "${AZUL}╚════════════════════════════════════════════════════════════╝${FIN}"
    echo
    printf "${CIAN}%-22s${FIN} ${BLANCO}%-38s${FIN}\n" "SISTEMA" "RECURSOS"
    echo "------------------------------------------------------------"
    printf "OS       : %-16s   CPU    : %-20s\n" "$os" "${cpu}% / $(nproc) cores"
    printf "Kernel   : %-16s   RAM    : %-20s\n" "$kernel" "$ram_used / $ram_total ($ram_pct%)"
    printf "Arch     : %-16s   DISCO  : %-20s\n" "$arch" "$disk"
    printf "IP       : %-16s   UPTIME : %-20s\n" "$ip" "$uptime_s"
    echo
    echo -e "${AMARILLO}PUERTOS SSH SILK${FIN}"
    echo "------------------------------------------------------------"
    local d b
    d=""; b=""
    [[ -f "$DROPBEAR_PORTS_FILE" ]] && d="$(cat "$DROPBEAR_PORTS_FILE")"
    [[ -f "$BADVPN_PORTS_FILE" ]] && b="$(cat "$BADVPN_PORTS_FILE")"
    echo -e "Dropbear : ${BLANCO}${d:-Ninguno}${FIN}"
    [[ -n "$d" ]] && puertos_tcp_ui "$d"
    echo -e "WebSocket: ${BLANCO}80/tcp${FIN}  $(tcp_listening 80 && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}")"
    echo -e "WSS      : ${BLANCO}443/tcp${FIN} $(tcp_listening 443 && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}")"
    echo -e "BadVPN   : ${BLANCO}${b:-Ninguno}${FIN}"
    [[ -n "$b" ]] && puertos_udp_ui "$b"
    echo
    echo -e "${AMARILLO}TODOS LOS PUERTOS EN ESCUCHA${FIN}"
    echo "------------------------------------------------------------"
    ss -H -lntup 2>/dev/null | sed 's/users:((/users: ((/' | head -80
    echo
    echo -e "${AMARILLO}FIREWALL${FIN}: $(ufw status 2>/dev/null | head -1 || echo 'UFW no disponible')"
    pausa
}

# ---------------------- USUARIOS ----------------------

crear_usuario() {
    clear; echo -e "${CIAN}⚡ SSH SILK • CREAR USUARIO${FIN}"
    read -r -p "Usuario: " u
    id "$u" >/dev/null 2>&1 && { echo -e "${ROJO}❌ Ya existe.${FIN}"; pausa; return; }
    read -r -s -p "Contraseña: " pass; echo
    read -r -p "Días: " dias
    [[ "$dias" =~ ^[0-9]+$ ]] || { echo "Días inválidos."; pausa; return; }
    local fecha; fecha="$(date -d "+$dias days" +%Y-%m-%d)"
    useradd -M -s /bin/false -e "$fecha" "$u" && echo "$u:$pass" | chpasswd
    echo -e "${VERDE}✅ Usuario creado. Expira: $fecha${FIN}"; pausa
}
crear_test() {
    clear; local u="silk$(date +%s | tail -c 5)"
    useradd -M -s /bin/false -e "$(date -d '+1 day' +%Y-%m-%d)" "$u" && echo "$u:1234" | chpasswd
    echo -e "${VERDE}✅ Test creado${FIN}\nUsuario: $u\nPass: 1234"; pausa
}
eliminar_usuario() {
    clear; read -r -p "Usuario a eliminar: " u
    if id "$u" >/dev/null 2>&1; then userdel -f "$u" >/dev/null 2>&1; echo -e "${VERDE}✅ Eliminado.${FIN}"
    else echo -e "${ROJO}❌ No existe.${FIN}"; fi
    pausa
}
listar_usuarios() {
    clear; echo -e "${CIAN}👥 USUARIOS SSH${FIN}"; echo "------------------------------------------------------------"
    awk -F: '$3 >= 1000 && $1 != "nobody" {print " • " $1}' /etc/passwd
    pausa
}

# ---------------------- DIAGNOSTICO / UPDATE ----------------------

diagnostico() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • DIAGNÓSTICO${FIN}"
    echo "============================================================"
    echo "DROPBEAR"; [[ -f "$DROPBEAR_PORTS_FILE" ]] && puertos_tcp_ui "$(cat "$DROPBEAR_PORTS_FILE")" || echo "  Ninguno"
    echo "WEBSOCKET"; puertos_tcp_ui "80"
    echo "WSS"; puertos_tcp_ui "443"
    echo "BADVPN"; [[ -f "$BADVPN_PORTS_FILE" ]] && puertos_udp_ui "$(cat "$BADVPN_PORTS_FILE")" || echo "  Ninguno"
    echo
    systemctl --no-pager --plain --type=service --state=failed 2>/dev/null | head -20
    echo
    echo "Puertos:"
    ss -lntup 2>/dev/null
    pausa
}

actualizar_online() {
    clear
    echo -e "${CIAN}⚡ SSH SILK • ACTUALIZACIÓN ONLINE${FIN}"
    echo "============================================================"
    local tmp backup
    tmp="$(mktemp "$BASE/update.XXXXXX")"; backup="$BASE/SSH-SILK.backup.$(date +%Y%m%d-%H%M%S)"
    if ! curl -fsSL --retry 3 --connect-timeout 10 "$GITHUB_RAW" -o "$tmp"; then
        rm -f "$tmp"; echo -e "${ROJO}❌ No se pudo descargar la actualización.${FIN}"; pausa; return
    fi
    if ! grep -q 'SSH SILK MANAGER' "$tmp" || ! bash -n "$tmp"; then
        rm -f "$tmp"; echo -e "${ROJO}❌ La actualización no pasó la validación.${FIN}"; pausa; return
    fi
    cp "$0" "$backup" 2>/dev/null || true
    install -m 755 "$tmp" "$BIN/menu"
    rm -f "$tmp"
    echo -e "${VERDE}✅ Actualización instalada correctamente.${FIN}"
    echo "Versión: $("$BIN/menu" --version 2>/dev/null || echo "$VERSION")"
    read -r -p "Presiona Enter para reiniciar el panel..."
    exec "$BIN/menu"
}

mostrar_version() { echo "SSH SILK Manager v$VERSION"; }

configurar_alias() {
    cp "$0" "$BIN/menu" >/dev/null 2>&1 || true
    chmod +x "$BIN/menu" >/dev/null 2>&1 || true
    grep -qF "alias menu='$BIN/menu'" /root/.bashrc 2>/dev/null || echo "alias menu='$BIN/menu'" >> /root/.bashrc
    grep -qF "alias silk='$BIN/menu'" /root/.bashrc 2>/dev/null || echo "alias silk='$BIN/menu'" >> /root/.bashrc
}

desinstalar() {
    clear; echo -e "${ROJO}⚠ DESINSTALAR SSH SILK${FIN}"
    read -r -p "Confirmar (s/n): " r; [[ "$r" =~ ^[sS]$ ]] || return
    local d b
    d=""; b=""
    [[ -f "$DROPBEAR_PORTS_FILE" ]] && d="$(cat "$DROPBEAR_PORTS_FILE")"
    [[ -f "$BADVPN_PORTS_FILE" ]] && b="$(cat "$BADVPN_PORTS_FILE")"
    systemctl disable --now silk-dropbear.service silk-websocket.service silk-badvpn.service stunnel4 >/dev/null 2>&1 || true
    systemctl disable --now dropbear.service dropbear.socket >/dev/null 2>&1 || true
    fw_tcp_close $d 80 443; fw_udp_close $b
    rm -f "$SYSTEMD/silk-dropbear.service" "$SYSTEMD/silk-websocket.service" "$SYSTEMD/silk-badvpn.service"
    systemctl daemon-reload
    rm -rf "$BASE"
    rm -f "$BIN/menu"
    sed -i "/alias menu='$BIN\/menu'/d;/alias silk='$BIN\/menu'/d" /root/.bashrc 2>/dev/null || true
    echo -e "${VERDE}✅ SSH SILK desinstalado.${FIN}"; exit 0
}

# ---------------------- PANEL ----------------------

status_word() { "$1" && echo -e "${VERDE}ON${FIN}" || echo -e "${ROJO}OFF${FIN}"; }
online_users() { who 2>/dev/null | wc -l; }
total_users() { awk -F: '$3 >= 1000 && $1 != "nobody" {n++} END{print n+0}' /etc/passwd; }
expired_users() { awk -F: -v d="$(date +%s)" '$3 >= 1000 && $1 != "nobody" && $8 != 0 && $8 < d {n++} END{print n+0}' /etc/shadow 2>/dev/null; }

estado_dropbear() { systemctl is-active --quiet silk-dropbear.service; }
estado_ws() { tcp_listening 80; }
estado_wss() { tcp_listening 443; }
estado_badvpn() { local b p; [[ -f "$BADVPN_PORTS_FILE" ]] || return 1; b="$(cat "$BADVPN_PORTS_FILE")"; for p in $b; do udp_listening "$p" && return 0; done; return 1; }
todos_tcp_activos() { local p; for p in $1; do tcp_listening "$p" || return 1; done; return 0; }
todos_udp_activos() { local p; for p in $1; do udp_listening "$p" || return 1; done; return 0; }

barra() {
    local pct="${1:-0}" n=$((pct/10)) out="" i
    ((n<0)) && n=0; ((n>10)) && n=10
    for ((i=0;i<n;i++)); do out+="█"; done
    for ((i=n;i<10;i++)); do out+="░"; done
    printf "%s %d%%" "$out" "$pct"
}

panel() {
    obtener_panel_info
    local d b
    d=""; b=""
    [[ -f "$DROPBEAR_PORTS_FILE" ]] && d="$(cat "$DROPBEAR_PORTS_FILE")"
    [[ -f "$BADVPN_PORTS_FILE" ]] && b="$(cat "$BADVPN_PORTS_FILE")"
    clear
    echo -e "${AZUL}╔════════════════════════════════════════════════════════════╗${FIN}"
    echo -e "${AZUL}║${FIN}            ${BLANCO}⚡ SSH SILK MANAGER PRO v$VERSION ⚡${FIN}            ${AZUL}║${FIN}"
    echo -e "${AZUL}╚════════════════════════════════════════════════════════════╝${FIN}"
    echo
    printf "${CIAN}%-20s${FIN} ${CIAN}%-20s${FIN} ${CIAN}%-20s${FIN}\n" "SISTEMA" "MEMORIA RAM" "PROCESADOR"
    printf "OS: %-16s " "$PANEL_OS"
    printf "Total: %-12s " "$PANEL_RAM_TOTAL"
    printf "Cores: %-12s\n" "$PANEL_CORES"
    printf "Hora: %-14s " "$PANEL_HORA"
    printf "Uso: %-15s " "$(barra "$PANEL_RAM_PCT")"
    printf "Uso: %-15s\n" "$(barra "$PANEL_CPU_PCT")"
    echo -e "${AZUL}────────────────────────────────────────────────────────────${FIN}"
    printf "${VERDE}● Online: %-8s${FIN} ${ROJO}● Expirados: %-8s${FIN} ${AMARILLO}● Total: %-8s${FIN}\n" "$(online_users)" "$(expired_users)" "$(total_users)"
    echo -e "${AZUL}────────────────────────────────────────────────────────────${FIN}"
    echo -e "${CIAN}PROTOCOLOS ACTIVOS${FIN}"
    printf "  ${VERDE}●${FIN} OPENSSH:22   ${status_word estado_dropbear}    ${VERDE}●${FIN} WEBSOCKET:80  %b\n" "$(status_word estado_ws)"
    printf "  ${VERDE}●${FIN} DROPBEAR:%-6s ${VERDE}●${FIN} BADVPN:%-7s ${VERDE}●${FIN} WSS:443       %b\n" "${d:-—}" "${b:-—}" "$(status_word estado_wss)"
    echo -e "${AZUL}────────────────────────────────────────────────────────────${FIN}"
    printf "${CIAN}DROPBEAR: %-9b${FIN}   ${CIAN}BADVPN: %-9b${FIN}   ${CIAN}WSS: %-9b${FIN}\n" "$(status_word estado_dropbear)" "$(status_word estado_badvpn)" "$(status_word estado_wss)"
    echo -e "${AZUL}╭────────────────────────────╮  ╭────────────────────────────╮${FIN}"
    echo -e "${MAGENTA}│ ADMINISTRACIÓN              │  ${CIAN}│ CONFIGURACIONES            │${FIN}"
    echo -e "│ ${BLANCO}[01]${FIN} Crear usuario          │  │ ${BLANCO}[06]${FIN} WebSocket HTTP 80       │"
    echo -e "│ ${BLANCO}[02]${FIN} Usuario prueba         │  │ ${BLANCO}[07]${FIN} WebSocket Security 443  │"
    echo -e "│ ${BLANCO}[03]${FIN} Usuarios online        │  │ ${BLANCO}[08]${FIN} BadVPN multi-puerto      │"
    echo -e "│ ${BLANCO}[04]${FIN} Lista usuarios         │  │ ${BLANCO}[09]${FIN} Diagnóstico de puertos   │"
    echo -e "│ ${BLANCO}[05]${FIN} Eliminar usuario       │  │ ${BLANCO}[10]${FIN} Info de sistema          │"
    echo -e "│                            │  │ ${BLANCO}[11]${FIN} Actualizar online        │"
    echo -e "│                            │  │ ${BLANCO}[12]${FIN} Dropbear multi-puerto    │"
    echo -e "╰────────────────────────────╯  ╰────────────────────────────╯"
    echo -e " ${ROJO}[00]${FIN} Salir"
    echo -e "${AZUL}────────────────────────────────────────────────────────────${FIN}"
    read -r -p "👉 INFORME UNA OPCIÓN: " opcion
}

obtener_panel_info() {
    PANEL_OS="$(lsb_release -ds 2>/dev/null || sed -n 's/^PRETTY_NAME=//p' /etc/os-release | tr -d '"')"
    PANEL_HORA="$(date +%H:%M:%S)"
    PANEL_CORES="$(nproc)"
    PANEL_RAM_TOTAL="$(free -h | awk '/Mem:/ {print $2}')"
    PANEL_RAM_PCT="$(ram_usage_pct)"
    PANEL_CPU_PCT="$(cpu_usage)"
}

inicializar() {
    instalar_dependencias || exit 1
    systemctl daemon-reload
    configurar_alias
}

case "${1:-}" in
  --version) mostrar_version; exit 0 ;;
esac

inicializar
while true; do
    panel
    case "$opcion" in
      1|01) crear_usuario ;; 2|02) crear_test ;; 3|03) clear; echo "Online: $(online_users)"; ps -eo user,pid,cmd | grep -E '[s]shd|[d]ropbear' | head -50; pausa ;;
      4|04) listar_usuarios ;; 5|05) eliminar_usuario ;;
      6|06) gestionar_websocket ;; 7|07) gestionar_wss ;; 8|08) gestionar_badvpn ;;
      9|09) diagnostico ;; 10) info_sistema ;; 11) actualizar_online ;; 12) gestionar_dropbear ;;
      0|00) clear; exit 0 ;;
      *) echo -e "${ROJO}❌ Opción inválida.${FIN}"; sleep 1 ;;
    esac
done
